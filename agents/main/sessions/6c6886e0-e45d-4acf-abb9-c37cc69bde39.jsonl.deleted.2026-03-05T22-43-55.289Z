{"type":"message","id":"f6435afc","parentId":"ef85397d","timestamp":"2026-03-03T13:24:39.168Z","message":{"role":"toolResult","toolCallId":"call_S66SecCYYQQd9FRiJuO8YQAq|fc_011fdad5104f3b770169a6e10faac081919121dd40ccdf2e91","toolName":"read","content":[{"type":"text","text":"import { LightningElement, track, wire } from 'lwc';\nimport { NavigationMixin, CurrentPageReference } from 'lightning/navigation';\nimport devModeFlag from '@salesforce/label/c.DEV_MODE_LAB';\nimport FormStartDate from '@salesforce/label/c.Resend_Form_Start_Date';\nimport FormNotStartedMsg from '@salesforce/label/c.Resend_Form_Not_Started_Msg';\n\nexport default class DocumentsResendFormPage extends NavigationMixin(LightningElement) {\n\n    // constructor() {\n    //     super();\n    //     console.log('constructor');\n    //     this.template.addEventListener('select', (event) => {\n    //         console.log('sentCaseFromInput event', event.detail);\n    //     });\n    // }\n\n    // connectedCallback() {\n    //     this.addEventListener('select', this.handleEvent);\n    // }\n    caseRecordJsonString = '';\n    caseNumber = '';\n    isShowInputChild = true;\n    isShowConfirmChild = false;\n    isShowSuccessChild = false;\n\n    // 受付期間制御\n    isFormOpen = false;\n    isFormNotOpen = true;\n    formNotStartedMsg = FormNotStartedMsg;\n\n    connectedCallback() {\n        const now = new Date();\n        const startDate = new Date(FormStartDate.replace(/-/g, '/'));\n        this.isFormOpen = (now >= startDate);\n        this.isFormNotOpen = !this.isFormOpen;\n    }\n    handleSendCaseFromInput(event) {\n        console.log('★★★ handleSendCaseFromInput called ★★★');\n        console.log('event.detail:', event.detail);\n        console.log('BEFORE - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.caseRecordJsonString = event.detail;\n        this.isShowInputChild = false;\n        this.isShowConfirmChild = true;\n        this.isShowSuccessChild = false;\n        console.log('AFTER  - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.toTop();\n    }\n\n    handleSendCaseFromConfirm(event) {\n        console.log('★★★ handleSendCaseFromConfirm called ★★★');\n        console.log('BEFORE - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.caseRecordJsonString = event.detail;\n        this.isShowInputChild = true;\n        this.isShowConfirmChild = false;\n        this.isShowSuccessChild = false;\n        console.log('AFTER  - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.toTop();\n    }\n\n    handleToSuccess(event) {\n        console.log('★★★ handleToSuccess called ★★★');\n        console.log('BEFORE - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.caseNumber = event.detail;\n        this.isShowInputChild = false;\n        this.isShowConfirmChild = false;\n        this.isShowSuccessChild = true;\n        console.log('AFTER  - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.toTop();\n    }\n\n    reshow(event) {\n        console.log('★★★ reshow called ★★★');\n        console.log('BEFORE - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n        this.isShowInputChild = true;\n        this.isShowConfirmChild = false;\n        this.isShowSuccessChild = false;\n        console.log('AFTER  - isShowInputChild:', this.isShowInputChild, 'isShowConfirmChild:', this.isShowConfirmChild, 'isShowSuccessChild:', this.isShowSuccessChild);\n    }\n\n    // 画面一番下に移動する\n    toBottom() {\n        window.scrollTo(0, this.template.body.scrollHeight);\n    }\n    // 画面一番上に移動する\n    toTop() {\n        window.scrollTo(0, 0);\n    }\n}"}],"isError":false,"timestamp":1772544279166}}
{"type":"message","id":"db571fd4","parentId":"f6435afc","timestamp":"2026-03-03T13:24:39.174Z","message":{"role":"toolResult","toolCallId":"call_v4RnUSDYtZKZtOVNdfsinRts|fc_011fdad5104f3b770169a6e10faacc81918b6c7f51eca1babf","toolName":"read","content":[{"type":"text","text":"import { LightningElement, api, track, wire } from 'lwc';\nimport { NavigationMixin, CurrentPageReference } from 'lightning/navigation';\nimport GetAddressInfo from '@salesforce/apex/FormCommonController.GetAddressInfo';\nimport CheckSurveyIdExist from '@salesforce/apex/FormCommonController.CheckSurveyIdExist';\nimport devModeFlag from '@salesforce/label/c.DEV_MODE_LAB';\nimport imageHelpPageURL from '@salesforce/label/c.imageHelpPageURL';\n\nexport default class DocumentsResendFormInput extends NavigationMixin(LightningElement) {\n\n    // to get experence page param\n    // this.currentPageReference.state.paramName;\n    currentPageReference;\n    @wire(CurrentPageReference)\n    setCurrentPageReference(currentPageReference) {\n        this.currentPageReference = currentPageReference;\n\n        if (this.connected) {\n            this.generateUrls();\n        } else {\n            this.generateUrlOnConnected = true;\n        }\n    }\n\n    imageHelpPageURL = imageHelpPageURL;\n    @api\n    caseRecordJson = '';\n\n    // 事業所の名称\n    companyName = '';\n    // 事業所の郵便番号\n    companyPostcode = '';\n    // 事業所の住所\n    companyAddress = '';\n    // 法人番号\n    corporationNumber = '';\n    // 申請者の氏名\n    applicantName = '';\n    // 申請者の部署名\n    applicantDepartment = '';\n    // 申請者の電話番号\n    applicantPhone = '';\n    // 申請者のメールアドレス\n    applicantMail = '';\n    // 調査票ID\n    //surveyId = '';\n    // 地区町村コード\n    municipalityCode = '';\n    // 調査区番号\n    surveyAreaNumber = '';\n    // 事業所番号\n    establishmentNumber = '';\n    // ＊コード\n    starCode = '';\n    // 整理番号\n    referenceNumber = '';\n\n    // checkbox 書類の発送先の住所と依頼者の住所が同じ\n    isResendAddressSame = false;\n    // 書類のお届け先の事業所名\n    resendCompanyName = '';\n    // 書類を発送する郵便番号\n    resendPostcode = '';\n    // 書類を発送する住所\n    resendAddress = '';\n\n    // 発送希望理由\n    researchDocumentReasonHope = '';\n\n    @track\n    testparams = '';\n    // 初期化処理\n    connectedCallback() {\n        // URLからパラメータを取得\n        this.contactId = this.currentPageReference.state.contactId;\n        // 利用履歴の取得処理へ\n        let params = {};\n        params.contactId = this.contactId;\n\n        // 親コンポーネントから値をもらったら初期値を設定する\n        if (this.caseRecordJson !== '') {\n            let caseRecordInit = JSON.parse(this.caseRecordJson);\n            this.companyName = caseRecordInit.companyName;\n            this.companyPostcode = caseRecordInit.companyPostcode;\n            this.companyAddress = caseRecordInit.companyAddress;\n            this.corporationNumber = caseRecordInit.corporationNumber;\n            this.applicantName = caseRecordInit.applicantName;\n            this.applicantDepartment = caseRecordInit.applicantDepartment;\n            this.applicantPhone = caseRecordInit.applicantPhone;\n            this.applicantMail = caseRecordInit.applicantMail;\n            //this.surveyId = caseRecordInit.surveyId;\n            this.municipalityCode = caseRecordInit.municipalityCode;\n            this.surveyAreaNumber = caseRecordInit.surveyAreaNumber;\n            this.establishmentNumber = caseRecordInit.establishmentNumber;\n            this.starCode = caseRecordInit.starCode;\n            this.referenceNumber = caseRecordInit.referenceNumber;\n\n\n            this.isResendAddressSame = caseRecordInit.isResendAddressSame;\n            this.resendCompanyName = caseRecordInit.resendCompanyName;\n            this.resendPostcode = caseRecordInit.resendPostcode;\n            this.resendAddress = caseRecordInit.resendAddress;\n\n            this.researchDocumentReasonHope = caseRecordInit.researchDocumentReasonHope;\n\n        }\n\n\n\n\n\n\n        // QueryContact(params).then((result) => {\n        //     let obj = JSON.parse(result);\n        //     this.companyNameField = obj.LastName;\n        //     this.mailField = obj.Email;\n        // }).catch(error => {\n        //     console.log(error);\n        //     this.result = error;\n        //     if (devModeFlag === 'true') {\n        //         alert('パラメータ不備（開発中モード）');\n        //     } else {\n        //         this[NavigationMixin.Navigate]({\n        //             type: 'comm__namedPage',\n        //             attributes: {\n        //                 name: 'Error'\n        //             }\n        //         });\n        //     }\n        // });\n    }\n\n    // コンポーネントを表示するときの初期化\n    renderedCallback() {\n        // チェックボックスの設定と表示非表示ブロックを設定\n        let isResendAddressSameCheckbox = this.template.querySelector('.isResendAddressSame');\n        isResendAddressSameCheckbox.checked = this.isResendAddressSame;\n        let ResendAddressSameFieldsDiv = this.template.querySelector('.ResendAddressSameFields');\n        if (isResendAddressSameCheckbox.checked) {\n            ResendAddressSameFieldsDiv.style.display = 'none';\n            let inputs = this.template.querySelectorAll('.ResendAddressSameFields input');\n            inputs.forEach(input => input.value = '');\n            let selects = this.template.querySelectorAll('.ResendAddressSameFields select');\n            selects.forEach(select => select.selectedIndex = 0);\n        } else {\n            ResendAddressSameFieldsDiv.style.display = 'block';\n        }\n    }\n\n    // 書類の発送先の住所と依頼者の住所が同じの変更で項目表示非表示\n    isResendAddressSameToggle(event) {\n        // 対象チェックボックス\n        let isResendAddressSameCheckbox = event.target;\n        // 表示非表示対象の要素\n        let ResendAddressSameFieldsDiv = this.template.querySelector('.ResendAddressSameFields');\n        // チェックONは非表示とクリア\n        if (isResendAddressSameCheckbox.checked) {\n            ResendAddressSameFieldsDiv.style.display = 'none';\n            let inputs = this.template.querySelectorAll('.ResendAddressSameFields input');\n            inputs.forEach(input => input.value = '');\n            let selects = this.template.querySelectorAll('.ResendAddressSameFields select');\n            selects.forEach(select => select.selectedIndex = 0);\n        } else {\n            ResendAddressSameFieldsDiv.style.display = 'block';\n        }\n    }\n    // 郵便番号から住所を取得する\n    handleGetAddressInfo(event) {\n        // 対象郵便番号項目\n        let postCodeInput = event.target;\n        // 対象住所項目\n        let addressInput;\n        // 郵便番号フォーマット判断、falseの場合\n        if (this.isPostcode(postCodeInput.value) === false) {\n            return;\n        }\n        let params = {};\n        params.postcode = postCodeInput.value;\n\n        GetAddressInfo(params)\n            .then(result => {\n                this.result = result;\n                // 空白じゃないと処理をする\n                if (this.result !== '') {\n                    let rtnAddress = this.result;\n                    // 発生源から対象の住所項目を特定\n                    if (postCodeInput.classList.contains('companyPostcode')) {\n                        addressInput = this.template.querySelector('.companyAddress');\n                    } else if (postCodeInput.classList.contains('resendPostcode')) {\n                        addressInput = this.template.querySelector('.resendAddress');\n                    }\n                    addressInput.value = rtnAddress.split(',')[1];\n                } else {\n                    console.log('postcode error');\n                }\n            })\n            .catch(error => {\n                console.log(error);\n            })\n    }\n    // 確認画面へ遷移\n    async toConfirm(event) {\n        this.offDivButtons();\n        this.clearErrorMsgAll();\n        let templateAll = this.template.querySelectorAll('.inputField');\n        const errorMsgArr = [];\n        templateAll.forEach(element => {\n            // 非表示の項目はスキップ\n            let closestdiv = element.closest('.fieldParentDiv');\n            if (!closestdiv || closestdiv.style.display !== \"none\") {\n                this.checkValid(element) ? errorMsgArr.push(this.checkValid(element)) : '';\n            }\n        });\n        // DBチェック\n        // フロントチェックですでにエラーの場合、スキップ\n        if (errorMsgArr.length === 0) {\n            // 調査票ID存在チェック廃止\n            // try {\n            //     // 調査票ID存在チェック\n            //     let params = {};\n            //     params.surveyId = this.template.querySelector('.surveyId').value;\n            //     const isSurveyIdExist = await CheckSurveyIdExist(params);\n            //     if (isSurveyIdExist === false) {\n            //         errorMsgArr.push('調査票IDが存在しません。ご確認ください');\n            //     }\n            // } catch (error) {\n            //     console.error(error);\n            //     // ここエラーページ行く？\n            //     return;\n            // }\n        }\n\n\n        if (errorMsgArr.length > 0) {\n            let msgHTML = \"<div style='font-size:18px;font-weight:bold;color:#FFFFFF;'>以下の入力内容をご確認ください</div><br/>\" + errorMsgArr.join('<br/>');\n            this.template.querySelector('.error-section').innerHTML = msgHTML;\n            this.template.querySelector('.error-section').style.display = \"block\";\n            this.toTop();\n        }\n        else {\n            let caseRecord = {};\n            caseRecord.companyName = Array.from(templateAll).find((element) => element.dataset.id === 'companyName').value;\n            caseRecord.companyPostcode = Array.from(templateAll).find((element) => element.dataset.id === 'companyPostcode').value;\n            caseRecord.companyAddress = Array.from(templateAll).find((element) => element.dataset.id === 'companyAddress').value;\n            caseRecord.applicantName = Array.from(templateAll).find((element) => element.dataset.id === 'applicantName').value;\n            caseRecord.applicantDepartment = Array.from(templateAll).find((element) => element.dataset.id === 'applicantDepartment').value;\n            caseRecord.applicantPhone = Array.from(templateAll).find((element) => element.dataset.id === 'applicantPhone').value;\n            caseRecord.applicantMail = Array.from(templateAll).find((element) => element.dataset.id === 'applicantMail').value;\n            //caseRecord.surveyId = Array.from(templateAll).find((element) => element.dataset.id === 'surveyId').value;\n            caseRecord.municipalityCode = Array.from(templateAll).find((element) => element.dataset.id === 'municipalityCode').value;\n            caseRecord.surveyAreaNumber = Array.from(templateAll).find((element) => element.dataset.id === 'surveyAreaNumber').value;\n            caseRecord.establishmentNumber = Array.from(templateAll).find((element) => element.dataset.id === 'establishmentNumber').value;\n            caseRecord.starCode = Array.from(templateAll).find((element) => element.dataset.id === 'starCode').value;\n\n\n            caseRecord.isResendAddressSame = Array.from(templateAll).find((element) => element.dataset.id === 'isResendAddressSame').checked;\n            caseRecord.resendCompanyName = Array.from(templateAll).find((element) => element.dataset.id === 'resendCompanyName').value;\n            caseRecord.resendPostcode = Array.from(templateAll).find((element) => element.dataset.id === 'resendPostcode').value;\n            caseRecord.resendAddress = Array.from(templateAll).find((element) => element.dataset.id === 'resendAddress').value;\n\n            // 調査書類希望理由 (コメントアウト)\n            // caseRecord.researchDocumentReasonHope = Array.from(templateAll).find((element) => element.dataset.id === 'researchDocumentReasonHope').value;\n            // Apexメソッドのパラメータを構築\n            let params = {};\n            params.caseRecordJsonString = JSON.stringify(caseRecord);\n            this.testparams = params.caseRecordJsonString;\n\n            const sendCaseFromInputEvent = new CustomEvent(\n                'sendcasefrominput',\n                { detail: params.caseRecordJsonString }\n            );\n            this.dispatchEvent(sendCaseFromInputEvent);\n\n        }\n        this.onDivButtons();\n    }\n\n\n\n\n    isZenkakuKana(s) {\n        // 「　」は全角スペースです.\n        return /^[ァ-ヶー　]*$/.test(s);\n    }\n    isMail(s) {\n        return /^[A-Za-z0-9]{1}[A-Za-z0-9_.\\-+]*@{1}[A-Za-z0-9_.-]+\\.[A-Za-z0-9]+$/.test(s);\n    }\n    isPhoneNumber(s) {\n        return /^[0-9]{10,11}$/.test(s);\n    }\n    isPostcode(s) {\n        return /^[0-9]{7}$/.test(s);\n    }\n    isSalesforceId(s) {\n        return /[a-zA-Z0-9]{15}|[a-zA-Z0-9]{18}/.test(s);\n    }\n\n    // 画面一番下に移動する\n    toBottom() {\n        window.scrollTo(0, this.template.body.scrollHeight);\n    }\n    // 画面一番上に移動する\n    toTop() {\n        window.scrollTo(0, 0);\n    }\n    // 入力された値はエラーの場合、エラーを表示します\n    checkValid(element) {\n        let errormsg = '';\n        // 必須項目空欄判断\n        if (element.classList.contains('required')) {\n            errormsg = this.checkBlank(element);\n        }\n        // メールアドレスフォーマット判断\n        if (errormsg === '' && element.classList.contains('EmailField')) {\n            errormsg = this.checkregex(element, /^[A-Za-z0-9]{1}[A-Za-z0-9_.\\-+]*@{1}[A-Za-z0-9_.-]+\\.[A-Za-z0-9]+$/, 'を正しいフォーマットで入力してください');\n        }\n        // 電話番号フォーマット判断\n        if (errormsg === '' && element.classList.contains('PhoneField')) {\n            errormsg = this.checkregex(element, /^[0-9]{10,11}$/, 'を10また11桁の半角数字で入力してください');\n        }\n        // 郵便番号フォーマット判断\n        if (errormsg === '' && element.classList.contains('ZipField') && element.value.trim() !== '') {\n            errormsg = this.checkregex(element, /^[0-9]{7}$/, 'を正しいフォーマットで入力してください');\n        }\n        \n        // --- 追加：5つのコードの数字＆桁数チェック ---\n        // 1. 市区町村コード (5桁)\n        if (errormsg === '' && element.classList.contains('municipalityCode')) {\n            errormsg = this.checkregex(element, /^[0-9]{5}$/, 'を5桁の半角数字で入力してください');\n        }\n        // 2. 調査区番号 (4桁)\n        if (errormsg === '' && element.classList.contains('surveyAreaNumber')) {\n            errormsg = this.checkregex(element, /^[0-9]{4}$/, 'を4桁の半角数字で入力してください');\n        }\n        // 3. 事業所番号 (4桁)\n        if (errormsg === '' && element.classList.contains('establishmentNumber')) {\n            errormsg = this.checkregex(element, /^[0-9]{4}$/, 'を4桁の半角数字で入力してください');\n        }\n        // 4. ＊コード (1桁)\n        if (errormsg === '' && element.classList.contains('starCode')) {\n            errormsg = this.checkregex(element, /^[0-9]{1}$/, 'を1桁の半角数字で入力してください');\n        }\n        // 5. 整理番号 削除\n        // 調査票IDフォーマット判断\n        if (errormsg === '' && element.classList.contains('surveyId')) {\n            errormsg = this.checkregex(element, /^[A-Za-z0-9]{10}$/, 'を正しいフォーマットで入力してください');\n        }\n        if (errormsg !== '') {\n            return errormsg;\n        }\n    }\n    // 空欄判断\n    checkBlank(element) {\n        let isblank = false;\n        let plealeInputMsg = 'を入力してください';\n        // 赤枠不要\n        let redBorder = false;\n        switch (element.tagName) {\n            case 'INPUT':\n                switch (element.type) {\n                    case 'checkbox':\n                        isblank = element.checked === false;\n                        plealeInputMsg = 'をチェックしてください';\n                        break;\n                    default:\n                        isblank = element.value.trim() === '';\n                        break;\n                }\n                break;\n            case 'TEXTAREA':\n                isblank = element.value.trim() === '';\n                break;\n            case 'SPAN':\n            case 'DIV':\n                isblank = element.innerHTML.trim() === '';\n                plealeInputMsg = 'を取得してください';\n                redBorder = false;\n                break;\n            default:\n                break;\n        }\n\n        if (isblank) {\n            if (redBorder) {\n                element.classList.add('invalid—value');\n            }\n            let errormessagePanel = this.template.querySelector('.' + element.dataset.id + '-errorMsg');\n            let errormsg = element.dataset.label + plealeInputMsg;\n            errormessagePanel.innerHTML = errormsg;\n            return errormsg;\n        } else {\n            return '';\n        }\n    }\n    // 正規表現判断\n    checkregex(element, regex, customMsg) {\n        let isValid = true;\n        let plealeInputMsg = customMsg;\n        switch (element.type) {\n            default:\n                isValid = regex.test(element.value) === true;\n                break;\n        }\n        if (isValid === false) {\n            let errormessagePanel = this.template.querySelector('.' + element.dataset.id + '-errorMsg');\n            let errormsg = element.dataset.label + plealeInputMsg;\n            errormessagePanel.innerHTML = errormsg;\n            return errormsg;\n        } else {\n            return '';\n        }\n    }\n    // 任意の修正後エラーメッセージを削除\n    clearErrorMsg(element) {\n        element.classList.remove('invalid—value');\n        let errormessagePanel = this.template.querySelector('.' + element.dataset.id + '-errorMsg');\n        errormessagePanel.innerHTML = '';\n    }\n    clearErrorMsgAll() {\n        let invalidInputs = this.template.querySelectorAll('.invalid—value ');\n        invalidInputs.forEach(invalidInput => {\n            invalidInput.classList.remove('invalid—value');\n        });\n        let errormessagePanels = this.template.querySelectorAll('.fieldErrorMsg ');\n        errormessagePanels.forEach(errormessagePanel => {\n            errormessagePanel.innerHTML = '';\n        });\n\n        this.template.querySelector('.error-section').innerHTML = '';\n        this.template.querySelector('.error-section').style.display = 'none';\n    }\n    // ボタンを活性化または無効化する\n    toggleDivButtons() {\n        let divs = this.template.querySelectorAll('.button-display div');\n        divs.forEach(function (div) {\n            div.classList.toggle('disabled-div-button');\n        });\n    }\n    // ボタンを活性化する\n    onDivButtons() {\n        let divs = this.template.querySelectorAll('.button-display div');\n        divs.forEach(function (div) {\n            div.classList.remove('disabled-div-button');\n        });\n    }\n    // ボタンを無効化する\n    offDivButtons() {\n        let divs = this.template.querySelectorAll('.button-display div');\n        divs.forEach(function (div) {\n            div.classList.add('disabled-div-button');\n        });\n    }\n    // こちらリンクをポップアップウィンドウで開く\n    openImageHelpPage(event) {\n        event.preventDefault();\n        window.open(this.imageHelpPageURL, 'helpWin', 'width=900,height=700,scrollbars=yes,resizable=yes,noopener,noreferrer');\n    }\n    toHome() {\n        this[NavigationMixin.Navigate]({\n            type: 'comm__namedPage',\n            attributes: {\n                name: 'Home'\n            }\n        });\n    }\n}"}],"isError":false,"timestamp":1772544279172}}
{"type":"message","id":"54f48a3c","parentId":"db571fd4","timestamp":"2026-03-03T13:24:39.180Z","message":{"role":"toolResult","toolCallId":"call_2gMwGQmDqv9LX0zOJFEIudor|fc_011fdad5104f3b770169a6e10faad08191bc7d8e46c1aec9e9","toolName":"read","content":[{"type":"text","text":"import { LightningElement, api, track, wire } from 'lwc';\nimport { NavigationMixin, CurrentPageReference } from 'lightning/navigation';\nimport InsertCaseResend from '@salesforce/apex/FormCommonController.InsertCaseResend';\nimport devModeFlag from '@salesforce/label/c.DEV_MODE_LAB';\n\nexport default class DocumentsResendFormConfirm extends NavigationMixin(LightningElement) {\n    @api\n    caseRecordJson = '';\n\n    // 事業所の名称\n    companyName = '';\n    // 事業所の郵便番号\n    companyPostcode = '';\n    // 事業所の住所\n    companyAddress = '';\n    // 申請者の氏名\n    applicantName = '';\n    // 申請者の部署名\n    applicantDepartment = '';\n    // 申請者の電話番号\n    applicantPhone = '';\n    // 申請者のメールアドレス\n    applicantMail = '';\n    // 調査票ID\n    //surveyId = '';\n    // 地区町村コード\n    municipalityCode = '';\n    // 調査区番号\n    surveyAreaNumber = '';\n    // 事業所番号\n    establishmentNumber = '';\n    // ＊コード\n    starCode = '';\n\n\n    // checkbox 書類の発送先の住所と依頼者の住所が同じ\n    isResendAddressSame = false;\n    // 書類のお届け先の事業所名\n    resendCompanyName = '';\n    // 書類を発送する郵便番号\n    resendPostcode = '';\n    // 書類を発送する住所\n    resendAddress = '';\n\n    // 発送希望理由\n    researchDocumentReasonHope = '';\n    // 改行コードを<br>に変更して表示用の発送希望理由\n    researchDocumentReasonHopeForShow = '';\n\n    // 初期化処理\n    connectedCallback() {\n        // 親コンポーネントから値をもらったら初期値を設定する\n        if (this.caseRecordJson !== '') {\n            let caseRecordInit = JSON.parse(this.caseRecordJson);\n            this.companyName = caseRecordInit.companyName;\n            this.companyPostcode = caseRecordInit.companyPostcode;\n            this.companyAddress = caseRecordInit.companyAddress;\n            this.applicantName = caseRecordInit.applicantName;\n            this.applicantDepartment = caseRecordInit.applicantDepartment;\n            this.applicantPhone = caseRecordInit.applicantPhone;\n            this.applicantMail = caseRecordInit.applicantMail;\n            //this.surveyId = caseRecordInit.surveyId;\n            this.municipalityCode = caseRecordInit.municipalityCode;\n            this.surveyAreaNumber = caseRecordInit.surveyAreaNumber;\n            this.establishmentNumber = caseRecordInit.establishmentNumber;\n            this.starCode = caseRecordInit.starCode;\n\n\n            this.isResendAddressSame = caseRecordInit.isResendAddressSame;\n            this.resendCompanyName = caseRecordInit.resendCompanyName;\n            this.resendPostcode = caseRecordInit.resendPostcode;\n            this.resendAddress = caseRecordInit.resendAddress;\n\n            // 調査書類希望理由 (コメントアウト)\n            // this.researchDocumentReasonHope = caseRecordInit.researchDocumentReasonHope;\n            // this.researchDocumentReasonHopeForShow = caseRecordInit.researchDocumentReasonHope ? caseRecordInit.researchDocumentReasonHope.replace(/\\n/g, '<br>') : '';\n\n        }\n    }\n\n    // コンポーネントを表示するときの初期化\n    renderedCallback() {\n        // チェックボックスの設定と表示非表示ブロックを設定\n        let isResendAddressSameCheckbox = this.template.querySelector('.isResendAddressSame');\n        isResendAddressSameCheckbox.checked = this.isResendAddressSame;\n        let ResendAddressSameFieldsDiv = this.template.querySelector('.ResendAddressSameFields');\n        if (isResendAddressSameCheckbox.checked) {\n            ResendAddressSameFieldsDiv.style.display = 'none';\n        } else {\n            ResendAddressSameFieldsDiv.style.display = 'block';\n        }\n        // 改行が表示できるようにする処理 (コメントアウト)\n        // let reasonHopeEl = this.template.querySelector('[data-id=\"researchDocumentReasonHope\"]');\n        // if (reasonHopeEl) {\n        //     reasonHopeEl.innerHTML = this.researchDocumentReasonHopeForShow;\n        // }\n    }\n\n    // 入力画面にもどる\n    backToInput() {\n        const sendCaseFromConfirmEvent = new CustomEvent(\n            'sendcasefromconfirm',\n            { detail: this.caseRecordJson }\n        );\n        this.dispatchEvent(sendCaseFromConfirmEvent);\n    }\n\n    // Apex経由でFormを保存\n    // 2026/02/26 add by zy 防重复提交 BEGIN\n    isSubmitted = false;\n    submit(event) {\n        if (this.isSubmitted) {\n            return;\n        }\n        this.isSubmitted = true;\n        \n        // 押下後、ボタンのテキストを「処理中...」に変更してクリック感を持たせる\n        if (event && event.target) {\n            event.target.textContent = '処理中...';\n            event.target.style.pointerEvents = 'none';\n            event.target.style.opacity = '0.6';\n        }\n\n        let caseRecordForInsert = JSON.parse(this.caseRecordJson);\n        // 2026/02/26 add by zy 防重复提交 END\n        // 書類の発送先の住所と依頼者の住所が同じがチェックONの場合、DBの「書類を発送する郵便番号」「書類を発送する住所」をセット\n        if (caseRecordForInsert.isResendAddressSame === true) {\n            caseRecordForInsert.resendCompanyName = caseRecordForInsert.companyName; // 事業所名もコピー\n            caseRecordForInsert.resendPostcode = caseRecordForInsert.companyPostcode;\n            caseRecordForInsert.resendAddress = caseRecordForInsert.companyAddress;\n        }\n\n        // 法人番号削除により、この処理は不要になりますが、\n        // 既存処理への影響を避けるため、または元に戻す可能性を考慮し、一応コメントアウト。\n        // if (!caseRecordForInsert.corporationNumber || caseRecordForInsert.corporationNumber.trim() === '') {\n        //     caseRecordForInsert.corporationNumber = '-';\n        // }\n\n        caseRecordForInsert.surveyId = caseRecordForInsert.municipalityCode + caseRecordForInsert.surveyAreaNumber + caseRecordForInsert.establishmentNumber + caseRecordForInsert.starCode;\n\n        let caseRecordForInsertJson = JSON.stringify(caseRecordForInsert);\n        console.log('caseRecordForInsertJson', caseRecordForInsertJson);\n\n        // Apexメソッドのパラメータを構築\n        let params = {};\n        params.caseRecordJsonString = JSON.stringify(caseRecordForInsert);\n        InsertCaseResend(params)\n            .then(result => {\n                this.result = result;\n                // if true 完了画面へ\n                if (this.result) {\n                    const sendToSuccessEvent = new CustomEvent(\n                        'tosuccess', { detail: this.result }\n                    );\n                    this.dispatchEvent(sendToSuccessEvent);\n                } else {// if false Error画面へ？\n                    this[NavigationMixin.Navigate]({\n                        type: 'comm__namedPage',\n                        attributes: {\n                            name: 'Error'\n                        }\n                    });\n                }\n            })\n            .catch(error => {\n                console.log(error);\n                this.result = error;\n                this[NavigationMixin.Navigate]({\n                    type: 'comm__namedPage',\n                    attributes: {\n                        name: 'Error'\n                    }\n                });\n            })\n        //  send mail? \n    }\n    toHome() {\n        this[NavigationMixin.Navigate]({\n            type: 'comm__namedPage',\n            attributes: {\n                name: 'Home'\n            }\n        });\n    }\n}"}],"isError":false,"timestamp":1772544279178}}
{"type":"message","id":"5594b1d7","parentId":"54f48a3c","timestamp":"2026-03-03T13:24:39.190Z","message":{"role":"toolResult","toolCallId":"call_Yo0dJzfvx96MmkMjGOBOPItE|fc_011fdad5104f3b770169a6e10faad88191b12ced28fb81e69e","toolName":"read","content":[{"type":"text","text":"import { LightningElement, api, track, wire } from 'lwc';\nimport { NavigationMixin, CurrentPageReference } from 'lightning/navigation';\nimport devModeFlag from '@salesforce/label/c.DEV_MODE_LAB';\n\nexport default class DocumentsResendFormSuccess extends NavigationMixin(LightningElement) {\n    @api caseNumber;\n\n    // コンポーネントを表示するときの初期化\n    renderedCallback() {\n\n    }\n\n    toHome() {\n        this[NavigationMixin.Navigate]({\n            type: 'comm__namedPage',\n            attributes: {\n                name: 'Home'\n            }\n        });\n    }\n}"}],"isError":false,"timestamp":1772544279184}}
{"type":"message","id":"faf57431","parentId":"5594b1d7","timestamp":"2026-03-03T13:25:03.191Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Generating initial test plan outline**","thinkingSignature":"{\"id\":\"rs_011fdad5104f3b770169a6e110fe408191a3319fb22f598a7a\",\"type\":\"reasoning\",\"encrypted_content\":\"gAAAAABppuEUeMaY9I6U78eIuHMpbmqmU6tEHQAn9n_KXAr53hA_YaNih35OvrvgvnLsmyJJplYTWogbMv1ch85x-I375YBzjTJhCvmtwfZ60mjWG6xQxj_law83LC9I_wAzJKHAfkK0q5b0k27T_rcs6BwkE4EVTey_MPXmNhkTQjiiiyWvLIcv5PRwA4GimWna_NabnvZLdp69w4j8rgZ12iCVame44ISkbtV-Y8zl_STqYdTiDLLzIGNX21PReF_Io4CabzkBjC5LtWm13O_LFqOdAuPl0rfgIUWpk-RQBg1WFERVHG8COUj6nvtCHeLoLOMDLs9n_MmJdM9gjmwtnROlj_Bt4FnEkbyWIcw5cPPiH2yQTjINKvF9xJQ_rp8yeXJW6GbsyeBsMjvNiWFwgS98w0hYtOLtATUQ2_7-xKIRuHvHrTH8kbJMB1bbeXfiM_t6QgVu8QiHRNNcFuh2Qeag3lIMIAfox1mw4O4-Mg5WcQYkGFF8_7hgjdcWqCRauT1jQkVdZ-SZsemUzF-EL5lzUmsgJflm5s4WxP8albjAj7Q6kQ-lUnW_h5J13PbRrE6miSn71wCPR3v-fcZjFxZbz-H_HU-w0Obd4p1q_3LFdx379GLh53UxbjiRFf-eCSF7-vSwcjQUVvWZSUefS9sd4IUQ7NdbXPemlAz6iq0cOj2dl-SgA8P5gVLuoYOobUBiuc3eSGwmwG7zWmDQyPs52UnXGt6fNxIa_iyF22WAlWXzXcmYvNd6EkIHw7UDfuD-iSOJ1gPM6USOMuNKYjrNh0wMcn5UqRdhnp6ZGfvei8QhScsRuNE2mg9tRmMTAUffhIUEiH2zZqsL9yspdfNFf6GfNJYCWuCzOtEnmpblokOvqld1QgmQ9enO7t-DpriwjLYIxOH2wpNgeD-Mc06W6fpCItxEsAelomdOgF-gWksx4YXIQF7d3RiPGaT3Khf7zZL3uCJZ6a4CLDUBvf8AZbz7bdSiI8bEytL7Lh8IL31va93C8lBKNW6m_vJT9vVoM7ZMPnx-1z6xO45_kRtgm_kgbq6Bis7eY90zKmntVgX77nvfWHX3Co3y3FBrrhapK9xQ9HDBzerW_4VWeJRjs96L_jluo7IZv5JU2mzYY1PpS40HlNRZ0WSz8fEfvSyZvTaEl9J0eTtC4HnqjRu93mJl01FjpKxDH5z8Ty2xjQefySHk9-bskx2-3RKKEK1rXeWUib-VRWklR2RnerhJMzXsZNQperKWUSslNqp5dCEcfVcOF-ZfmS378z0uZof4KeiHUkDbbMYoyjqj5FsNg8RdbVpQ8EUsIpYUwY3LM5hk3hUtpgspBya2uszRD4EtNj1YKCaFVDIjIvmnIOWRvadsu0x8h_Y_mRzJxJvhBvR0ElOPgYAvxPXT7l5QXXxWNlXK\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Generating initial test plan outline**\"}]}"},{"type":"text","text":"[[reply_to_current]] 收到，我已经解包并看过你发的代码包了（是一个 LWC 的“书类补发申请”4步流程：Input → Confirm → Success + Page 容器）。\n\n下面直接给你一版**可用的《单体测试书》初稿**（基于代码反推）：\n\n**1) 项目与模块信息**\n- 项目：Documents Resend Form（推定）\n- 模块：`documentsResendFormPage / Input / Confirm / Success`\n- 目标：用户提交“书类补发”申请，后端创建 Case 并返回 caseNumber\n- 技术：Salesforce LWC + Apex（`FormCommonController`）\n\n**2) 测试范围 / 不测范围**\n- 测试范围  \n  - 表单页面显示与步骤切换  \n  - 前端必填与格式校验  \n  - 地址联动（邮编查地址）  \n  - 确认页回填与提交  \n  - 提交防重（isSubmitted）  \n  - 成功页展示（caseNumber）\n- 不测范围  \n  - Apex 内部业务逻辑细节（仅做黑盒接口验证）  \n  - 第三方地址库准确性（仅验证调用结果处理）\n\n**3) 测试环境与依赖**\n- Salesforce Experience Cloud 页面可访问\n- Label配置：\n  - `Resend_Form_Start_Date`\n  - `Resend_Form_Not_Started_Msg`\n  - `imageHelpPageURL`\n- Apex依赖：\n  - `GetAddressInfo`\n  - `InsertCaseResend`\n- 需要测试账号与页面路由权限\n\n**4) 测试策略**\n- 正常流：完整填写 → 确认 → 提交 → 成功\n- 异常流：必填缺失、格式错误、Apex异常、返回false\n- 边界值：\n  - 电话：10/11位\n  - 邮编：7位\n  - municipalityCode:5位\n  - surveyAreaNumber:4位\n  - establishmentNumber:4位\n  - starCode:1位\n- 权限/可用性：页面可访问、Home/Error 导航可达\n- 一致性：`surveyId = 5+4+4+1` 拼接正确；同地址勾选时目标地址复制一致\n\n**5) 核心测试点清单**\n- 受付开始日期前后显示逻辑正确（isFormOpen）\n- “与依赖者地址相同”勾选时：补发地址块隐藏并清空\n- 取消勾选时：补发地址块恢复显示\n- `toConfirm` 前端校验能阻止非法提交并展示错误区\n- 邮编查地址结果能正确写入 company/resend 地址框\n- Confirm页“返回输入”数据不丢失\n- Submit只允许一次点击提交（防重复）\n- 提交成功后跳 Success，失败跳 Error\n\n**6) 测试用例（节选）**\n- TC-001 正常提交  \n  - 前置：表单开放、账号有权限  \n  - 步骤：填全部合法值→确认→提交  \n  - 预期：创建Case成功，跳转成功页，显示caseNumber  \n  - 优先级：P0\n- TC-002 必填缺失  \n  - 步骤：清空申请人姓名提交  \n  - 预期：错误区提示“请输入”，不进入确认页  \n  - 优先级：P0\n- TC-003 邮编格式错误  \n  - 步骤：输入6位或含非数字邮编  \n  - 预期：格式报错，不通过  \n  - 优先级：P1\n- TC-004 电话边界  \n  - 步骤：输入9/10/11/12位  \n  - 预期：仅10/11位通过  \n  - 优先级：P1\n- TC-005 代码位数校验  \n  - 步骤：分别输入不满足 5/4/4/1 位  \n  - 预期：对应字段报错  \n  - 优先级：P0\n- TC-006 同地址勾选逻辑  \n  - 步骤：勾选“同地址”并提交  \n  - 预期：resendCompanyName/postcode/address 自动取 company 对应值  \n  - 优先级：P0\n- TC-007 防重复提交  \n  - 步骤：连续快速点击提交按钮  \n  - 预期：仅一次提交；按钮变“処理中...”且不可再次点击  \n  - 优先级：P0\n- TC-008 后端异常  \n  - 步骤：模拟 InsertCaseResend 抛错  \n  - 预期：跳 Error 页  \n  - 优先级：P0\n\n**7) 风险与阻塞**\n- 当前代码中部分字段有“注释/历史残留”（如 surveyId old check、corporationNumber），需确认最终业务口径\n- 地址API返回空串时仅console，无明确用户提示（可作为改进项）\n- `invalid—value` 类名中连字符字符可能有兼容风险（建议代码审查）\n\n---\n\n如果你要，我下一条可以直接给你：\n1) **完整版（30~50条用例）Markdown**  \n2) 或者直接给你**Excel可粘贴格式**（列：编号/模块/前置/步骤/预期/优先级）。","textSignature":"msg_011fdad5104f3b770169a6e1148bf88191bc17551ad04e96b6"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":7999,"output":1310,"cacheRead":17920,"cacheWrite":0,"totalTokens":27229,"cost":{"input":0.01399825,"output":0.01834,"cacheRead":0.003136,"cacheWrite":0,"total":0.03547425}},"stopReason":"stop","timestamp":1772544279191}}
