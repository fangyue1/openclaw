output":230,"cacheRead":11008,"cacheWrite":0,"totalTokens":11445,"cost":{"input":0.00036225,"output":0.0032199999999999998,"cacheRead":0.0019264,"cacheWrite":0,"total":0.00550865}},"stopReason":"stop","timestamp":1772539500890}}
