'6','','「入力画面へもどり修正する」をクリックする','-','STEP2へ戻り、入力済みデータが保持されること。','OK','','','',''),\n@('','7','','再度「入力内容の確認」→「送信する」をクリックする','Apex InsertCaseResend 正常','STEP4（完了画面）へ遷移し、受付番号が表示されること。','OK','','','',''),\n@('','8','（正常系）STEP4 完了画面','「トップページにもどる」をクリックする','-','トップページへ遷移すること。','OK','','','',''),\n@('','9','（正常系）同一住所チェック','「書類のお届け先の住所と依頼者の住所が同じ」にチェックする','-','お届け先入力欄（事業所名/郵便番号/住所）が非表示になること。','OK','','','',''),\n@('','10','','同一住所チェックONのまま送信する','-','送信時にお届け先情報へ依頼者側住所情報がコピーされること。','OK','','','',''),\n@('','11','（異常系）必須未入力','必須項目を空欄のまま「入力内容の確認」を押下する','-','エラーセクションに必須エラーメッセージが表示されること。','OK','','','',''),\n@('','12','','事業所の郵便番号に不正値を入力','177-003','「事業所の郵便番号を正しいフォーマットで入力してください」が表示されること。','OK','','','',''),\n@('','13','','申請者の電話番号に不正値を入力','07044777-003','「申請者の電話番号を10また11桁の半角数字で入力してください」が表示されること。','OK','','','',''),\n@('','14','','申請者のメールアドレスに不正値を入力','etsu.hougrids.co.jp','「申請者のメールアドレスを正しいフォーマットで入力してください」が表示されること。','OK','','','',''),\n@('','15','','市区町村コードに不正値を入力','121a','「市区町村コードを5桁の半角数字で入力してください」が表示されること。','OK','','','',''),\n@('','16','','調査区番号に不正値を入力','12a','「調査区番号を4桁の半角数字で入力してください」が表示されること。','OK','','','',''),\n@('','17','','事業所番号に不正値を入力','12','「事業所番号を4桁の半角数字で入力してください」が表示されること。','OK','','','',''),\n@('','18','','＊コードに不正値を入力','a','「＊コードを1桁の半角数字で入力してください」が表示されること。','OK','','','',''),\n@('','19','（異常系）送信失敗','「送信する」をクリックする','InsertCaseResend が false を返す','Errorページへ遷移すること。','OK','','','',''),\n@('','20','','「送信する」をクリックする','InsertCaseResend 実行時に例外発生','Errorページへ遷移すること。','OK','','','',''),\n@('','21','（制御）二重送信防止','「送信する」を連続クリックする','-','1回のみ送信され、ボタン表示が「処理中...」となり再送信できないこと。','OK','','','','')\n);\n$r=8; foreach($row in $rows){ for($c=1;$c -le 11;$c++){ $ws.Cells.Item($r,$c).Value2=[string]$row[$c-1] }; $r++ }\n$wb.Save(); $wb.Close($true); $excel.Quit();\n[System.Runtime.Interopservices.Marshal]::ReleaseComObject($ws)|Out-Null; [System.Runtime.Interopservices.Marshal]::ReleaseComObject($wb)|Out-Null; [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel)|Out-Null;\nWrite-Out