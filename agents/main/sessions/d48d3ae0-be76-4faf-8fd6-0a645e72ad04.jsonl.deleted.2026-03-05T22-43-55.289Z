ountRef":{"sensitive":true,"tags":["security","network","channels"]},"channels.slack.signingSecret":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.slack.accounts.*.signingSecret":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.slack.accounts.*.botToken":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.slack.accounts.*.appToken":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.slack.accounts.*.userToken":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.bluebubbles.password":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.bluebubbles.accounts.*.password":{"sensitive":true,"tags":["security","auth","network","channels"]},"channels.msteams.appPassword":{"sensitive":true,"tags":["security","auth","network","channels"]},"skills.entries.*.apiKey":{"sensitive":true,"tags":["security","auth"]},"plugins.entries.acpx":{"label":"ACPX Runtime","help":"ACP runtime backend powered by acpx with configurable command path and version policy. (plugin: acpx)","tags":["advanced"]},"plugins.entries.acpx.enabled":{"label":"Enable ACPX Runtime","tags":["advanced"]},"plugins.entries.acpx.config":{"label":"ACPX Runtime Config","help":"Plugin-defined config payload for acpx.","tags":["advanced"]},"plugins.entries.acpx.config.command":{"label":"acpx Command","help":"Optional path/command override for acpx (for example /home/user/repos/acpx/dist/cli.js). Leave unset to use plugin-local bundled acpx.","tags":["advanced"]},"plugins.entries.acpx.config.expectedVersion":{"label":"Expected acpx Version","help":"Exact version to enforce (for example 0.1.15) or \"any\" to skip strict version matching.","tags":["advanced"]},"plugins.entries.acpx.config.cwd":{"label":"Default Working Directory","help":"Default cwd for ACP session operations when not set per session.","tags":["advanced"]},"plugins.entries.acpx.config.permissionMode":{"label":"Permission Mode","help":"Default acpx permission policy for runtime prompts.","tags":["access"]},"plugins.entries.acpx.config.nonInteractivePermissions":{"label":"Non-Interactive Permission Policy","help":"acpx policy when interactive permission prompts are unavailable.","tags":["access"]},"plugins.entries.acpx.config.strictWindowsCmdWrapper":{"label":"Strict Windows cmd Wrapper","help":"Enabled by default. On Windows, reject unresolved .cmd/.bat wrappers instead of shell fallback. Disable only for compatibility with non-standard wrappers.","advanced":true,"tags":["advanced"]},"plugins.entries.acpx.config.timeoutSeconds":{"label":"Prompt Timeout Seconds","help":"Optional acpx timeout for each runtime turn.","advanced":true,"tags":["performance","advanced"]},"plugins.entries.acpx.config.queueOwnerTtlSeconds":{"label":"Queue Owner TTL Seconds","help":"Idle queue-owner TTL for acpx prompt turns. Keep this short in OpenClaw to avoid delayed completion after each turn.","advanced":true,"tags":["access","advanced"]},"plugins.entries.bluebubbles":{"label":"@openclaw/bluebubbles","help":"OpenClaw BlueBubbles channel plugin (plugin: bluebubbles)","tags":["advanced"]},"plugins.entries.bluebubbles.enabled":{"label":"Enable @openclaw/bluebubbles","tags":["advanced"]},"plugins.entries.bluebubbles.config":{"label":"@openclaw/bluebubbles Config","help":"Plugin-defined config payload for bluebubbles.","tags":["advanced"]},"plugins.entries.copilot-proxy":{"label":"@openclaw/copilot-proxy","help":"OpenClaw Copilot Proxy provider plugin (plugin: copilot-proxy)","tags":["advanced"]},"plugins.entries.copilot-proxy.enabled":{"label":"Enable @openclaw/copilot-proxy","tags":["advanced"]},"plugins.entries.copilot-proxy.config":{"label":"@openclaw/copilot-proxy Config","help":"Plugin-defined config payload for copilot-proxy.","tags":["advanced"]},"plugins.entries.device-pair":{"label":"Device Pairing","help":"Generate setup codes and approve device pairing requests. (plugin: device-p