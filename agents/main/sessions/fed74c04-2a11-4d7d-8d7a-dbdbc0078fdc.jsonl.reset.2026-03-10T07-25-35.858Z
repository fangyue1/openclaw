XnH1C6-ewwPiuOi-bmL3_r_0eZSBXJD3gwjmNawIDp4k-ic94Il3S8nyNQbW6_HntZj3W6Lit41oNSC5aC73UzUoGxgYQnsy6QU4_S2u-KRFx9kWwq6Q0i7BLaPkUcttJtIvSSHsKrbA6HVjBpfX9WRcYby6LwyBfcnv99j3gOvk6R0c_T6MENnT9owmMRoiUtHQY699tJpoIfCcqZS_joaSifc6yz8TYuhjqNE_bkangdmZ2OSKEWLhhxtS4sbHq9pXCYkAWWfWf3FTlRxCygVQVb6nYdVSvb11ZQ3ki4KeVdSq80_labhW4aTSGBTKYfwrwbBzdP6r7bWBF3PR0HlIUmFoCVYYrFcf8kQu_C5xq0ygeOkFvOz8ys2oY2Atw6XSTxaTz38_YKru3WzESwAWqA_jjU4fIaeDAsutWg==\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Implementing template clone generator**\"}]}"},{"type":"toolCall","id":"call_OgDL7gqI7JsMYMFqEnYVgbIQ|fc_01a0ede22534998d0169aec465e0148191ad9e7e0241a84382","name":"write","arguments":{"path":"C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\scripts\\generate_template_clone_cases.py","content":"import argparse\nimport json\nimport re\nfrom pathlib import Path\n\n\ndef n(s):\n    return re.sub(r\"\\s+\", \" \", str(s or \"\")).strip()\n\n\ndef load(path):\n    return json.loads(Path(path).read_text(encoding=\"utf-8\"))\n\n\ndef collect_error_messages(code):\n    msgs = []\n    pstr = re.compile(r\"['\\\"]([^'\\\"]{3,120})['\\\"]\")\n    hint = re.compile(r\"error|required|必須|未入力|形式|invalid|message|toast|check\", re.I)\n    for f in code.get(\"files\", []) or []:\n        fp = f.get(\"file\")\n        if not fp:\n            continue\n        p = Path(fp)\n        if not p.exists():\n            continue\n        txt = p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n        for line in txt.splitlines():\n            if hint.search(line):\n                for m in pstr.findall(line):\n                    s = n(m)\n                    if len(s) >= 3:\n                        msgs.append(s)\n    out, seen = [], set()\n    for m in msgs:\n        k = m.lower()\n        if k in seen:\n            continue\n        seen.add(k)\n        out.append(m)\n    return out\n\n\ndef collect_design_checks(design):\n    items = []\n    for fr in design.get(\"field_rules\", []) or []:\n        raw = n(fr.get(\"raw\"))\n        api = (fr.get(\"api_names\") or [\"入力項目\"])[0]\n        required = bool(fr.get(\"required_hint\"))\n        checks = fr.get(\"check_patterns\") or []\n        if required or checks or any(k in raw for k in [\"未入力\", \"必須\", \"エラー\", \"形式\", \"桁\", \"半角\", \"全角\"]):\n            items.append({\"api\": api, \"raw\": raw, \"required\": required, \"checks\": checks})\n    return items\n\n\ndef make_condition(raw, api, check):\n    raw = n(raw)\n    if raw and len(raw) <= 120:\n        return raw\n    if check == \"required\":\n        return f\"{api} を空欄にする\"\n    if check == \"format\":\n        return f\"{api} に不正形式の値を入力する\"\n    return \"不正値を入力する\"\n\n\ndef build_cases(design, code, max_cases=120):\n    msgs = collect_error_messages(code)\n    if not msgs:\n        msgs = [\"必須項目が未入力です\", \"入力形式が正しくありません\"]\n\n    items = collect_design_checks(design)\n    cases = []\n    mi = 0\n\n    for it in items:\n        api = it[\"api\"] or \"入力項目\"\n\n        if it[\"required\"]:\n            msg = msgs[mi % len(msgs)]\n            mi += 1\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{api} 未入力\",\n                \"steps\": \"入力内容の確認ボタンをクリックする\",\n                \"precondition\": make_condition(it[\"raw\"], api, \"required\"),\n                \"expected\": f\"エラーメッセージ「{msg}」が表示されること\",\n            })\n\n        if it[\"checks\"] or any(k in it[\"raw\"] for k in [\"形式\", \"桁\", \"半角\", \"全角\"]):\n            msg = msgs[mi % len(msgs)]\n            mi += 1\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{api} 形式不正\",\n                \"steps\": \"入力内容の確認ボタンをクリックする\",\n                \"precondition\": make_condition(it[\"raw\"], api, \"format\"),\n                \"expected\": f\"エラーメッセージ「{msg}」が表示されること\",\n            })\n\n        if len(cases) >= max_cases:\n            break\n\n    out = []\n    for i, c in enumerate(cases, 1):\n        out.append({\n            \"case_id\": f\"TC-{i:04d}\",\n            \"category\": c[\"category\"],\n            \"title\": c[\"title\"],\n            \"steps\": c[\"steps\"],\n            \"precondition\": c[\"precondition\"],\n            \"expected\": c[\"expected\"],\n        })\n    return out\n\n\ndef to_md(cases):\n    lines = [\"# Unit Test Spec (Template Clone Mode)\", \"\", \"|No|小分類|確認手順|テスト条件|想定結果|\", \"|---|---|---|---|---|\"]\n    for i, c in enumerate(cases, 1):\n        lines.append(f\"|{i}|{c['title']}|{c['steps']}|{c['precondition']}|{c['expected']}|\")\n    return \"\\n\".join(lines)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--out-cases\", required=True)\n    ap.add_argument(\"--out-md\", required=True)\n    args = ap.parse_args()\n\n    design = load(args.design)\n    code = load(args.code)\n    cases = build_cases(design, code)\n\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    Path(args.out_md).write_text(to_md(cases), encoding=\"utf-8\")\n    print(f\"Wrote {args.out_cases} and {args.out_md}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\generate_template_clone_cases.py\",\"content\":\"import argparse\\nimport json\\nimport re\\nfrom pathlib import Path\\n\\n\\ndef n(s):\\n    return re.sub(r\\\"\\\\s+\\\", \\\" \\\", str(s or \\\"\\\")).strip()\\n\\n\\ndef load(path):\\n    return json.loads(Path(path).read_text(encoding=\\\"utf-8\\\"))\\n\\n\\ndef collect_error_messages(code):\\n    msgs = []\\n    pstr = re.compile(r\\\"['\\\\\\\"]([^'\\\\\\\"]{3,120})['\\\\\\\"]\\\")\\n    hint = re.compile(r\\\"error|required|必須|未入力|形式|invalid|message|toast|check\\\", re.I)\\n    for f in code.get(\\\"files\\\", []) or []:\\n        fp = f.get(\\\"file\\\")\\n        if not fp:\\n            continue\\n        p = Path(fp)\\n        if not p.exists():\\n            continue\\n        txt = p.read_text(encoding=\\\"utf-8\\\", errors=\\\"ignore\\\")\\n        for line in txt.splitlines():\\n            if hint.search(line):\\n                for m in pstr.findall(line):\\n                    s = n(m)\\n                    if len(s) >= 3:\\n                        msgs.append(s)\\n    out, seen = [], set()\\n    for m in msgs:\\n        k = m.lower()\\n        if k in seen:\\n            continue\\n        seen.add(k)\\n        out.append(m)\\n    return out\\n\\n\\ndef collect_design_checks(design):\\n    items = []\\n    for fr in design.get(\\\"field_rules\\\", []) or []:\\n        raw = n(fr.get(\\\"raw\\\"))\\n        api = (fr.get(\\\"api_names\\\") or [\\\"入力項目\\\"])[0]\\n        required = bool(fr.get(\\\"required_hint\\\"))\\n        checks = fr.get(\\\"check_patterns\\\") or []\\n        if required or checks or any(k in raw for k in [\\\"未入力\\\", \\\"必須\\\", \\\"エラー\\\", \\\"形式\\\", \\\"桁\\\", \\\"半角\\\", \\\"全角\\\"]):\\n            items.append({\\\"api\\\": api, \\\"raw\\\": raw, \\\"required\\\": required, \\\"checks\\\": checks})\\n    return items\\n\\n\\ndef make_condition(raw, api, check):\\n    raw = n(raw)\\n    if raw and len(raw) <= 120:\\n        return raw\\n    if check == \\\"required\\\":\\n        return f\\\"{api} を空欄にする\\\"\\n    if check == \\\"format\\\":\\n        return f\\\"{api} に不正形式の値を入力する\\\"\\n    return \\\"不正値を入力する\\\"\\n\\n\\ndef build_cases(design, code, max_cases=120):\\n    msgs = collect_error_messages(code)\\n    if not msgs:\\n        msgs = [\\\"必須項目が未入力です\\\", \\\"入力形式が正しくありません\\\"]\\n\\n    items = collect_design_checks(design)\\n    cases = []\\n    mi = 0\\n\\n    for it in items:\\n        api = it[\\\"api\\\"] or \\\"入力項目\\\"\\n\\n        if it[\\\"required\\\"]:\\n            msg = msgs[mi % len(msgs)]\\n            mi += 1\\n            cases.append({\\n                \\\"category\\\": \\\"コールバック予約\\\",\\n                \\\"title\\\": f\\\"（異常系）{api} 未入力\\\",\\n                \\\"steps\\\": \\\"入力内容の確認ボタンをクリックする\\\",\\n                \\\"precondition\\\": make_condition(it[\\\"raw\\\"], api, \\\"required\\\"),\\n                \\\"expected\\\": f\\\"エラーメッセージ「{msg}」が表示されること\\\",\\n            })\\n\\n        if it[\\\"checks\\\"] or any(k in it[\\\"raw\\\"] for k in [\\\"形式\\\", \\\"桁\\\", \\\"半角\\\", \\\"全角\\\"]):\\n            msg = msgs[mi % len(msgs)]\\n            mi += 1\\n            cases.append({\\n                \\\"category\\\": \\\"コールバック予約\\\",\\n                \\\"title\\\": f\\\"（異常系）{api} 形式不正\\\",\\n                \\\"steps\\\": \\\"入力内容の確認ボタンをクリックする\\\",\\n                \\\"precondition\\\": make_condition(it[\\\"raw\\\"], api, \\\"format\\\"),\\n                \\\"expected\\\": f\\\"エラーメッセージ「{msg}」が表示されること\\\",\\n            })\\n\\n        if len(cases) >= max_cases:\\n            break\\n\\n    out = []\\n    for i, c in enumerate(cases, 1):\\n        out.append({\\n            \\\"case_id\\\": f\\\"TC-{i:04d}\\\",\\n            \\\"category\\\": c[\\\"category\\\"],\\n            \\\"title\\\": c[\\\"title\\\"],\\n            \\\"steps\\\": c[\\\"steps\\\"],\\n            \\\"precondition\\\": c[\\\"precondition\\\"],\\n            \\\"expected\\\": c[\\\"expected\\\"],\\n        })\\n    return out\\n\\n\\ndef to_md(cases):\\n    lines = [\\\"# Unit Test Spec (Template Clone Mode)\\\", \\\"\\\", \\\"|No|小分類|確認手順|テスト条件|想定結果|\\\", \\\"|---|---|---|---|---|\\\"]\\n    for i, c in enumerate(cases, 1):\\n        lines.append(f\\\"|{i}|{c['title']}|{c['steps']}|{c['precondition']}|{c['expected']}|\\\")\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--design\\\", required=True)\\n    ap.add_argument(\\\"--code\\\", required=True)\\n    ap.add_argument(\\\"--out-cases\\\", required=True)\\