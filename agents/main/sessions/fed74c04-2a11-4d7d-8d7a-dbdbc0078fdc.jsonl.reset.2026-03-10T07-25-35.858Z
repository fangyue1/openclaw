[]\n\n    # 1) screen-step style (C/D/F/G aligned)\n    for it in items[:25]:\n        raw = it[\"raw\"]\n        if not raw:\n            continue\n        if any(k in raw for k in [\"クリック\", \"入力\", \"遷移\", \"表示\", \"確認\", \"選択\", \"ボタン\"]):\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": \"（画面手順）操作確認\",\n                \"steps\": raw,\n                \"precondition\": \"ー\",\n                \"expected\": \"画面設計書どおりに表示・遷移・操作できること\",\n            })\n\n    # 2) exception-first rows with explicit message check\n    i = 0\n    for it in items[:80]:\n        field = it[\"api\"] or \"入力項目\"\n        if it[\"required\"]:\n            msg = msgs[i % len(msgs)]\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{field} 未入力\",\n                \"steps\": f\"{field} を未入力のまま「入力内容の確認」ボタンをクリックする\",\n                \"precondition\": f\"{field} を空欄にする\",\n                \"expected\": f\"エラーメッセージ「{msg}」が表示され、次画面へ遷移しないこと\",\n            })\n            i += 1\n        if it[\"checks\"]:\n            msg = msgs[i % len(msgs)]\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{field} 形式不正\",\n                \"steps\": f\"{field} に不正な形式の値を入力して「入力内容の確認」ボタンをクリックする\",\n                \"precondition\": f\"{field} に不正値を入力する（{it['checks'][0]}）\",\n                \"expected\": f\"エラーメッセージ「{msg}」が表示されること\",\n            })\n            i += 1\n\n        if len(cases) >= 120:\n            break\n\n    # preserve only template-write fields\n    out = []","new_string":"def split_step_condition(raw: str):\n    raw = n(raw)\n    if not raw:\n        return None, None\n\n    # common parser output joins with \" | \" -> first chunk as action, rest as concrete examples\n    if \" | \" in raw:\n        parts = [p.strip() for p in raw.split(\"|\") if p.strip()]\n        if len(parts) >= 2:\n            step = parts[0]\n            cond = \" / \".join(parts[1:])\n            return step, cond\n\n    # Heuristic: when line contains concrete values/examples, keep them in test condition\n    if any(k in raw for k in [\"~\", \"（\", \"）\", \"○\", \"△\", \"×\", \"@\", \"http\", \"桁\", \"半角\", \"全角\", \"例\", \"1111\", \"202\", \"3/\", \"4/\"]):\n        return \"対象画面で指定操作を実行する\", raw\n\n    return raw, \"ー\"\n\n\ndef build_cases(design, code, sem):\n    items = collect_design_items(design)\n    msgs = collect_error_messages_from_code(code)\n    if not msgs:\n        msgs = [\"必須項目が未入力です\", \"入力形式が正しくありません\"]\n\n    cases = []\n\n    # 1) screen-step rows: keep action in 確認手順, move concrete examples to テスト条件\n    for it in items[:35]:\n        raw = it[\"raw\"]\n        if not raw:\n            continue\n        if any(k in raw for k in [\"クリック\", \"入力\", \"遷移\", \"表示\", \"確認\", \"選択\", \"ボタン\"]):\n            step, cond = split_step_condition(raw)\n            if not step:\n                continue\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": \"（画面手順）操作確認\",\n                \"steps\": step,\n                \"precondition\": cond or \"ー\",\n                \"expected\": \"画面設計書どおりに表示・遷移・操作できること\",\n            })\n\n    # 2) exception-first rows with explicit message check\n    i = 0\n    for it in items[:80]:\n        field = it[\"api\"] or \"入力項目\"\n        if it[\"required\"]:\n            msg = msgs[i % len(msgs)]\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{field} 未入力\",\n                \"steps\": f\"{field} を未入力のまま「入力内容の確認」ボタンをクリックする\",\n                \"precondition\": f\"{field} を空欄にする\",\n                \"expected\": f\"エラーメッセージ「{msg}」が表示され、次画面へ遷移しないこと\",\n            })\n            i += 1\n        if it[\"checks\"]:\n            msg = msgs[i % len(msgs)]\n            cases.append({\n                \"category\": \"コールバック予約\",\n                \"title\": f\"（異常系）{field} 形式不正\",\n                \"steps\": f\"{field} に不正な形式の値を入力して「入力内容の確認」ボタンをクリックする\",\n                \"precondition\": f\"{field} に不正値を入力する（{it['checks'][0]}）\",\n                \"expected\": f\"エラーメッセージ「{msg}」が表示されること\",\n            })\n            i += 1\n\n        if len(cases) >= 120:\n            break\n\n    # preserve only template-write fields\n    out = []"},"partialJson":"{\"path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\generate_cases_by_template_semantics.py\",\"old_string\":\"def build_cases(design, code, sem):\\n    items = collect_design_items(design)\\n    msgs = collect_error_messages_from_code(code)\\n    if not msgs:\\n        msgs = [\\\"必須項目が未入力です\\\", \\\"入力形式が正しくありません\\\"]\\n\\n    cases = []\\n\\n    # 1) screen-step style (C/D/F/G aligned)\\n    for it in items[:25]:\\n        raw = it[\\\"raw\\\"]\\n        if not raw:\\n            continue\\n        if any(k in raw for k in [\\\"クリック\\\", \\\"入力\\\", \\\"遷移\\\", \\\"表示\\\", \\\"確認\\\", \\\"選択\\\", \\\"ボタン\\\"]):\\n            cases.append({\\n                \\\"category\\\": \\\"コールバック予約\\\",\\n                \\\"title\\\": \\\"（画面手順）操作確認\\\",\\n                \\\"steps\\\": raw,\\n                \\\"precondition\\\": \\\"ー\\\",\\n                \\\"expected\\\": \\\"画面設計書どおりに表示・遷移・操作できること\\\",\\n            })\\n\\n    # 2) exception-first rows with explicit message check\\n    i = 0\\n    for it in items[:80]:\\n        field = it[\\\"api\\\"] or \\\"入力項目\\\"\\n        if it[\\\"required\\\"]:\\n            msg = msgs[i % len(msgs)]\\n            cases.append({\\n                \\\"category\\\": \\\"コールバック予約\\\",\\n                \\\"title\\\": f\\\"（異常系）{field} 未入力\\\",\\n                \\\"steps\\\": f\\\"{field} を未入力のまま「入力内容の確認」ボタンをクリックする\\\",\\n                \\\"precondition\\\": f\\\"{field} を空欄にする\\\",\\n                \\\"expected\\\": f\\\"エラーメッセージ「{msg}」が表示され、次画面へ遷移しないこと\\\",\\n            })\\n            i