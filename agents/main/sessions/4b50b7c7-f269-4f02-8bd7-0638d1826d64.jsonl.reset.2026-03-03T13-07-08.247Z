{"type":"message","id":"dfbc83af","parentId":"2216453c","timestamp":"2026-03-03T12:43:19.394Z","message":{"role":"user","content":[{"type":"text","text":"Sender (untrusted metadata):\n```json\n{\n  \"label\": \"openclaw-control-ui\",\n  \"id\": \"openclaw-control-ui\"\n}\n```\n\n[Tue 2026-03-03 21:43 GMT+9] 看下有帮助吗 ：[21:40, 2026年3月3日] 贾维斯: 【脚本2/4】extract_code_rules.py - LWC/Apex代码解析\n\n功能：解析LWC JavaScript和Apex代码，提取测试场景\n\n```python\n#!/usr/bin/env python3\n\"\"\"LWC / Apex 代码解析脚本\"\"\"\nimport sys\nimport json\nimport re\nfrom pathlib import Path\nfrom datetime import datetime\n\nclass CodeRuleExtractor:\n def _init_(self, code_dir):\n self.code_dir = Path(code_dir)\n self.result = {\n \"metadata\": {\"parsed_at\": datetime.now().isoformat()},\n \"lwc\": {}, \"apex\": {}, \"testScenarios\": []\n }\n \n def extract_all(self):\n print(f\"📂 扫描目录: {self.code_dir}\")\n \n # 扫描所有 .js 文件\n for js_file in self.code_dir.rglob(\"*.js\"):\n if not str(js_file).endswith(\"-meta.xml\"):\n self._extract_lwc_component(js_file.parent)\n \n # 扫描所有 .cls 文件\n for cls_file in self.code_dir.rglob(\"*.cls\"):\n self._extract_apex_class(cls_file)\n \n self._generate_test_scenarios()\n return self.result\n \n def _extract_lwc_component(self, component_path):\n component_name = component_path.name\n js_file = component_path / f\"{component_name}.js\"\n \n if not js_file.exists(): return\n \n print(f\"\\n🔷 LWC: {component_name}\")\n js_content = js_file.read_text(encoding='utf-8')\n \n component_info = {\n \"name\": component_name,\n \"methods\": [],\n \"wireMethods\": [],\n \"branches\": []\n }\n \n # 提取所有方法\n methods = re.findall(r'\\s+(\\w+)\\s*\\([^)]\\)\\s\\{', js_content)\n component_info[\"methods\"] = list(set(methods))\n print(f\" 方法: {component_info['methods']}\")\n \n # 提取 @wire 方法\n wire_methods = re.findall(r'@wire\\s*\\(\\s*(\\w+)', js_content)\n component_info[\"wireMethods\"] = wire_methods\n \n # 提取 if/else 分支\n branches = re.findall(r'if\\s*\\(\\s*([^)]+)\\s*\\)', js_content)\n component_info[\"branches\"] = [{\"condition\": b, \"testCases\": [\n {\"condition\": f\"{b}=true\", \"expected\": \"真分支\"},\n {\"condition\": f\"{b}=false\", \"expected\": \"假分支\"}\n ]} for b in branches]\n print(f\" 分支: {len(branches)}个\")\n \n self.result[\"lwc\"][component_name] = component_info\n \n def _extract_apex_class(self, cls_file):\n class_name = cls_file.stem\n print(f\"\\n🔶 Apex: {class_name}\")\n \n cls_content = cls_file.read_text(encoding='utf-8')\n \n class_info = {\n \"name\": class_name,\n \"methods\": [],\n \"dmlOperations\": [],\n \"exceptionHandling\": False\n }\n \n # 提取方法\n method_matches = re.findall(\n r'(?:public|private|global)\\s+(?:static\\s+)?(\\w+)\\s+(\\w+)\\s*\\(([^)]*)\\)',\n cls_content\n )\n \n for return_type, method_name, params in method_matches:\n class_info[\"methods\"].append({\n \"name\": method_name,\n \"parameters\": [p.strip() for p in params.split(\",\") if p.strip()]\n })\n \n # 检查 DML 和异常处理\n class_info[\"dmlOperations\"] = bool(re.search(r'\\b(insert|update|delete)\\s+\\w+', cls_content))\n class_info[\"exceptionHandling\"] = \"try\" in cls_content and \"catch\" in cls_content\n \n print(f\" 方法: {[m['name'] for m in class_info['methods']]}\")\n print(f\" DML: {class_info['dmlOperations']}, 异常处理: {class_info['exceptionHandling']}\")\n \n self.result[\"apex\"][class_name] = class_info\n \n def _generate_test_scenarios(self):\n \"\"\"基于代码生成测试场景\"\"\"\n print(\"\\n📝 生成测试场景...\")\n \n scenarios = []\n \n # 从 LWC 生成\n for comp_name, comp_info in self.result[\"lwc\"].items():\n for branch in comp_info.get(\"branches\", []):\n[21:40, 2026年3月3日] 贾维斯: scenarios.append({\n \"id\": f\"TC{len(scenarios)+1:03d}\",\n \"type\": \"正常系\",\n \"component\": comp_name,\n \"description\": f\"{comp_name}_分支测试\",\n \"precondition\": branch[\"condition\"],\n \"action\": \"画面操作\",\n \"expectedResult\": \"按条件执行\"\n })\n \n # 从 Apex 生成\n for class_name, class_info in self.result[\"apex\"].items():\n for method in class_info.get(\"methods\", []):\n scenarios.append({\n \"id\": f\"TC{len(scenarios)+1:03d}\",\n \"type\": \"正常系\",\n \"component\": class_name,\n \"description\": f\"{method['name']}_正常处理\",\n …\n[21:41, 2026年3月3日] 贾维斯: ✅ 脚本2发送成功！继续发送脚本3：\n[21:41, 2026年3月3日] 贾维斯: 【脚本3/4】generate_testbook.py - 生成高精度测试书\n\n功能：整合设计规则和代码规则，生成标准格式测试书\n\n```python\n#!/usr/bin/env python3\n\"\"\"单体测试书生成脚本\"\"\"\nimport sys\nimport json\nfrom pathlib import Path\nfrom datetime import datetime\n\nclass TestBookGenerator:\n def _init_(self, design_rules_path, code_rules_path):\n with open(design_rules_path, 'r', encoding='utf-8') as f:\n self.design_rules = json.load(f)\n with open(code_rules_path, 'r', encoding='utf-8') as f:\n self.code_rules = json.load(f)\n self.test_cases = []\n \n def generate(self):\n print(\"🚀 开始生成测试书...\")\n self._generate_display_tests()\n self._generate_validation_tests()\n self._generate_functional_tests()\n print(f\"✅ 共生成 {len(self.test_cases)} 个测试用例\")\n …\n[21:41, 2026年3月3日] 贾维斯: (\"【STEP2→3】登録失敗_DBエラー\", \"1. DB接続エラーを発生させる\\n2.「送信」ボタンを押下\", \"-\", \"システムエラーメッセージが表示\\nエラーログが出力される\")\n ]\n \n for name, proc, cond, expected in error_cases:\n self.test_cases.append({\n \"No\": no, \"大分類\": \"機能系（異常系）\",\n \"小分類\": name, \"確認手順\": proc,\n \"アカウント\": \"-\", \"テスト条件\": cond,\n \"想定結果\": expected,\n \"テスト\": \"\", \"実施者\": \"\", \"実施日\": \"\", \"備考\": \"\"\n })\n no += 1\n \n def to_markdown(self):\n \"\"\"转Markdown\"\"\"\n md = f\"# 単体試験書_高精度版\\n\\n*生成时间*: {datetime.now().strftime('%Y-%m-%d')}\\n\\n\"\n md += \"## 测试一览\\n\\n| No | 大分類 | 小分類 | 確認手順 | アカウント | テスト条件 | 想定結果 | テスト | 実施者 | 実施日 | 備考 |\\n\"\n md += \"|:--:|:------|:------|:--------|:----------|:---…\n[21:41, 2026年3月3日] 贾维斯: ✅ 脚本3发送成功！发送最后一个脚本4：\n[21:42, 2026年3月3日] 贾维斯: 【脚本4/4】export_to_excel.py - Markdown转Excel\n\n功能：将高精度Markdown测试书导出为标准Excel格式\n\npython\n#!/usr/bin/env python3\n\"\"\"Markdown 转 Excel 脚本\"\"\"\nimport sys\nimport re\nfrom pathlib import Path\nimport pandas as pd\nfrom openpyxl import load_workbook\nfrom openpyxl.styles import Font, Alignment, Border, Side, PatternFill\n\nclass MarkdownToExcelConverter:\n def __init__(self, md_path):\n self.md_path = Path(md_path)\n self.test_cases = []\n \n def parse_markdown(self):\n print(f\"📖 解析: {self.md_path}\")\n content = self.md_path.read_text(encoding='utf-8')\n \n # 提取表格\n table_match = re.search(r'## 测试一览\\s*\\n\\n((?:\\|[^\\n]+\\|\\n)+)', content, re.DOTALL)\n if table_match:\n self._parse_table(table_match.group(1))\n …\n[21:42, 2026年3月3日] 贾维斯: ✅ 脚本4发送成功！最后发送使用说明：\n[21:42, 2026年3月3日] 贾维斯: 【使用说明】单体测试书生成系统\n\n## 📋 完整执行流程\n\nbash\n# Step 1: 解析设计书\npython3 parse_design_excel.py design_book.xlsx\n# 输出: design_book_parsed.json\n\n# Step 2: 解析代码\npython3 extract_code_rules.py inputs/WF001/code/\n# 输出: code_rules.json\n\n# Step 3: 生成测试书\npython3 generate_testbook.py design_rules.json code_rules.json\n# 输出: UnitTestSpec_HighPrecision.md\n\n# Step 4: 导出Excel\npython3 export_to_excel.py UnitTestSpec_HighPrecision.md\n# 输出: 単体試験書.xlsx\n\n\n## 📦 Python 依赖安装\n\nbash\npip install pandas openpyxl jinja2\n\n\n## 📊 WF001 成果\n\n- ✅ 15个测试用例\n- ✅ 高精度版 Markdown + Excel\n- ✅ 标准单体测试书格式\n\n所有脚本已保存在电脑上，回去后可以直接使用！\n\n【四个脚本全部发送完毕】\n[21:42, 2026年3月3日] 贾维斯: ✅ *全部脚本发送完成！*\n\n📋 已发送内容\n\n*1*\n* 脚本: parse_design_excel.py\n* 功能: Excel设计书解析\n\n*2*\n* 脚本: extract_code_rules.py\n* 功能: LWC/Apex代码解析\n\n*3*\n* 脚本: generate_testbook.py\n* 功能: 生成高精度测试书\n\n*4*\n* 脚本: export_to_excel.py\n* 功能: Markdown转Excel\n\n*5*\n* 脚本: *使用说明*\n* 功能: 完整执行流程\n\n所有脚本都是*完整可运行的代码*，回去后可以直接：\n\n1. 保存为 .py 文件\n2. 安装依赖 pip install pandas openpyxl jinja2\n3. 按使用说明执行\n如果还有其他问题，随时问我！"}],"timestamp":1772541799391}}
