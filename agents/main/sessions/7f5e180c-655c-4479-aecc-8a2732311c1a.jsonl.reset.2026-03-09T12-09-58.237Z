LVF|fc_008479681a0544180169aa56f74f088191bb93d7d103820dae","name":"exec","arguments":{"command":"python -X utf8 - << 'PY'\nimport json\nfrom copy import copy\nfrom openpyxl import load_workbook\nfrom openpyxl.cell.cell import MergedCell\n\ntemplate = r'C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\workspace\\inputs\\template\\template_latest.xlsx'\ncases_path = r'C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\workspace\\runs\\run-20260306-1323\\cases.json'\nout = r'C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\workspace\\runs\\run-20260306-1323\\unit_test_book_template_strict.xlsx'\n\ncases = json.load(open(cases_path,'r',encoding='utf-8'))\nwb = load_workbook(template)\nws = wb[wb.sheetnames[0]]\n\nheader_row = 6\nstart_row = 8\nmax_col = 11\n\n# clear old data area values only (keep style/merged structure)\nfor r in range(start_row, ws.max_row+1):\n    for c in range(1, max_col+1):\n        cell = ws.cell(r,c)\n        if isinstance(cell, MergedCell):\n            continue\n        cell.value = None\n\n# helper: clone row style when needing extra rows\nstyle_src_row = start_row\n\ndef clone_row_style(src, dst):\n    ws.row_dimensions[dst].height = ws.row_dimensions[src].height\n    for c in range(1, max_col+1):\n        s = ws.cell(src, c)\n        d = ws.cell(dst, c)\n        d._style = copy(s._style)\n        if s.has_style:\n            d.number_format = s.number_format\n            d.font = copy(s.font)\n            d.fill = copy(s.fill)\n            d.border = copy(s.border)\n            d.alignment = copy(s.alignment)\n            d.protection = copy(s.protection)\n\n# write cases in strict template columns\nfor i, case in enumerate(cases, start=0):\n    r = start_row + i\n    if r > ws.max_row:\n        ws.insert_rows(ws.max_row+1, 1)\n        clone_row_style(style_src_row, ws.max_row)\n    ws.cell(r,1).value = case.get('category') or 'コールバック予約'      # 大分類\n    ws.cell(r,2).value = f'=ROW()-7'                                     # No.\n    ws.cell(r,3).value = case.get('title','')                            # 小分類\n    ws.cell(r,4).value = case.get('steps','')                            # 確認手順\n    ws.cell(r,5).value = ''                                              # アカウント\n    ws.cell(r,6).value = case.get('precondition','')                     # テスト条件\n    ws.cell(r,7).value = case.get('expected','')                         # 想定結果\n    ws.cell(r,8).value = ''                                              # テスト結果\n    ws.cell(r,9).value = ''\n    ws.cell(r,10).value = ''\n    ws.cell(r,11).value = ''\n\nwb.save(out)\nprint(out)\nPY"},"partialJson":"{\"command\":\"python -X utf8 - << 'PY'\\nimport json\\nfrom copy import copy\\nfrom openpyxl import load_workbook\\nfrom openpyxl.cell.cell import MergedCell\\n\\ntemplate = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\inputs\\\\template\\\\template_latest.xlsx'\\ncases_path = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\runs\\\\run-20260306-1323\\\\cases.json'\\nout = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\runs\\\\run-20260306-1323\\\\unit_test_book_template_strict.xlsx'\\n\\ncases = json.load(open(cases_path,'r',encoding='utf-8'))\\nwb = load_workbook(template)\\nws = wb[wb.sheetnames[0]]\\n\\nheader_row = 6\\nstart_row = 8\\nmax_col = 11\\n\\n# clear old data area values only (keep style/merged structure)\\nfor r in range(start_row, ws.max_row+1):\\n    for c in range(1, max_col+1):\\n        cell = ws.cell(r,c)\\n        if isinstance(cell, MergedCell):\\n            continue\\n        cell.value = None\\n\\n# helper: clone row style when needing extra rows\\nstyle_src_row = start_row\\n\\ndef clone_row_style(src, dst):\\n    ws.row_dimensions[dst].height = ws.row_dimensions[src].height\\n    for c in range(1, max_col+1):\\n        s = ws.cell(src, c)\\n        d = ws.cell(dst, c)\\n        d._style = copy(s._style)\\n        if s.has_style:\\n            d.number_format = s.number_format\\n            d.font = copy(s.font)\\n            d.fill = copy(s.fill)\\n            d.border = copy(s.border)\\n            d.alignment = copy(s.alignment)\\n            d.protection = copy(s.protection)\\n\\n# write cases in strict template columns\\nfor i, case in enumerate(cases, start=0):\\n    r = start_row + i\\n    if r > ws.max_row:\\n        ws.insert_rows(ws.max_row+1, 1)\\n        clone_row_style(style_src_row, ws.max_row)\\n    ws.cell(r,1).value = case.get('category') or 'コールバック予約'      # 大分類\\n    ws.cell(r,2).value = f'=ROW()-7'                                     # No.\\n    ws.cell(r,3).value = case.get('title','')                            # 小分類\\n    ws.cell(r,4).value = case.get('steps','')                            # 確認手順\\n    ws.cell(r,5).value = ''                                              # アカウント\\n    ws.cell(r,6).value = case.get('precondition','')                     # テスト条件\\n    ws.cell(r,7).value = case.get('expected','')                         # 想定結果\\n    ws.cell(r,8).value = ''                                              # テスト結果\\n    ws.cell(r,9).value = ''\\n    ws.cell(r,10).value = ''\\n    ws.cell(r,11).value = ''\\n\\nwb.save(out)\\nprint(out)\\nPY\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":3722,"output":1174,"cacheRead":71552,"cacheWrite":0,"totalTokens":76448,"cost":{"input":0.0065135,"output":0.016436,"cacheRead":0.012521599999999999,"cacheWrite":0,"total":0.0354711}},"stopReason":"toolUse","timestamp":1772771053569}}
