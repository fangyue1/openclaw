 = r'C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\workspace\\runs\\run-20260306-1323\\cases.json'\n    out = r'C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\workspace\\runs\\run-20260306-1323\\unit_test_book_template_strict.xlsx'\n\n    cases = json.load(open(cases_path, 'r', encoding='utf-8'))\n    wb = load_workbook(template)\n    ws = wb[wb.sheetnames[0]]\n\n    start_row = 8\n    max_col = 11\n\n    # clear old values, keep style and merged layout\n    for r in range(start_row, ws.max_row + 1):\n        for c in range(1, max_col + 1):\n            cell = ws.cell(r, c)\n            if isinstance(cell, MergedCell):\n                continue\n            cell.value = None\n\n    style_src_row = start_row\n\n    def clone_row_style(src, dst):\n        ws.row_dimensions[dst].height = ws.row_dimensions[src].height\n        for c in range(1, max_col + 1):\n            s = ws.cell(src, c)\n            d = ws.cell(dst, c)\n            d._style = copy(s._style)\n            d.number_format = s.number_format\n            d.font = copy(s.font)\n            d.fill = copy(s.fill)\n            d.border = copy(s.border)\n            d.alignment = copy(s.alignment)\n            d.protection = copy(s.protection)\n\n    for i, case in enumerate(cases):\n        r = start_row + i\n        if r > ws.max_row:\n            ws.insert_rows(ws.max_row + 1, 1)\n            clone_row_style(style_src_row, ws.max_row)\n\n        ws.cell(r, 1).value = case.get('category') or 'コールバック予約'\n        ws.cell(r, 2).value = '=ROW()-7'\n        ws.cell(r, 3).value = case.get('title', '')\n        ws.cell(r, 4).value = case.get('steps', '')\n        ws.cell(r, 5).value = ''\n        ws.cell(r, 6).value = case.get('precondition', '')\n        ws.cell(r, 7).value = case.get('expected', '')\n        ws.cell(r, 8).value = ''\n        ws.cell(r, 9).value = ''\n        ws.cell(r, 10).value = ''\n        ws.cell(r, 11).value = ''\n\n    wb.save(out)\n    print(out)\n\n\nif __name__ == '__main__':\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\export_template_strict.py\",\"content\":\"import json\\nfrom copy import copy\\nfrom openpyxl import load_workbook\\nfrom openpyxl.cell.cell import MergedCell\\n\\n\\ndef main():\\n    template = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\inputs\\\\template\\\\template_latest.xlsx'\\n    cases_path = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\runs\\\\run-20260306-1323\\\\cases.json'\\n    out = r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\workspace\\\\runs\\\\run-20260306-1323\\\\unit_test_book_template_strict.xlsx'\\n\\n    cases = json.load(open(cases_path, 'r', encoding='utf-8'))\\n    wb = load_workbook(template)\\n    ws = wb[wb.sheetnames[0]]\\n\\n    start_row = 8\\n    max_col = 11\\n\\n    # clear old values, keep style and merged layout\\n    for r in range(start_row, ws.max_row + 1):\\n        for c in range(1, max_col + 1):\\n            cell = ws.cell(r, c)\\n            if isinstance(cell, MergedCell):\\n                continue\\n            cell.value = None\\n\\n    style_src_row = start_row\\n\\n    def clone_row_style(src, dst):\\n        ws.row_dimensions[dst].height = ws.row_dimensions[src].height\\n        for c in range(1, max_col + 1):\\n            s = ws.cell(src, c)\\n            d = ws.cell(dst, c)\\n            d._style = copy(s._style)\\n            d.number_format = s.number_format\\n            d.font = copy(s.font)\\n            d.fill = copy(s.fill)\\n            d.border = copy(s.border)\\n            d.alignment = copy(s.alignment)\\n            d.protection = copy(s.protection)\\n\\n    for i, case in enumerate(cases):\\n        r = start_row + i\\n        if r > ws.max_row:\\n            ws.insert_rows(ws.max_row + 1, 1)\\n            cl