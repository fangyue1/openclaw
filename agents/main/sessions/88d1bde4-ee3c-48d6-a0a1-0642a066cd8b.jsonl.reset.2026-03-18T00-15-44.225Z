etnames[:10]] }\")\n    for s in wb.sheetnames[:6]:\n        wsht = wb[s]\n        imgs = getattr(wsht, '_images', [])\n        print(\" -\", s.encode('unicode_escape').decode('ascii'), \"rows\", wsht.max_row, \"cols\", wsht.max_column, \"images\", len(imgs))\n\n# template header rows (first sheet)\nwt = load_workbook(template)\nst = wt[wt.sheetnames[0]]\nprint(\"\\n[TEMPLATE header sample rows 6-12]\")\nfor r in range(6,13):\n    vals=[st.cell(r,c).value for c in range(1,12)]\n    vals=[(\"\" if v is None else str(v)).replace(\"\\n\",\"\\\\n\") for v in vals]\n    print(r, [v.encode('unicode_escape').decode('ascii') for v in vals])\n\n# code zip inventory\nif codezip.exists():\n    with ZipFile(codezip,'r') as z:\n        names = z.namelist()\n    print(\"\\n[CODE ZIP] file count\", len(names))\n    # key files\n    key = [n for n in names if re.search(r\"(documentsResendFormConfirm|resend|confirm|lwc|apex|cls|js|html|xml)\", n, re.I)]\n    print(\"key sample:\")\n    for n in key[:40]:\n        print(\" -\", n)\n\n# existing design analysis if present\nanalysis = next((p for p in root.glob(\"*.analysis.json\") if \"調査書類発送受付フォーム画面設計書\" in p.name), None)\nprint(\"\\nDESIGN_ANALYSIS_JSON=\", analysis)\nif analysis and analysis.exists():\n    data=json.loads(analysis.read_text(encoding='utf-8'))\n    print(\"analysis keys\", list(data.keys())[:20])\n    fr=data.get('field_rules') or []\n    print(\"field_rules\", len(fr))\n    for x in fr[:5]:\n        print(\" - raw\", str(x.get('raw',''))[:120].encode('unicode_escape').decode('ascii'))\n'@; $tmp='C:\\Users\\吗喽\\.openclaw\\workspace\\tmp\\compare_triplet.py'; Set-Content -Path $tmp -Value $py -Encoding UTF8; python $tmp"},"partialJson":"{\"command\":\"$py = @'\\nfrom pathlib import Path\\nfrom zipfile import ZipFile\\nfrom openpyxl import load_workbook\\nimport json, re\\n\\nroot = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\")\\nws = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\")\\n\\n# locate files\\ncan