テスト仕様書' in p.name)\ncodezip=root/'documentsResendFormConfirm.zip'\n\n# helpers\njp_split=re.compile(r\"[\\s\\u3000\\n\\r\\t:：、。・（）()\\[\\]【】「」\\/\\\\\\-_,]+\")\nstop=set(['', 'を','に','の','は','が','で','と','する','こと','及び','または','また','ある','いる','こちら','右記','入力','確認','クリック'])\n\ndef tokens(s):\n    ts=[t for t in jp_split.split(str(s)) if t]\n    out=[]\n    for t in ts:\n        if t in stop: continue\n        if len(t)==1 and ord(t)<128: continue\n        out.append(t)\n    return out\n\n# template rows\nwb_t=load_workbook(template, data_only=False)\nws_t=wb_t[wb_t.sheetnames[0]]\ntrows=[]\nfor r in range(8, ws_t.max_row+1):\n    vals=[ws_t.cell(r,c).value for c in range(1,12)]\n    if not any(v not in (None,'') for v in vals):\n        continue\n    entry={\n        'row': r,\n        'major': vals[0] or '',\n        'no': vals[1] or '',\n        'minor': vals[2] or '',\n        'steps': vals[3] or '',\n        'cond': vals[5] or '',\n        'expected': vals[6] or '',\n    }\n    txt=' '.join(str(entry[k]) for k in ['major','minor','steps','cond','expected'])\n    entry['tokens']=tokens(txt)\n    trows.append(entry)\n\n# design lines from key sheets\nwb_d=load_workbook(design, data_only=True)\nkey_sheet_names=[s for s in wb_d.sheetnames if any(k in s for k in ['Step1','Step2','Step3','画面項目定義書','画面機能定義書','関連チェック仕様書'])]\nlines=[]\nfor s in key_sheet_names:\n    ws=wb_d[s]\n    for r in range(1, ws.max_row+1):\n        vals=[ws.cell(r,c).value for c in range(1, ws.max_column+1)]\n        vals=[str(v).strip() for v in vals if v not in (None,'')]\n        if not vals: continue\n        txt=' | '.join(vals)\n        tk=tokens(txt)\n        if len(tk)<2: continue\n        lines.append({'sheet':s,'row':r,'text':txt,'tokens':set(tk)})\n\n# code text\ncode_files=[]\nwith ZipFile(codezip,'r') as z:\n    for n in z.namelist():\n        if n.endswith('/'):\n            continue\n        if not re.search(r'\\.(js|html|css|xml)$', n, re.I):\n            continue\n        try:\n            txt=z.read(n).decode('utf-8','ignore')\n        except Exception:\n            txt=''\n        code_files.append({'path':n,'text':txt})\n\n# key code signals\nsignals=[]\nfor f in code_files:\n    txt=f['text']\n    for pat,label in [\n        (r'documentsResendForm(Input|Page|Confirm|Success)','component flow'),\n        (r'validation|error|required|check','validation logic'),\n        (r'navigate|NavigationMixin|window\\.location|dispatchEvent','navigation'),\n        (r'mail|email|send','notification/mail'),\n        (r'postal|zip|電話|メール|コード','field validation')\n    ]:\n        if re.search(pat, txt, re.I):\n            signals.append((f['path'],label))\n\n# match template row -> best design line by token overlap\nmatches=[]\nfor tr in trows:\n    tset=set(tr['tokens'])\n    best=None\n    for ln in lines:\n        ov=len(tset & ln['tokens'])\n        if ov==0:\n            continue\n        score=ov/(len(tset)+1)\n        if (best is None) or (score>best['score']):\n            best={'score':score,'sheet':ln['sheet'],'row':ln['row'],'text':ln['text'][:220],'overlap':ov}\n    matches.append({'template_row':tr['row'],'minor':str(tr['minor']),'steps':str(tr['steps'])[:120],'expected':str(tr['expected'])[:120],'match':best})\n\n# summary\nmatched=sum(1 for m in matches if m['match'] and m['match']['overlap']>=2)\nweak=sum(1 for m in matches if (not m['match']) or m['match']['overlap']<2)\n\n# Write report\nmd=[]\nmd.append('# 对齐差异报告 v1（设计书 × 代码 × 模板）')\nmd.append('')\nmd.append(f'- 设计书: `{design}`')\nmd.append(f'- 代码包: `{codezip}`')\nmd.append(f'- 模板: `{template}`')\nmd.append('')\nmd.append('## 1) 基线结构核对')\nmd.append(f'- 设计书 sheet 数: **{len(wb_d.sheetnames)}**（包含 Step1/Step2/Step3、画面項目定義書、画面機能定義書、関連チェック仕様書）')\nmd.append(f'- 模板 sheet 数: **{len(wb_t.sheetnames)}**（主表第6/7行为双层表头，第8行起为用例手順区）')\nmd.append(f'- 模板有效用例行: **{len(trows)}**')\nmd.append('')\nmd.append('## 2) 初步对齐结果（自动匹配）')\nmd.append(f'- 强匹配（重叠关键词>=2）: **{matched}** 行')\nmd.append(f'- 弱匹配/待人工确认: **{weak}** 行')\nmd.append('')\nmd.append('### 典型强匹配样例（前10条）')\ncount=0\nfor m in matches:\n    if m['match'] and m['match']['overlap']>=2:\n        md.append(f\"- 模板R{m['template_row']} `{m['steps']}` -> 设计 `{m['match']['sheet']}!R{m['match']['row']}` (overlap={m['match']['overlap']})\")\n        count+=1\n        if count>=10: break\nif count==0:\n    md.append('- 无（说明当前抽取策略不足）')\n\nmd.append('')\nmd.append('### 弱匹配样例（前10条）')\ncount=0\nfor m in matches:\n    if (not m['match']) or m['match']['overlap']<2:\n        md.append(f\"- 模板R{m['template_row']} `{m['steps']}` -> 未找到稳定映射\")\n        count+=1\n        if count>=10: break\n\nmd.append('')\nmd.append('## 3) 代码侧可验证信号')\nif signals:\n    uniq=[]\n    seen=set()\n    for p,l in signals:\n        k=(p,l)\n        if k in seen: continue\n        seen.add(k); uniq.append((p,l))\n    for p,l in uniq[:20]:\n        md.append(f'- `{p}`: {l}')\nelse:\n    md.append('- 暂无（需深入 AST 级解析）')\n\nmd.append('')\nmd.append('## 4) 发现的问题（导致你说“手順对不起来”的根因）')\nmd.append('- 当前导出器 `export_to_excel.py` 采用“从表头下一行连续写入”，会覆盖模板的既有手順区。')\nmd.append('- 生成器默认以字段校验case为中心（TC-0001...），而你的模板是“流程驱动（STEP1/2/3 + 異常系）”。')\nmd.append('- 设计书中的图片信息尚未并入对齐（当前仅做了结构核对，OCR映射未落地到行级）。')\n\nmd.append('')\nmd.append('## 5) 可实现性判断')\nmd.append('- 可以实现：模板优先的增量填充（保留原手順，不覆盖），并按设计书+代码补充缺失测试点。')\nmd.append('- 可部分自动：图片OCR与行级对应（精度受图片质量影响，需人工复核关键行）。')\nmd.append('- 需要你确认：最终是“严格保留模板原31行并仅补充新增行”，还是“允许对原有行的テスト条件/想定結果做精修”。')\n\nmd.append('')\nmd.append('## 6) 下一步执行计划（不生成，仅准备）')\nmd.append('1. 实现模板保护写入：锁定R8-R31不覆盖，只允许append到尾部。')\nmd.append('2. 构建“流程型用例生成器”：按 Step1/Step2/Step3 正常系、文言確認、異常系分组输出。')\nmd.append('3. 抽取代码中的校验消息/跳转条件，与设计书相关检查项做交叉验证。')\nmd.append('4. 先给你一版“映射矩阵.xlsx/markdown”审阅，通过后再正式生成单体测试书。')\n\nreport=outdir/'alignment_report_v1.md'\nreport.write_text('\\n'.join(md), encoding='utf-8')\njson_path=outdir/'alignment_matches.json'\njson_path.write_text(json.dumps(matches, ensure_ascii=False, indent=2), encoding='utf-8')\n\nprint('REPORT=' + str(report))\nprint('MATCHES=' + str(json_path))\n'@; $tmp='C:\\Users\\吗喽\\.openclaw\\workspace\\tmp\\make_alignment_report.py'; Set-Content -Path $tmp -Value $py -Encoding UTF8; python $tmp"},"partialJson":"{\"command\":\"$py = @'\\nfrom pathlib import Path\\nfrom openpyxl import load_workbook\\nfrom zipfile import ZipFile\\nimport re, json, datetime\\n\\nroot = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\")\\nworkspace = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\")\\noutdir = workspace / \\\"runs\\\" / (\\\"alignment-\\\" + datetime.datetime.now().strftime(\\\"%Y%m%d-%H%M%S\\\"))\\noutdir.mkdir(parents=True, exist_ok=True)\\n\\n# locate files\\nxlsxs=list(root.glob('*.xlsx'))\\ndesign=next(p for p in xlsxs if '調査書類発送受付フォーム画面設計書' in p.name)\\ntemplate=next(p for p in xlsxs if '紙の調査票送付受付フォーム' in p.name and '単体テスト仕様書' in p.name)\\ncodezip=root/'documentsResendFormConfirm.zip'\\n\\n# helpers\\njp_split=re.compile(r\\\"[\\\\s\\\\u3000\\\\n\\\\r\\\\t:：、。・（）()\\\\[\\\\]【】「」\\\\/\\\\\\\\\\\\-_,]+\\\")\\nstop=set(['', 'を','に','の','は','が','で','と','する','こと','及び','または','また','ある','いる','こちら','右記','入力','確認','クリック'])\\n\\ndef tokens(s):\\n    ts=[t for t in jp_split.split(str(s)) if t]\\n    out=[]\\n    for t in ts:\\n        if t in stop: continue\\n        if len(t)==1 and ord(t)<128: continue\\n        out.append(t)\\n    return out\\n\\n# template rows\\nwb_t=load_workbook(template, data_only=False)\\nws_t=wb_t[wb_t.sheetnames[0]]\\ntrows=[]\\nfor r in range(8, ws_t.max_row+1):\\n    vals=[ws_t.cell(r,c).value for c in range(1,12)]\\n    if not any(v not in (None,'') for v in vals):\\n        continue\\n    entry={\\n        'row': r,\\n        'major': vals[0] or '',\\n        'no': vals[1] or '',\\n        'minor': vals[2] or '',\\n        'steps': vals[3] or '',\\n        'cond': vals[5] or '',\\n        'expected': vals[6] or '',\\n    }\\n    txt=' '.join(str(entry[k]) for k in ['major','minor','steps','cond','expected'])\\n    entry['tokens']=tokens(txt)\\n    trows.append(entry)\\n\\n# design lines from key sheets\\nwb_d=load_workbook(design, data_only=True)\\nkey_sheet_names=[s for s in wb_d.sheetnames if any(k in s for k in ['Step1','Step2','Step3','画面項目定義書','画面機能定義書','関連チェック仕様書'])]\\nlines=[]\\nfor s in key_sheet_names:\\n    ws=wb_d[s]\\n    for r in range(1, ws.max_row+1):\\n        vals=[ws.cell(r,c).value for c in range(1, ws.max_column+1)]\\n        vals=[str(v).strip() for v in vals if v not in (None,'')]\\n        if not vals: continue\\n        txt=' | '.join(vals)\\n        tk=tokens(txt)\\n        if len(tk)<2: continue\\n        lines.append({'sheet':s,'row':r,'text':txt,'tokens':set(tk)})\\n\\n# code text\\ncode_files=[]\\nwith ZipFile(codezip,'r') as z:\\n    for n in z.namelist():\\n        if n.endswith('/'):\\n            continue\\n        if not re.search(r'\\\\.(js|html|css|xml)$', n, re.I):\\n            continue\\n        try:\\n            txt=z.read(n).decode('utf-8','ignore')\\n        except Exception:\\n            txt=''\\n        code_files.append({'path':n,'text':txt})\\n\\n# key code signals\\nsignals=[]\\nfor f in code_files:\\n    txt=f['text']\\n    for pat,label in [\\n        (r'documentsResendForm(Input|Page|Confirm|Success)','component flow'),\\n        (r'validation|error|required|check','validation logic'),\\n        (r'navigate|NavigationMixin|window\\\\.location|dispatchEvent','navigation'),\\n        (r'mail|email|send','notification/mail'),\\n        (r'postal|zip|電話|メール|コード','field validation')\\n    ]:\\n        if re.search(pat, txt, re.I):\\n            signals.append((f['path'],label))\\n\\n# match template row -> best design line by token overlap\\nmatches=[]\\nfor tr in trows:\\n    tset=set(tr['tokens'])\\n    best=None\\n    for ln in lines:\\n        ov=len(tset & ln['tokens'])\\n        if ov==0:\\n            continue\\n        score=ov/(len(tset)+1)\\n        if (best is None) or (score>best['score']):\\n            best={'score':score,'sheet':ln['sheet'],'row':ln['row'],'text':ln['text'][:220],'overlap':ov}\\n    matches.append({'template_row':tr['row'],'minor':str(tr['minor']),'steps':str(tr['steps'])[:120],'expected':str(tr['expected'])[:120],'match':best})\\n\\n# summary\\nmatched=sum(1 for m in matches if m['match'] and m['match']['overlap']>=2)\\nweak=sum(1 for m in matches if (not m['match']) or m['match']['overlap']<2)\\n\\n# Write report\\nmd=[]\\nmd.append('# 对齐差异报告 v1（设计书 × 代码 × 模板）')\\nmd.append('')\\nmd.append(f'- 设计书: `{design}`')\\nmd.append(f'- 代码包: `{codezip}`')\\nmd.append(f'- 模板: `{template}`')\\nmd.append('')\\nmd.append('## 1) 基线结构核对')\\nmd.append(f'- 设计书 sheet 数: **{len(wb_d.sheetnames)}**（包含 Step1/Step2/Step3、画面項目定義書、画面機能定義書、関連チェック仕様書）')\\nmd.append(f'- 模板 sheet 数: **{len(wb_t.sheetnames)}**（主表第6/7行为双层表头，第8行起为用例手順区）')\\nmd.append(f'- 模板有效用例行: **{len(trows)}**')\\nmd.append('')\\nmd.append('## 2) 初步对齐结果（自动匹配）')\\nmd.append(f'- 强匹配（重叠关键词>=2）: **{matched}** 行')\\nmd.append(f'- 弱匹配/待人工确认: **{weak}** 行')\\nmd.append('')\\nmd.append('### 典型强匹配样例（前10条）')\\ncount=0\\nfor m in matches:\\n    if m['match'] and m['match']['overlap']>=2:\\n        md.append(f\\\"- 模板R{m['template_row']} `{m['steps']}` -> 设计 `{m['match']['sheet']}!R{m['match']['row']}` (overlap={m['match']['overlap']})\\\")\\n        count+=1\\n        if count>=10: break\\nif count==0:\\n    md.append('- 无（说明当前抽取策略不足）')\\n\\nmd.append('')\\nmd.append('### 弱匹配样例（前10条）')\\ncount=0\\nfor m in matches:\\n    if (not m['match']) or m['match']['overlap']<2:\\n        md.append(f\\\"- 模板R{m['template_row']} `{m['steps']}` -> 未找到稳定映射\\\")\\n        count+=1\\n        if count>=10: break\\n\\nmd.append('')\\nmd.append('## 3) 代码侧可验证信号')\\nif signals:\\n    uniq=[]\\n    seen=set()\\n    for p,l in signals:\\n        k=(p,l)\\n        if k in seen: continue\\n        seen.add(k); uniq.append((p,l))\\n    for p,l in uniq[:20]:\\n        md.append(f'- `{p}`: {l}')\\nelse:\\n    md.append('- 暂无（需深入 AST 级解析）')\\n\\nmd.append('')\\nmd.append('## 4) 发现的问题（导致你说“手順对不起来”的根因）')\\nmd.append('- 当前导出器 `export_to_excel.py` 采用“从表头下一行连续写入”，会覆盖模板的既有手順区。')\\nmd.append('- 生成器默认以字段校验case为中心（TC-0001...），而你的模板是“流程驱动（STEP1/2/3 + 異常系）”。')\\nmd.append('- 设计书中的图片信息尚未并入对齐（当前仅做了结构核对，OCR映射未落地到行级）。')\\n\\nmd.append('')\\nmd.append('## 5) 可实现性判断')\\nmd.append('- 可以实现：模板优先的增量填充（保留原手順，不覆盖），并按设计书+代码补充缺失测试点。')\\nmd.append('- 可部分自动：图片OCR与行级对应（精度受图片质量影响，需人工复核关键行）。')\\nmd.append('- 需要你确认：最终是“严格保留模板原31行并仅补充新增行”，还是“允许对原有行的テスト条件/想定結果做精修”。')\\n\\nmd.append('')\\nmd.append('## 6) 下一步执行计划（不生成，仅准备）')\\nmd.append('1. 实现模板保护写入：锁定R8-R31不覆盖，只允许append到尾部。')\\nmd.append('2. 构建“流程型用例生成器”：按 Step1/Step2/Step3 正常系、文言確認、異常系分组输出。')\\nmd.append('3. 抽取代码中的校验消息/跳转条件，与设计书相关检查项做交叉验证。')\\nmd.append('4. 先给你一版“映射矩阵.xlsx/markdown”审阅，通过后再正式生成单体测试书。')\\n\\nreport=outdir/'alignment_report_v1.md'\\nreport.write_text('\\\\n'.join(md), encoding='utf-8')\\njson_path=outdir/'alignment_matches.json'\\njson_path.write_text(json.dumps(matches, ensure_ascii=False, indent=2), encoding='utf-8')\\n\\nprint('REPORT=' + str(report))\\nprint('MATCHES=' + str(json_path))\\n'@; $tmp='C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\tmp\\\\make_alignment_report.py'; Set-Content -Path $tmp -Value $py -Encoding UTF8; python $tmp\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":1132,"output":2885,"cacheRead":49920,"cacheWrite":0,"totalTokens":53937,"cost":{"input":0.001981,"output":0.04039,"cacheRead":0.008735999999999999,"cacheWrite":0,"total":0.05110700000000001}},"stopReason":"toolUse","timestamp":1773721828414}}
