tParser(\n        description=\"Unified pipeline entry for web-unit-testbook\"\n    )\n    ap.add_argument(\"--design\", required=True, help=\"Design workbook (.xlsx)\")\n    ap.add_argument(\"--code\", help=\"Code folder or zip (required for high-precision mode)\")\n    ap.add_argument(\n        \"--template\",\n        default=str(workspace_root / \"samples\" / \"template\" / \"template_v3_confirmed.xlsx\"),\n        help=\"Unit test book template (.xlsx)\",\n    )\n    ap.add_argument(\"--outdir\", required=True, help=\"Output directory\")\n    ap.add_argument(\"--ocr-lang\", default=\"\", help=\"Optional OCR language (e.g. jpn+eng)\")\n    ap.add_argument(\n        \"--mode\",\n        choices=[\"high-precision\", \"ui-only\"],\n        default=\"high-precision\",\n        help=\"Generation mode\",\n    )\n    args = ap.parse_args()\n\n    if args.mode == \"high-precision\" and not args.code:\n        ap.error(\"--code is required when --mode high-precision\")\n\n    outdir = Path(args.outdir)\n    outdir.mkdir(parents=True, exist_ok=True)\n\n    design_json = outdir / \"design_rules.json\"\n    code_json = outdir / \"code_rules.json\"\n    cases_json = outdir / \"cases.json\"\n    md = outdir / \"UnitTestSpec.md\"\n    xlsx = outdir / \"unit_test_book.xlsx\"\n\n    cmd1 = [\n        \"python\",\n        str(skill_dir / \"scripts\" / \"parse_design_excel.py\"),\n        \"--input\",\n        args.design,\n        \"--out\",\n        str(design_json),\n    ]\n    if args.ocr_lang:\n        cmd1 += [\"--ocr-lang\", args.ocr_lang]\n\n    run(cmd1)\n\n    if args.mode == \"high-precision\":\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"extract_code_rules.py\"),\n            \"--src\",\n            args.code,\n            \"--out\",\n            str(code_json),\n        ])\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"generate_high_precision.py\"),\n            \"--design\",\n            str(design_json),\n            \"--code\",\n            str(code_json),\n            \"--out-md\",\n            str(md),\n            \"--out-cases\",\n            str(cases_json),\n        ])\n    else:\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"generate_ui_only_cases.py\"),\n            \"--design\",\n            str(design_json),\n            \"--out-md\",\n            str(md),\n            \"--out-cases\",\n            str(cases_json),\n        ])\n\n    run([\n        \"python\",\n        str(skill_dir / \"scripts\" / \"export_to_excel.py\"),\n        \"--template\",\n        args.template,\n        \"--cases\",\n        str(cases_json),\n        \"--out\",\n        str(xlsx),\n    ])\n\n    print(f\"Done. Mode={args.mode}. Outputs in: {outdir}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\run_pipeline.py\",\"content\":\"import argparse\\nimport subprocess\\nfrom pathlib import Path\\n\\n\\ndef run(cmd):\\n    print(\\\"[RUN]\\\", \\\" \\\".join(cmd))\\n    subprocess.check_call(cmd)\\n\\n\\ndef main():\\n    skill_dir = Path(__file__).resolve().parents[1]\\n    workspace_root = Path(__file__).resolve().parents[3]\\n\\n    ap = argparse.ArgumentParser(\\n        description=\\\"Unified pipeline entry for web-unit-testbook\\\"\\n    )\\n    ap.add_argument(\\\"--design\\\", required=True, help=\\\"Design workbook (.xlsx)\\\")\\n    ap.add_argument(\\\"--code\\\", help=\\\"Code folder or zip (required for high-precision mode)\\\")\\n    ap.add_argument(\\n        \\\"--template\\\",\\n        default=str(workspace_root / \\\"samples\\\" / \\\"template\\\" / \\\"template_v3_confirmed.xlsx\\\"),\\n        help=\\\"Unit test book template (.xlsx)\\\",\\n    )\\n    ap.add_argument(\\\"--outdir\\\", required=True, help=\\\"Output directory\\\")\\n    ap.add_argument(\\\"--ocr-lang\\\", default=\\\"\\\"