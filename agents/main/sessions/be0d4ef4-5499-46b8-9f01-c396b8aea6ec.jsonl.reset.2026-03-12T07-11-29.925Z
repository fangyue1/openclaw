n- `main` → 皇上中枢\n- `taizi` → 太子（飞书总入口）\n- `zhongshu` → 中书省（群专用）\n\n这样 UI 就不会“撞名看起来重复”。","textSignature":"{\"v\":1,\"id\":\"msg_03f23d80dd1defdd0169b181f2e6c88191890d31e453693575\",\"phase\":\"final_answer\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":53845,"output":253,"cacheRead":2560,"cacheWrite":0,"totalTokens":56658,"cost":{"input":0.09422875,"output":0.003542,"cacheRead":0.000448,"cacheWrite":0,"total":0.09821875000000001}},"stopReason":"stop","timestamp":1773240814882}}
