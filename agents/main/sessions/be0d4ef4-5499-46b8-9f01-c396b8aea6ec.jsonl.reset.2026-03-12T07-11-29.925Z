n $null -ne $conn\n}\n\nif (Test-PortListening -P $Port) {\n  Write-Output \"RUNNING http://127.0.0.1:$Port\"\n  exit 0\n}\n\nif ($CheckOnly) {\n  Write-Output \"STOPPED\"\n  exit 1\n}\n\nif (-not (Test-Path $RepoPath)) {\n  Write-Output \"ERROR RepoNotFound: $RepoPath\"\n  exit 2\n}\n\n$python = \"python\"\n$serverScript = Join-Path $RepoPath \"dashboard/server.py\"\nif (-not (Test-Path $serverScript)) {\n  Write-Output \"ERROR ServerScriptNotFound: $serverScript\"\n  exit 3\n}\n\nStart-Process -FilePath $python -ArgumentList \"dashboard/server.py\" -WorkingDirectory $RepoPath -WindowStyle Hidden | Out-Null\n\nStart-Sleep -Milliseconds 1200\n\nif (Test-PortListening -P $Port) {\n  Write-Output \"STARTED http://127.0.0.1:$Port\"\n  exit 0\n}\n\nWrite-Output \"ERROR StartFailed: port $Port not listening\"\nexit 4\n","new_string":"param(\n  [string]$RepoPath = \"C:\\Users\\吗喽\\.openclaw\\workspace\\edict\",\n  [int]$Port = 7891,\n  [switch]$CheckOnly,\n  [switch]$AutoFallbackPort\n)\n\n$ErrorActionPreference = 'Stop'\n\nfunction Test-PortListening {\n  param([int]$P)\n  $conn = Get-NetTCPConnection -State Listen -LocalPort $P -ErrorAction SilentlyContinue | Select-Object -First 1\n  return $null -ne $conn\n}\n\nfunction Find-FreePort {\n  param([int[]]$Candidates)\n  foreach ($p in $Candidates) {\n    if (-not (Test-PortListening -P $p)) { return $p }\n  }\n  return $null\n}\n\nif (Test-PortListening -P $Port) {\n  Write-Output \"RUNNING http://127.0.0.1:$Port\"\n  exit 0\n}\n\nif ($CheckOnly) {\n  Write-Output \"STOPPED\"\n  exit 1\n}\n\nif (-not (Test-Path $RepoPath)) {\n  Write-Output \"ERROR RepoNotFound: $RepoPath\"\n  exit 2\n}\n\n$python = \"python\"\n$serverScript = Join-Path $RepoPath \"dashboard/server.py\"\nif (-not (Test-Path $serverScript)) {\n  Write-Output \"ERROR ServerScriptNotFound: $serverScript\"\n  exit 3\n}\n\n$targetPort = $Port\nif ($AutoFallbackPort) {\n  $targetPort = Find-FreePort -Candidates @($Port,7892,7893,7894,7895,7901,7902,7903,7911)\