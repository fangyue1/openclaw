_016cd7ee94e7b1620169a980d065788191a37a2f01645ebcc8","name":"write","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace\\edict\\scripts\\run_loop.ps1","content":"param(\n  [int]$IntervalSec = 15,\n  [int]$ScanIntervalSec = 120\n)\n\n$ErrorActionPreference = 'Continue'\n$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path\n$RepoRoot = Split-Path -Parent $ScriptDir\n$Python = \"$env:LocalAppData\\Programs\\Python\\Python311\\python.exe\"\n$LogPath = Join-Path $env:TEMP 'sansheng_liubu_refresh.log'\n$PidPath = Join-Path $env:TEMP 'sansheng_liubu_refresh.pid'\n\nif (Test-Path $PidPath) {\n  $oldPid = Get-Content $PidPath -ErrorAction SilentlyContinue\n  if ($oldPid -and (Get-Process -Id $oldPid -ErrorAction SilentlyContinue)) {\n    Write-Host \"❌ 已有 run_loop.ps1 在运行 (PID=$oldPid)\"\n    exit 1\n  }\n  Remove-Item $PidPath -Force -ErrorAction SilentlyContinue\n}\n\n$PID | Set-Content $PidPath -Encoding UTF8\n\nWrite-Host \"🏛️ 三省六部刷新循环已启动 PID=$PID\"\nWrite-Host \"日志: $LogPath\"\n\n$scanCounter = 0\n\ntry {\n  while ($true) {\n    & $Python -X utf8 (Join-Path $ScriptDir 'sync_from_openclaw_runtime.py') *>> $LogPath\n    & $Python -X utf8 (Join-Path $ScriptDir 'sync_agent_config.py') *>> $LogPath\n    & $Python -X utf8 (Join-Path $ScriptDir 'apply_model_changes.py') *>> $LogPath\n    & $Python -X utf8 (Join-Path $ScriptDir 'sync_officials_stats.py') *>> $LogPath\n    & $Python -X utf8 (Join-Path $ScriptDir 'refresh_live_data.py') *>> $LogPath\n\n    $scanCounter += $IntervalSec\n    if ($scanCounter -ge $ScanIntervalSec) {\n      $scanCounter = 0\n      try {\n        Invoke-RestMethod -Uri 'http://127.0.0.1:7891/api/scheduler-scan' -Method Post -ContentType 'application/json' -Body '{\"thresholdSec\":180}' | Out-Null\n      } catch {}\n    }\n\n    Start-Sleep -Seconds $IntervalSec\n  }\n}\nfinally {\n  Remove-Item $PidPath -Force -ErrorAction SilentlyContinue\n}\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\edict\\\\