1919d1179ea1576fdc6","name":"read","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\\scripts\\parse_design_excel.py"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\\\scripts\\\\parse_design_excel.py\"}"},{"type":"toolCall","id":"call_OlJh6lRSy0htXcJXGMW424fA|fc_016cd7ee94e7b1620169a987eed31481919f505411e144c000","name":"read","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\\scripts\\extract_code_rules.py"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\\\scripts\\\\extract_code_rules.py\"}"},{"type":"toolCall","id":"call_NnBPnMxEGJxQaT1TPnWwhpoh|fc_016cd7ee94e7b1620169a987eed32081918091355ce8a9b8b1","name":"read","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\\scripts\\generate_high_precision.py"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\\\scripts\\\\generate_high_precision.py\"}"},{"type":"toolCall","id":"call_2gB3vdalrPJo7gl5FK1Pai28|fc_016cd7ee94e7b1620169a987eed32c8191b9d22c66a18ad11b","name":"read","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\\scripts\\export_to_excel.py"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\\\scripts\\\\export_to_excel.py\"}"},{"type":"toolCall","id":"call_vFT0df9pbWUZNPjEIWod76qx|fc_016cd7ee94e7b1620169a987eed334819195fb80a3143b4328","name":"read","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\\scripts\\run_pipeline.py"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\\\scripts\\\\run_pipeline.py\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":1087,"output":326,"cacheRead":89600,"cacheWrite":0,"totalTokens":91013,"cost":{"input":0.00190225,"output":0.004564,"cacheRead":0.01568,"cacheWrite":0,"total":0.02214625}},"stopReason":"toolUse","timestamp":1772718051892}}
{"type":"message","id":"e8bd3271","parentId":"2451e86b","timestamp":"2026-03-05T13:41:03.110Z","message":{"role":"toolResult","toolCallId":"call_Jzvgutt7C2v67Amww06q6CiM|fc_016cd7ee94e7b1620169a987eed2fc81919d1179ea1576fdc6","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nimport re\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nfrom openpyxl import load_workbook\n\ntry:\n    import pytesseract\n    from PIL import Image\nexcept Exception:\n    pytesseract = None\n    Image = None\n\n\ndef is_red(rgb: str) -> bool:\n    if not rgb:\n        return False\n    rgb = rgb.upper().replace(\"#\", \"\")\n    if len(rgb) == 8:\n        rgb = rgb[2:]\n    return rgb.startswith(\"FF\") and rgb.endswith(\"0000\")\n\n\ndef extract_check_rules(text: str):\n    if not text:\n        return []\n    patterns = [\n        (\"required\", r\"必填|必須|required\"),\n        (\"range\", r\"\\d+\\s*~\\s*\\d+\"),\n        (\"maxmin\", r\"最大\\d+|最小\\d+|max\\s*\\d+|min\\s*\\d+\"),\n        (\"email\", r\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\"),\n    ]\n    return [name for name, pattern in patterns if re.search(pattern, text, flags=re.IGNORECASE)]\n\n\ndef extract_embedded_images(xlsx_path: Path, media_dir: Path):\n    media_dir.mkdir(parents=True, exist_ok=True)\n    extracted = []\n    with ZipFile(xlsx_path, \"r\") as zf:\n        for name in zf.namelist():\n            if name.startswith(\"xl/media/\"):\n                out = media_dir / Path(name).name\n                out.write_bytes(zf.read(name))\n                extracted.append(out)\n    return extracted\n\n\ndef run_ocr(image_paths, lang):\n    if not pytesseract or not Image:\n        return []\n    results = []\n    for i, p in enumerate(image_paths, start=1):\n        try:\n            txt = pytesseract.image_to_string(Image.open(p), lang=lang)\n            results.append({\"image_index\": i, \"image\": str(p), \"text\": txt.strip()})\n        except Exception as e:\n            results.append({\"image_index\": i, \"image\": str(p), \"error\": str(e)})\n    return results\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--input\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--ocr-lang\", default=\"\")\n    args = ap.parse_args()\n\n    xlsx = Path(args.input)\n    wb = load_workbook(xlsx, data_only=True)\n\n    fields = []\n    for ws in wb.worksheets:\n        for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n            values = [c.value for c in row]\n            joined = \" | \".join([str(v) for v in values if v is not None])\n            if not joined.strip():\n                continue\n\n            api_candidates = re.findall(r\"[a-zA-Z_][a-zA-Z0-9_]*(?:__c|__r)?\", joined)\n            required = False\n            cell_refs = []\n            for c in row:\n                if c.value is None:\n                    continue\n                cell_refs.append(c.coordinate)\n                color = None\n                try:\n                    color = c.fill.start_color.rgb or c.font.color.rgb\n                except Exception:\n                    pass\n                if color and is_red(color):\n                    required = True\n\n            fields.append(\n                {\n                    \"sheet\": ws.title,\n                    \"cells\": cell_refs,\n                    \"raw\": joined,\n                    \"api_names\": sorted(set(api_candidates))[:10],\n                    \"required_hint\": required,\n                    \"check_patterns\": extract_check_rules(joined),\n                }\n            )\n\n    media_dir = xlsx.parent / \"_media\"\n    images = extract_embedded_images(xlsx, media_dir)\n    ocr = run_ocr(images, args.ocr_lang) if args.ocr_lang else []\n\n    result = {\n        \"source\": str(xlsx),\n        \"sheet_count\": len(wb.worksheets),\n        \"field_rules\": fields,\n        \"embedded_images\": [str(p) for p in images],\n        \"ocr\": ocr,\n    }\n\n    Path(args.out).write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1772718063109}}
{"type":"message","id":"c9415e28","parentId":"e8bd3271","timestamp":"2026-03-05T13:41:03.119Z","message":{"role":"toolResult","toolCallId":"call_OlJh6lRSy0htXcJXGMW424fA|fc_016cd7ee94e7b1620169a987eed31481919f505411e144c000","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nimport re\nimport zipfile\nfrom pathlib import Path\n\n\nCODE_EXTS = {\".js\", \".ts\", \".html\", \".cls\", \".apex\"}\n\n\ndef collect_files(src: Path):\n    if src.is_file() and src.suffix.lower() == \".zip\":\n        temp = src.parent / \"_code_unzip\"\n        temp.mkdir(exist_ok=True)\n        with zipfile.ZipFile(src, \"r\") as zf:\n            zf.extractall(temp)\n        base = temp\n    else:\n        base = src\n    return [p for p in base.rglob(\"*\") if p.suffix.lower() in CODE_EXTS]\n\n\ndef parse_js_ts(text: str):\n    branches = re.findall(r\"\\bif\\s*\\(([^)]*)\\)|\\bswitch\\s*\\(([^)]*)\\)\", text)\n    wire_methods = re.findall(r\"@wire\\s*\\(([^)]+)\\)\", text)\n    methods = re.findall(r\"\\n\\s*(?:async\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{\", text)\n    return {\n        \"method_names\": sorted(set(methods)),\n        \"branch_conditions\": [a or b for a, b in branches if (a or b)],\n        \"wire_bindings\": [w.strip() for w in wire_methods],\n    }\n\n\ndef parse_apex(text: str):\n    methods = re.findall(\n        r\"(?:public|private|global|protected)\\s+(?:static\\s+)?(?:[A-Za-z_][A-Za-z0-9_<>,.]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    dml = re.findall(r\"\\b(insert|update|upsert|delete|merge|undelete)\\b\", text, flags=re.IGNORECASE)\n    exceptions = re.findall(r\"\\bthrow\\b|\\btry\\b|\\bcatch\\b|AuraHandledException|Exception\", text)\n\n    return {\n        \"method_names\": sorted(set([m[0] for m in methods])),\n        \"dml_ops\": [x.lower() for x in dml],\n        \"exception_paths\": len(exceptions),\n    }\n\n\ndef parse_text(path: Path, text: str):\n    ext = path.suffix.lower()\n    base = {\n        \"branch_count\": len(re.findall(r\"\\bif\\b|\\belse\\b|\\bswitch\\b\", text)),\n        \"wire_bindings\": [],\n        \"dml_ops\": [],\n        \"exception_paths\": 0,\n        \"method_names\": [],\n        \"branch_conditions\": [],\n    }\n\n    if ext in {\".js\", \".ts\"}:\n        js = parse_js_ts(text)\n        base.update(\n            {\n                \"wire_bindings\": js[\"wire_bindings\"],\n                \"method_names\": js[\"method_names\"],\n                \"branch_conditions\": js[\"branch_conditions\"],\n            }\n        )\n    elif ext in {\".cls\", \".apex\"}:\n        apex = parse_apex(text)\n        base.update(\n            {\n                \"dml_ops\": apex[\"dml_ops\"],\n                \"exception_paths\": apex[\"exception_paths\"],\n                \"method_names\": apex[\"method_names\"],\n            }\n        )\n\n    return base\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--src\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    src = Path(args.src)\n    files = collect_files(src)\n\n    rules = []\n    totals = {\"branches\": 0, \"wires\": 0, \"dml\": 0, \"exceptions\": 0, \"methods\": 0}\n    for f in files:\n        text = f.read_text(encoding=\"utf-8\", errors=\"ignore\")\n        parsed = parse_text(f, text)\n        totals[\"branches\"] += parsed[\"branch_count\"]\n        totals[\"wires\"] += len(parsed[\"wire_bindings\"])\n        totals[\"dml\"] += len(parsed[\"dml_ops\"])\n        totals[\"exceptions\"] += parsed[\"exception_paths\"]\n        totals[\"methods\"] += len(parsed[\"method_names\"])\n        rules.append({\"file\": str(f), **parsed})\n\n    out = {\"source\": str(src), \"files\": rules, \"summary\": totals}\n    Path(args.out).write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1772718063118}}
{"type":"message","id":"c2cb3ce6","parentId":"c9415e28","timestamp":"2026-03-05T13:41:03.125Z","message":{"role":"toolResult","toolCallId":"call_NnBPnMxEGJxQaT1TPnWwhpoh|fc_016cd7ee94e7b1620169a987eed32081918091355ce8a9b8b1","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nfrom pathlib import Path\n\n\ndef build_cases(design, code):\n    cases = []\n    idx = 1\n\n    for f in design.get(\"field_rules\", [])[:300]:\n        api = (f.get(\"api_names\") or [\"N/A\"])[0]\n        required = f.get(\"required_hint\", False)\n        checks = f.get(\"check_patterns\", [])\n\n        cases.append(\n            {\n                \"case_id\": f\"TC-{idx:04d}\",\n                \"category\": \"字段校验\",\n                \"title\": f\"{api} 正常输入\",\n                \"precondition\": \"页面可访问，用户已登录\",\n                \"steps\": f\"输入 {api} 的合法值并提交\",\n                \"expected\": \"提交成功，数据保存正确\",\n                \"priority\": \"P1\" if required else \"P2\",\n            }\n        )\n        idx += 1\n\n        if required:\n            cases.append(\n                {\n                    \"case_id\": f\"TC-{idx:04d}\",\n                    \"category\": \"异常校验\",\n                    \"title\": f\"{api} 必填校验\",\n                    \"precondition\": \"页面可访问\",\n                    \"steps\": f\"清空 {api} 后提交\",\n                    \"expected\": \"出现必填错误提示，无法提交\",\n                    \"priority\": \"P1\",\n                }\n            )\n            idx += 1\n\n        if checks:\n            cases.append(\n                {\n                    \"case_id\": f\"TC-{idx:04d}\",\n                    \"category\": \"边界校验\",\n                    \"title\": f\"{api} 规则边界\",\n                    \"precondition\": \"页面可访问\",\n                    \"steps\": f\"按规则 {checks[0]} 构造边界值并提交\",\n                    \"expected\": \"边界行为符合设计说明\",\n                    \"priority\": \"P2\",\n                }\n            )\n            idx += 1\n\n    summary = code.get(\"summary\", {})\n    for _ in range(summary.get(\"branches\", 0)):\n        cases.append(\n            {\n                \"case_id\": f\"TC-{idx:04d}\",\n                \"category\": \"逻辑分支\",\n                \"title\": \"代码分支覆盖\",\n                \"precondition\": \"构造分支输入条件\",\n                \"steps\": \"触发 if/else 或 switch 分支\",\n                \"expected\": \"分支结果与预期一致\",\n                \"priority\": \"P1\",\n            }\n        )\n        idx += 1\n\n    return cases\n\n\ndef to_markdown(cases):\n    lines = [\"# Unit Test Spec (High Precision)\", \"\", \"| CaseID | Category | Title | Expected |\", \"|---|---|---|---|\"]\n    for c in cases:\n        lines.append(f\"| {c['case_id']} | {c['category']} | {c['title']} | {c['expected']} |\")\n    return \"\\n\".join(lines)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--out-md\", required=True)\n    ap.add_argument(\"--out-cases\", required=True)\n    args = ap.parse_args()\n\n    design = json.loads(Path(args.design).read_text(encoding=\"utf-8\"))\n    code = json.loads(Path(args.code).read_text(encoding=\"utf-8\"))\n\n    cases = build_cases(design, code)\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    Path(args.out_md).write_text(to_markdown(cases), encoding=\"utf-8\")\n\n    print(f\"Wrote {args.out_cases} and {args.out_md}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1772718063124}}
{"type":"message","id":"9fe8b421","parentId":"c2cb3ce6","timestamp":"2026-03-05T13:41:03.157Z","message":{"role":"toolResult","toolCallId":"call_2gB3vdalrPJo7gl5FK1Pai28|fc_016cd7ee94e7b1620169a987eed32c8191b9d22c66a18ad11b","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nfrom pathlib import Path\n\nfrom openpyxl import load_workbook\n\n\nHEADER_KEYWORDS = {\n    \"case_id\": [\"case\", \"caseid\", \"编号\", \"id\", \"No\"],\n    \"category\": [\"category\", \"分類\", \"分类\", \"大分類\"],\n    \"title\": [\"title\", \"标题\", \"試験項目\", \"测试项\", \"小分類\"],\n    \"precondition\": [\"precondition\", \"前提\", \"前置\", \"テスト条件\"],\n    \"steps\": [\"steps\", \"手順\", \"步骤\", \"確認手順\"],\n    \"expected\": [\"expected\", \"期待\", \"预期\", \"想定結果\"],\n    \"priority\": [\"priority\", \"优先\", \"優先\"],\n}\n\nFALLBACK_ORDER = [\"case_id\", \"category\", \"title\", \"precondition\", \"steps\", \"expected\", \"priority\"]\n\n\ndef normalize(v):\n    return str(v or \"\").strip().lower().replace(\" \", \"\")\n\n\ndef detect_columns(ws):\n    best_row, best_cols = 1, {}\n    for row in ws.iter_rows(min_row=1, max_row=min(30, ws.max_row)):\n        cols = {}\n        for c in row:\n            nv = normalize(c.value)\n            for key, kws in HEADER_KEYWORDS.items():\n                if key in cols:\n                    continue\n                if any(normalize(k) in nv for k in kws):\n                    cols[key] = c.column\n        if len(cols) > len(best_cols):\n            best_cols = cols\n            best_row = row[0].row\n    return best_cols, best_row\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--template\", required=True)\n    ap.add_argument(\"--cases\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    cases = json.loads(Path(args.cases).read_text(encoding=\"utf-8\"))\n    wb = load_workbook(args.template)\n    ws = wb.active\n\n    cols, header_row = detect_columns(ws)\n    if not cols:\n        cols = {k: i + 1 for i, k in enumerate(FALLBACK_ORDER)}\n        header_row = 1\n        for k, col in cols.items():\n            ws.cell(row=1, column=col, value=k)\n\n    start_row = header_row + 1\n    for i, case in enumerate(cases, start=start_row):\n        for key, col in cols.items():\n            ws.cell(row=i, column=col, value=case.get(key, \"\"))\n\n    wb.save(args.out)\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1772718063154}}
{"type":"message","id":"f724b1be","parentId":"9fe8b421","timestamp":"2026-03-05T13:41:03.166Z","message":{"role":"toolResult","toolCallId":"call_vFT0df9pbWUZNPjEIWod76qx|fc_016cd7ee94e7b1620169a987eed334819195fb80a3143b4328","toolName":"read","content":[{"type":"text","text":"import argparse\nimport subprocess\nfrom pathlib import Path\n\n\ndef run(cmd):\n    print(\"[RUN]\", \" \".join(cmd))\n    subprocess.check_call(cmd)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--template\", required=True)\n    ap.add_argument(\"--outdir\", required=True)\n    ap.add_argument(\"--ocr-lang\", default=\"\")\n    args = ap.parse_args()\n\n    outdir = Path(args.outdir)\n    outdir.mkdir(parents=True, exist_ok=True)\n\n    design_json = outdir / \"design_rules.json\"\n    code_json = outdir / \"code_rules.json\"\n    cases_json = outdir / \"cases.json\"\n    md = outdir / \"UnitTestSpec_HighPrecision.md\"\n    xlsx = outdir / \"単体試験書_WF001.xlsx\"\n\n    cmd1 = [\"python\", \"scripts/parse_design_excel.py\", \"--input\", args.design, \"--out\", str(design_json)]\n    if args.ocr_lang:\n        cmd1 += [\"--ocr-lang\", args.ocr_lang]\n\n    run(cmd1)\n    run([\"python\", \"scripts/extract_code_rules.py\", \"--src\", args.code, \"--out\", str(code_json)])\n    run([\n        \"python\", \"scripts/generate_high_precision.py\",\n        \"--design\", str(design_json),\n        \"--code\", str(code_json),\n        \"--out-md\", str(md),\n        \"--out-cases\", str(cases_json),\n    ])\n    run([\n        \"python\", \"scripts/export_to_excel.py\",\n        \"--template\", args.template,\n        \"--cases\", str(cases_json),\n        \"--out\", str(xlsx),\n    ])\n\n    print(f\"Done. Outputs in: {outdir}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1772718063161}}
{"type":"message","id":"1a7949aa","parentId":"f724b1be","timestamp":"2026-03-05T13:42:28.942Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Creating large markdown with config snippet**","thinkingSignature":"{\"id\":\"rs_016cd7ee94e7b1620169a987f25f788191afb76658b67037d1\",\"type\":\"reasoning\",\"encrypted_content\":\"gAAAAABpqYfzcoaLUFZ3AuHQnB0Ad1X-c2bCArZKtGuc7gxgg0aN_sJGf9adfSGKoc6ScAwwCnYq8PFDg6BvwKAPBXGeIDdqhfIpi3c8D9lfqlffCAzRHbqZOv9Z1CpQV5uyWAsUVYdkQanWesc1jUzBEH61rS5TJXYfjfRnpPU5hOwn5H5Kscrfpm5987FHN9C59fgeB1qGw78Vg89fQgnvDVw3mLMNF4GS04cL0u3S5-qs4F5gLiiikMbUveAsmZeMssW0emfFTjeW1rGhrH7FFdQg86dgXsJ46D8MYhtpC4UBS6JltVVJdoj7KNVyAm5pDyxt2O8DRglKmjQlrTMYuTET1sDDhiLcrXp6DtNX8DEHHhxdpEQ9SevVOjtZ83m77wS9yV_b_2RQu5sDxzIwf1dmRu52mEXkoxNHeGrknCsw1UGE90ML5h2eQ24bbPsHn42sKtfZREh5QkcAEiunOP6t4yltSJ2y2Kv3WUGU90nklHcfritwD_U0fElwKblpKRpbUWxuEezKPilKhHEY5GkWBotlwZJD4X8pqmbf1bMS9G668R99_bsrfuheESQMM8MzVvc4HCkpTsbEyVbtVimvOgf-RAeJbQjxIM6Z8drluDtCq7heyVjMzYiR-DHjG6mSR1jJ8CkJGDzyI9sHSxhrQYe4lFQ0B-HMxp7h9adTc5eH7iNxe-CIf9x22dyi64VZCCDKV-h0WwROKrTGNp49Vfau0seghqETMU6lENfOxTqHR-whSf0wn9IoBk8sszJnTqvHHaDvtHtHScKxD4OsymXrmXstrayeCIpu0ee2tPtrbAFDYUVVvyCNkcu_d_KwCHL9b_fk7uUZzeF6rA9WhoGdvs1GgCXgkBJo6uBpjweBDwOVEqaNk763zJo_3MBJpQUoQdwZfx4i-ZDOkwBnCD09uCsR9luXhZ4vNVfS-1ZbYoxecnjT3NWWStl8Sb1ye1S8HkbKnct_g4Mvq5qo83y2AA==\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Creating large markdown with config snippet**\"}]}"},{"type":"toolCall","id":"call_5k92pBWIOWAhcihNcHjEnKPf|fc_016cd7ee94e7b1620169a987f315888191854c32e218e2ee98","name":"write","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace\\deliverables\\testbook-agent-skill-pack.md","content":"# testbook Agent + web-unit-testbook Skill 打包说明（可迁移）\n\n这个文件可直接带到另一台电脑使用。包含：\n- Agent 定义（testbook）\n- Skill 定义（web-unit-testbook）\n- 全部脚本源码\n- OpenClaw 注册配置片段\n\n---\n\n## 1) 目录结构（目标机）\n\n```text\n~/.openclaw/\n  workspace-testbook/\n    SOUL.md\n    AGENTS.md\n    skills/\n      web-unit-testbook/\n        SKILL.md\n        requirements.txt\n        scripts/\n          parse_design_excel.py\n          extract_code_rules.py\n          generate_high_precision.py\n          export_to_excel.py\n          run_pipeline.py\n```\n\n---\n\n## 2) Agent 文件\n\n### `workspace-testbook/SOUL.md`\n\n```md\n# SOUL.md - testbook\n\n你是 testbook，专注于“单体测试书”生成。\n\n工作目标：\n- 从设计文档/代码中提取测试点\n- 输出结构化用例与可交付测试书（xlsx）\n- 保持可追溯：输入、规则、输出路径都要明确\n\n执行规则：\n1. 先确认输入（设计文件、代码目录、模板文件）\n2. 缺少输入时先列清单，不要臆造\n3. 产出时必须包含：输出文件路径 + 覆盖范围 + 未覆盖项\n```\n\n### `workspace-testbook/AGENTS.md`\n\n```md\n# AGENTS.md - testbook\n\n- 接旨后先回复：已接旨\n- 输出格式：任务ID / 结果 / 证据路径 / 风险与阻塞\n- 删除或外发动作需明确标注并等待批准\n```\n\n---\n\n## 3) Skill 文件\n\n### `skills/web-unit-testbook/SKILL.md`\n\n```md\n---\nname: web-unit-testbook\ndescription: Generate web page unit test books from detailed design Excel files, embedded images/OCR text, LWC/Apex source code, and a user-provided Excel template. Use when user asks to read design docs, extract field/API/check rules, parse code branches and data bindings, generate test cases, and fill a unit test book template (.xlsx).\n---\n\n# Web Unit Test Book Generator\n\nBuild and run a deterministic pipeline for unit test book generation.\n\n## Workflow\n\n1. Parse design Excel into `design_rules.json`.\n2. Parse LWC/Apex code into `code_rules.json`.\n3. Merge rules and generate markdown spec + normalized case JSON.\n4. Fill the user template workbook and export final test book.\n\n## Inputs\n\n- Design workbook (`.xlsx`) with field definitions, API names, check notes, optional screenshots.\n- Code folder or zip with LWC/Apex files.\n- Unit test template workbook (`.xlsx`).\n\n## Commands\n\nRun from this skill directory.\n\n```powershell\npython scripts/parse_design_excel.py --input <design.xlsx> --out design_rules.json --ocr-lang jpn+eng\npython scripts/extract_code_rules.py --src <code_dir_or_zip> --out code_rules.json\npython scripts/generate_high_precision.py --design design_rules.json --code code_rules.json --out-md UnitTestSpec_HighPrecision.md --out-cases cases.json\npython scripts/export_to_excel.py --template <template.xlsx> --cases cases.json --out 単体試験書_WF001.xlsx\n```\n\nOr run one-shot:\n\n```powershell\npython scripts/run_pipeline.py --design <design.xlsx> --code <code_dir_or_zip> --template <template.xlsx> --outdir out\n```\n\n## Notes\n\n- OCR is optional: install Tesseract and pass `--ocr-lang`.\n- If template headers are unknown, script performs best-effort column mapping by keyword.\n- Keep all output artifacts in one run directory for traceability.\n\n## Output Artifacts\n\n- `design_rules.json`\n- `code_rules.json`\n- `cases.json`\n- `UnitTestSpec_HighPrecision.md`\n- `単体試験書_*.xlsx`\n```\n\n### `skills/web-unit-testbook/requirements.txt`\n\n```txt\npandas\nopenpyxl\nPillow\nJinja2\ntabulate\npytesseract\n```\n\n---\n\n## 4) 脚本源码\n\n### `scripts/parse_design_excel.py`\n\n```python\nimport argparse\nimport json\nimport re\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nfrom openpyxl import load_workbook\n\ntry:\n    import pytesseract\n    from PIL import Image\nexcept Exception:\n    pytesseract = None\n    Image = None\n\n\ndef is_red(rgb: str) -> bool:\n    if not rgb:\n        return False\n    rgb = rgb.upper().replace(\"#\", \"\")\n    if len(rgb) == 8:\n        rgb = rgb[2:]\n    return rgb.startswith(\"FF\") and rgb.endswith(\"0000\")\n\n\ndef extract_check_rules(text: str):\n    if not text:\n        return []\n    patterns = [\n        (\"required\", r\"必填|必須|required\"),\n        (\"range\", r\"\\d+\\s*~\\s*\\d+\"),\n        (\"maxmin\", r\"最大\\d+|最小\\d+|max\\s*\\d+|min\\s*\\d+\"),\n        (\"email\", r\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\"),\n    ]\n    return [name for name, pattern in patterns if re.search(pattern, text, flags=re.IGNORECASE)]\n\n\ndef extract_embedded_images(xlsx_path: Path, media_dir: Path):\n    media_dir.mkdir(parents=True, exist_ok=True)\n    extracted = []\n    with ZipFile(xlsx_path, \"r\") as zf:\n        for name in zf.namelist():\n            if name.startswith(\"xl/media/\"):\n                out = media_dir / Path(name).name\n                out.write_bytes(zf.read(name))\n                extracted.append(out)\n    return extracted\n\n\ndef run_ocr(image_paths, lang):\n    if not pytesseract or not Image:\n        return []\n    results = []\n    for i, p in enumerate(image_paths, start=1):\n        try:\n            txt = pytesseract.image_to_string(Image.open(p), lang=lang)\n            results.append({\"image_index\": i, \"image\": str(p), \"text\": txt.strip()})\n        except Exception as e:\n            results.append({\"image_index\": i, \"image\": str(p), \"error\": str(e)})\n    return results\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--input\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--ocr-lang\", default=\"\")\n    args = ap.parse_args()\n\n    xlsx = Path(args.input)\n    wb = load_workbook(xlsx, data_only=True)\n\n    fields = []\n    for ws in wb.worksheets:\n        for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n            values = [c.value for c in row]\n            joined = \" | \".join([str(v) for v in values if v is not None])\n            if not joined.strip():\n                continue\n\n            api_candidates = re.findall(r\"[a-zA-Z_][a-zA-Z0-9_]*(?:__c|__r)?\", joined)\n            required = False\n            cell_refs = []\n            for c in row:\n                if c.value is None:\n                    continue\n                cell_refs.append(c.coordinate)\n                color = None\n                try:\n                    color = c.fill.start_color.rgb or c.font.color.rgb\n                except Exception:\n                    pass\n                if color and is_red(color):\n                    required = True\n\n            fields.append(\n                {\n                    \"sheet\": ws.title,\n                    \"cells\": cell_refs,\n                    \"raw\": joined,\n                    \"api_names\": sorted(set(api_candidates))[:10],\n                    \"required_hint\": required,\n                    \"check_patterns\": extract_check_rules(joined),\n                }\n            )\n\n    media_dir = xlsx.parent / \"_media\"\n    images = extract_embedded_images(xlsx, media_dir)\n    ocr = run_ocr(images, args.ocr_lang) if args.ocr_lang else []\n\n    result = {\n        \"source\": str(xlsx),\n        \"sheet_count\": len(wb.worksheets),\n        \"field_rules\": fields,\n        \"embedded_images\": [str(p) for p in images],\n        \"ocr\": ocr,\n    }\n\n    Path(args.out).write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n### `scripts/extract_code_rules.py`\n\n```python\nimport argparse\nimport json\nimport re\nimport zipfile\nfrom pathlib import Path\n\n\nCODE_EXTS = {\".js\", \".ts\", \".html\", \".cls\", \".apex\"}\n\n\ndef collect_files(src: Path):\n    if src.is_file() and src.suffix.lower() == \".zip\":\n        temp = src.parent / \"_code_unzip\"\n        temp.mkdir(exist_ok=True)\n        with zipfile.ZipFile(src, \"r\") as zf:\n            zf.extractall(temp)\n        base = temp\n    else:\n        base = src\n    return [p for p in base.rglob(\"*\") if p.suffix.lower() in CODE_EXTS]\n\n\ndef parse_js_ts(text: str):\n    branches = re.findall(r\"\\bif\\s*\\(([^)]*)\\)|\\bswitch\\s*\\(([^)]*)\\)\", text)\n    wire_methods = re.findall(r\"@wire\\s*\\(([^)]+)\\)\", text)\n    methods = re.findall(r\"\\n\\s*(?:async\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{\", text)\n    return {\n        \"method_names\": sorted(set(methods)),\n        \"branch_conditions\": [a or b for a, b in branches if (a or b)],\n        \"wire_bindings\": [w.strip() for w in wire_methods],\n    }\n\n\ndef parse_apex(text: str):\n    methods = re.findall(\n        r\"(?:public|private|global|protected)\\s+(?:static\\s+)?(?:[A-Za-z_][A-Za-z0-9_<>,.]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    dml = re.findall(r\"\\b(insert|update|upsert|delete|merge|undelete)\\b\", text, flags=re.IGNORECASE)\n    exceptions = re.findall(r\"\\bthrow\\b|\\btry\\b|\\bcatch\\b|AuraHandledException|Exception\", text)\n\n    return {\n        \"method_names\": sorted(set([m[0] for m in methods])),\n        \"dml_ops\": [x.lower() for x in dml],\n        \"exception_paths\": len(exceptions),\n    }\n\n\ndef parse_text(path: Path, text: str):\n    ext = path.suffix.lower()\n    base = {\n        \"branch_count\": len(re.findall(r\"\\bif\\b|\\belse\\b|\\bswitch\\b\", text)),\n        \"wire_bindings\": [],\n        \"dml_ops\": [],\n        \"exception_paths\": 0,\n        \"method_names\": [],\n        \"branch_conditions\": [],\n    }\n\n    if ext in {\".js\", \".ts\"}:\n        js = parse_js_ts(text)\n        base.update(\n            {\n                \"wire_bindings\": js[\"wire_bindings\"],\n                \"method_names\": js[\"method_names\"],\n                \"branch_conditions\": js[\"branch_conditions\"],\n            }\n        )\n    elif ext in {\".cls\", \".apex\"}:\n        apex = parse_apex(text)\n        base.update(\n            {\n                \"dml_ops\": apex[\"dml_ops\"],\n                \"exception_paths\": apex[\"exception_paths\"],\n                \"method_names\": apex[\"method_names\"],\n            }\n        )\n\n    return base\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--src\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    src = Path(args.src)\n    files = collect_files(src)\n\n    rules = []\n    totals = {\"branches\": 0, \"wires\": 0, \"dml\": 0, \"exceptions\": 0, \"methods\": 0}\n    for f in files:\n        text = f.read_text(encoding=\"utf-8\", errors=\"ignore\")\n        parsed = parse_text(f, text)\n        totals[\"branches\"] += parsed[\"branch_count\"]\n        totals[\"wires\"] += len(parsed[\"wire_bindings\"])\n        totals[\"dml\"] += len(parsed[\"dml_ops\"])\n        totals[\"exceptions\"] += parsed[\"exception_paths\"]\n        totals[\"methods\"] += len(parsed[\"method_names\"])\n        rules.append({\"file\": str(f), **parsed})\n\n    out = {\"source\": str(src), \"files\": rules, \"summary\": totals}\n    Path(args.out).write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n### `scripts/generate_high_precision.py`\n\n```python\nimport argparse\nimport json\nfrom pathlib import Path\n\n\ndef build_cases(design, code):\n    cases = []\n    idx = 1\n\n    for f in design.get(\"field_rules\", [])[:300]:\n        api = (f.get(\"api_names\") or [\"N/A\"])[0]\n        required = f.get(\"required_hint\", False)\n        checks = f.get(\"check_patterns\", [])\n\n        cases.append(\n            {\n                \"case_id\": f\"TC-{idx:04d}\",\n                \"category\": \"字段校验\",\n                \"title\": f\"{api} 正常输入\",\n                \"precondition\": \"页面可访问，用户已登录\",\n                \"steps\": f\"输入 {api} 的合法值并提交\",\n                \"expected\": \"提交成功，数据保存正确\",\n                \"priority\": \"P1\" if required else \"P2\",\n            }\n        )\n        idx += 1\n\n        if required:\n            cases.append(\n                {\n                    \"case_id\": f\"TC-{idx:04d}\",\n                    \"category\": \"异常校验\",\n                    \"title\": f\"{api} 必填校验\",\n                    \"precondition\": \"页面可访问\",\n                    \"steps\": f\"清空 {api} 后提交\",\n                    \"expected\": \"出现必填错误提示，无法提交\",\n                    \"priority\": \"P1\",\n                }\n            )\n            idx += 1\n\n        if checks:\n            cases.append(\n                {\n                    \"case_id\": f\"TC-{idx:04d}\",\n                    \"category\": \"边界校验\",\n                    \"title\": f\"{api} 规则边界\",\n                    \"precondition\": \"页面可访问\",\n                    \"steps\": f\"按规则 {checks[0]} 构造边界值并提交\",\n                    \"expected\": \"边界行为符合设计说明\",\n                    \"priority\": \"P2\",\n                }\n            )\n            idx += 1\n\n    summary = code.get(\"summary\", {})\n    for _ in range(summary.get(\"branches\", 0)):\n        cases.append(\n            {\n                \"case_id\": f\"TC-{idx:04d}\",\n                \"category\": \"逻辑分支\",\n                \"title\": \"代码分支覆盖\",\n                \"precondition\": \"构造分支输入条件\",\n                \"steps\": \"触发 if/else 或 switch 分支\",\n                \"expected\": \"分支结果与预期一致\",\n                \"priority\": \"P1\",\n            }\n        )\n        idx += 1\n\n    return cases\n\n\ndef to_markdown(cases):\n    lines = [\"# Unit Test Spec (High Precision)\", \"\", \"| CaseID | Category | Title | Expected |\", \"|---|---|---|---|\"]\n    for c in cases:\n        lines.append(f\"| {c['case_id']} | {c['category']} | {c['title']} | {c['expected']} |\")\n    return \"\\n\".join(lines)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--out-md\", required=True)\n    ap.add_argument(\"--out-cases\", required=True)\n    args = ap.parse_args()\n\n    design = json.loads(Path(args.design).read_text(encoding=\"utf-8\"))\n    code = json.loads(Path(args.code).read_text(encoding=\"utf-8\"))\n\n    cases = build_cases(design, code)\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    Path(args.out_md).write_text(to_markdown(cases), encoding=\"utf-8\")\n\n    print(f\"Wrote {args.out_cases} and {args.out_md}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n### `scripts/export_to_excel.py`\n\n```python\nimport argparse\nimport json\nfrom pathlib import Path\n\nfrom openpyxl import load_workbook\n\n\nHEADER_KEYWORDS = {\n    \"case_id\": [\"case\", \"caseid\", \"编号\", \"id\", \"No\"],\n    \"category\": [\"category\", \"分類\", \"分类\", \"大分類\"],\n    \"title\": [\"title\", \"标题\", \"試験項目\", \"测试项\", \"小分類\"],\n    \"precondition\": [\"precondition\", \"前提\", \"前置\", \"テスト条件\"],\n    \"steps\": [\"steps\", \"手順\", \"步骤\", \"確認手順\"],\n    \"expected\": [\"expected\", \"期待\", \"预期\", \"想定結果\"],\n    \"priority\": [\"priority\", \"优先\", \"優先\"],\n}\n\nFALLBACK_ORDER = [\"case_id\", \"category\", \"title\", \"precondition\", \"steps\", \"expected\", \"priority\"]\n\n\ndef normalize(v):\n    return str(v or \"\").strip().lower().replace(\" \", \"\")\n\n\ndef detect_columns(ws):\n    best_row, best_cols = 1, {}\n    for row in ws.iter_rows(min_row=1, max_row=min(30, ws.max_row)):\n        cols = {}\n        for c in row:\n            nv = normalize(c.value)\n            for key, kws in HEADER_KEYWORDS.items():\n                if key in cols:\n                    continue\n                if any(normalize(k) in nv for k in kws):\n                    cols[key] = c.column\n        if len(cols) > len(best_cols):\n            best_cols = cols\n            best_row = row[0].row\n    return best_cols, best_row\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--template\", required=True)\n    ap.add_argument(\"--cases\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    cases = json.loads(Path(args.cases).read_text(encoding=\"utf-8\"))\n    wb = load_workbook(args.template)\n    ws = wb.active\n\n    cols, header_row = detect_columns(ws)\n    if not cols:\n        cols = {k: i + 1 for i, k in enumerate(FALLBACK_ORDER)}\n        header_row = 1\n        for k, col in cols.items():\n            ws.cell(row=1, column=col, value=k)\n\n    start_row = header_row + 1\n    for i, case in enumerate(cases, start=start_row):\n        for key, col in cols.items():\n            ws.cell(row=i, column=col, value=case.get(key, \"\"))\n\n    wb.save(args.out)\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n### `scripts/run_pipeline.py`\n\n```python\nimport argparse\nimport subprocess\nfrom pathlib import Path\n\n\ndef run(cmd):\n    print(\"[RUN]\", \" \".join(cmd))\n    subprocess.check_call(cmd)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--template\", required=True)\n    ap.add_argument(\"--outdir\", required=True)\n    ap.add_argument(\"--ocr-lang\", default=\"\")\n    args = ap.parse_args()\n\n    outdir = Path(args.outdir)\n    outdir.mkdir(parents=True, exist_ok=True)\n\n    design_json = outdir / \"design_rules.json\"\n    code_json = outdir / \"code_rules.json\"\n    cases_json = outdir / \"cases.json\"\n    md = outdir / \"UnitTestSpec_HighPrecision.md\"\n    xlsx = outdir / \"単体試験書_WF001.xlsx\"\n\n    cmd1 = [\"python\", \"scripts/parse_design_excel.py\", \"--input\", args.design, \"--out\", str(design_json)]\n    if args.ocr_lang:\n        cmd1 += [\"--ocr-lang\", args.ocr_lang]\n\n    run(cmd1)\n    run([\"python\", \"scripts/extract_code_rules.py\", \"--src\", args.code, \"--out\", str(code_json)])\n    run([\n        \"python\", \"scripts/generate_high_precision.py\",\n        \"--design\", str(design_json),\n        \"--code\", str(code_json),\n        \"--out-md\", str(md),\n        \"--out-cases\", str(cases_json),\n    ])\n    run([\n        \"python\", \"scripts/export_to_excel.py\",\n        \"--template\", args.template,\n        \"--cases\", str(cases_json),\n        \"--out\", str(xlsx),\n    ])\n\n    print(f\"Done. Outputs in: {outdir}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n---\n\n## 5) OpenClaw 注册配置（目标机）\n\n在目标机 `~/.openclaw/openclaw.json` 中追加/确认：\n\n```json\n{\n  \"agents\": {\n    \"list\": [\n      {\n        \"id\": \"testbook\",\n        \"name\": \"testbook\",\n        \"workspace\": \"C:\\\\Users\\\\<YourUser>\\\\.openclaw\\\\workspace-testbook\",\n        \"skills\": [\"web-unit-testbook\"],\n        \"subagents\": {\n          \"allowAgents\": [\"shangshu\"]\n        }\n      }\n    ]\n  }\n}\n```\n\n如果你也用三省六部，记得在 `shangshu` 的 `allowAgents` 里加上 `testbook`。\n\n---\n\n## 6) 目标机快速安装命令\n\n```powershell\ncd C:\\Users\\<YourUser>\\.openclaw\\workspace-testbook\\skills\\web-unit-testbook\npython -m pip install -r requirements.txt\n```\n\n运行：\n\n```powershell\npython scripts/run_pipeline.py --design <design.xlsx> --code <code_dir_or_zip> --template <template.xlsx> --outdir out\n```\n\n---\n\n## 7) 本机打包文件位置\n\n- `C:\\Users\\吗喽\\.openclaw\\workspace\\deliverables\\testbook-agent-skill-pack.md`\n\n你把这一个 `.md` 带走即可，在其他电脑按文档重建。"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\deliverables\\\\testbook-agent-skill-pack.md\",\"content\":\"# testbook Agent + web-unit-testbook Skill 打包说明（可迁移）\\n\\n这个文件可直接带到另一台电脑使用。包含：\\n- Agent 定义（testbook）\\n- Skill 定义（web-unit-testbook）\\n- 全部脚本源码\\n- OpenClaw 注册配置片段\\n\\n---\\n\\n## 1) 目录结构（目标机）\\n\\n```text\\n~/.openclaw/\\n  workspace-testbook/\\n    SOUL.md\\n    AGENTS.md\\n    skills/\\n      web-unit-testbook/\\n        SKILL.md\\n        requirements.txt\\n        scripts/\\n          parse_design_excel.py\\n          extract_code_rules.py\\n          generate_high_precision.py\\n          export_to_excel.py\\n          run_pipeline.py\\n```\\n\\n---\\n\\n## 2) Agent 文件\\n\\n### `workspace-testbook/SOUL.md`\\n\\n```md\\n# SOUL.md - testbook\\n\\n你是 testbook，专注于“单体测试书”生成。\\n\\n工作目标：\\n- 从设计文档/代码中提取测试点\\n- 输出结构化用例与可交付测试书（xlsx）\\n- 保持可追溯：输入、规则、输出路径都要明确\\n\\n执行规则：\\n1. 先确认输入（设计文件、代码目录、模板文件）\\n2. 缺少输入时先列清单，不要臆造\\n3. 产出时必须包含：输出文件路径 + 覆盖范围 + 未覆盖项\\n```\\n\\n### `workspace-testbook/AGENTS.md`\\n\\n```md\\n# AGENTS.md - testbook\\n\\n- 接旨后先回复：已接旨\\n- 输出格式：任务ID / 结果 / 证据路径 / 风险与阻塞\\n- 删除或外发动作需明确标注并等待批准\\n```\\n\\n---\\n\\n## 3) Skill 文件\\n\\n### `skills/web-unit-testbook/SKILL.md`\\n\\n```md\\n---\\nname: web-unit-testbook\\ndescription: Generate web page unit test books from detailed design Excel files, embedded images/OCR text, LWC/Apex source code, and a user-provided Excel template. Use when user asks to read design docs, extract field/API/check rules, parse code branches and data bindings, generate test cases, and fill a unit test book template (.xlsx).\\n---\\n\\n# Web Unit Test Book Generator\\n\\nBuild and run a deterministic pipeline for unit test book generation.\\n\\n## Workflow\\n\\n1. Parse design Excel into `design_rules.json`.\\n2. Parse LWC/Apex code into `code_rules.json`.\\n3. Merge rules and generate markdown spec + normalized case JSON.\\n4. Fill the user template workbook and export final test book.\\n\\n## Inputs\\n\\n- Design workbook (`.xlsx`) with field definitions, API names, check notes, optional screenshots.\\n- Code folder or zip with LWC/Apex files.\\n- Unit test template workbook (`.xlsx`).\\n\\n## Commands\\n\\nRun from this skill directory.\\n\\n```powershell\\npython scripts/parse_design_excel.py --input <design.xlsx> --out design_rules.json --ocr-lang jpn+eng\\npython scripts/extract_code_rules.py --src <code_dir_or_zip> --out code_rules.json\\npython scripts/generate_high_precision.py --design design_rules.json --code code_rules.json --out-md UnitTestSpec_HighPrecision.md --out-cases cases.json\\npython scripts/export_to_excel.py --template <template.xlsx> --cases cases.json --out 単体試験書_WF001.xlsx\\n```\\n\\nOr run one-shot:\\n\\n```powershell\\npython scripts/run_pipeline.py --design <design.xlsx> --code <code_dir_or_zip> --template <template.xlsx> --outdir out\\n```\\n\\n## Notes\\n\\n- OCR is optional: install Tesseract and pass `--ocr-lang`.\\n- If template headers are unknown, script performs best-effort column mapping by keyword.\\n- Keep all output artifacts in one run directory for traceability.\\n\\n## Output Artifacts\\n\\n- `design_rules.json`\\n- `code_rules.json`\\n- `cases.json`\\n- `UnitTestSpec_HighPrecision.md`\\n- `単体試験書_*.xlsx`\\n```\\n\\n### `skills/web-unit-testbook/requirements.txt`\\n\\n```txt\\npandas\\nopenpyxl\\nPillow\\nJinja2\\ntabulate\\npytesseract\\n```\\n\\n---\\n\\n## 4) 脚本源码\\n\\n### `scripts/parse_design_excel.py`\\n\\n```python\\nimport argparse\\nimport json\\nimport re\\nfrom pathlib import Path\\nfrom zipfile import ZipFile\\n\\nfrom openpyxl import load_workbook\\n\\ntry:\\n    import pytesseract\\n    from PIL import Image\\nexcept Exception:\\n    pytesseract = None\\n    Image = None\\n\\n\\ndef is_red(rgb: str) -> bool:\\n    if not rgb:\\n        return False\\n    rgb = rgb.upper().replace(\\\"#\\\", \\\"\\\")\\n    if len(rgb) == 8:\\n        rgb = rgb[2:]\\n    return rgb.startswith(\\\"FF\\\") and rgb.endswith(\\\"0000\\\")\\n\\n\\ndef extract_check_rules(text: str):\\n    if not text:\\n        return []\\n    patterns = [\\n        (\\\"required\\\", r\\\"必填|必須|required\\\"),\\n        (\\\"range\\\", r\\\"\\\\d+\\\\s*~\\\\s*\\\\d+\\\"),\\n        (\\\"maxmin\\\", r\\\"最大\\\\d+|最小\\\\d+|max\\\\s*\\\\d+|min\\\\s*\\\\d+\\\"),\\n        (\\\"email\\\", r\\\"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\"),\\n    ]\\n    return [name for name, pattern in patterns if re.search(pattern, text, flags=re.IGNORECASE)]\\n\\n\\ndef extract_embedded_images(xlsx_path: Path, media_dir: Path):\\n    media_dir.mkdir(parents=True, exist_ok=True)\\n    extracted = []\\n    with ZipFile(xlsx_path, \\\"r\\\") as zf:\\n        for name in zf.namelist():\\n            if name.startswith(\\\"xl/media/\\\"):\\n                out = media_dir / Path(name).name\\n                out.write_bytes(zf.read(name))\\n                extracted.append(out)\\n    return extracted\\n\\n\\ndef run_ocr(image_paths, lang):\\n    if not pytesseract or not Image:\\n        return []\\n    results = []\\n    for i, p in enumerate(image_paths, start=1):\\n        try:\\n            txt = pytesseract.image_to_string(Image.open(p), lang=lang)\\n            results.append({\\\"image_index\\\": i, \\\"image\\\": str(p), \\\"text\\\": txt.strip()})\\n        except Exception as e:\\n            results.append({\\\"image_index\\\": i, \\\"image\\\": str(p), \\\"error\\\": str(e)})\\n    return results\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--input\\\", required=True)\\n    ap.add_argument(\\\"--out\\\", required=True)\\n    ap.add_argument(\\\"--ocr-lang\\\", default=\\\"\\\")\\n    args = ap.parse_args()\\n\\n    xlsx = Path(args.input)\\n    wb = load_workbook(xlsx, data_only=True)\\n\\n    fields = []\\n    for ws in wb.worksheets:\\n        for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\\n            values = [c.value for c in row]\\n            joined = \\\" | \\\".join([str(v) for v in values if v is not None])\\n            if not joined.strip():\\n                continue\\n\\n            api_candidates = re.findall(r\\\"[a-zA-Z_][a-zA-Z0-9_]*(?:__c|__r)?\\\", joined)\\n            required = False\\n            cell_refs = []\\n            for c in row:\\n                if c.value is None:\\n                    continue\\n                cell_refs.append(c.coordinate)\\n                color = None\\n                try:\\n                    color = c.fill.start_color.rgb or c.font.color.rgb\\n                except Exception:\\n                    pass\\n                if color and is_red(color):\\n                    required = True\\n\\n            fields.append(\\n                {\\n                    \\\"sheet\\\": ws.title,\\n                    \\\"cells\\\": cell_refs,\\n                    \\\"raw\\\": joined,\\n                    \\\"api_names\\\": sorted(set(api_candidates))[:10],\\n                    \\\"required_hint\\\": required,\\n                    \\\"check_patterns\\\": extract_check_rules(joined),\\n                }\\n            )\\n\\n    media_dir = xlsx.parent / \\\"_media\\\"\\n    images = extract_embedded_images(xlsx, media_dir)\\n    ocr = run_ocr(images, args.ocr_lang) if args.ocr_lang else []\\n\\n    result = {\\n        \\\"source\\\": str(xlsx),\\n        \\\"sheet_count\\\": len(wb.worksheets),\\n        \\\"field_rules\\\": fields,\\n        \\\"embedded_images\\\": [str(p) for p in images],\\n        \\\"ocr\\\": ocr,\\n    }\\n\\n    Path(args.out).write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding=\\\"utf-8\\\")\\n    print(f\\\"Wrote {args.out}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n```\\n\\n### `scripts/extract_code_rules.py`\\n\\n```python\\nimport argparse\\nimport json\\nimport re\\nimport zipfile\\nfrom pathlib import Path\\n\\n\\nCODE_EXTS = {\\\".js\\\", \\\".ts\\\", \\\".html\\\", \\\".cls\\\", \\\".apex\\\"}\\n\\n\\ndef collect_files(src: Path):\\n    if src.is_file() and src.suffix.lower() == \\\".zip\\\":\\n        temp = src.parent / \\\"_code_unzip\\\"\\n        temp.mkdir(exist_ok=True)\\n        with zipfile.ZipFile(src, \\\"r\\\") as zf:\\n            zf.extractall(temp)\\n        base = temp\\n    else:\\n        base = src\\n    return [p for p in base.rglob(\\\"*\\\") if p.suffix.lower() in CODE_EXTS]\\n\\n\\ndef parse_js_ts(text: str):\\n    branches = re.findall(r\\\"\\\\bif\\\\s*\\\\(([^)]*)\\\\)|\\\\bswitch\\\\s*\\\\(([^)]*)\\\\)\\\", text)\\n    wire_methods = re.findall(r\\\"@wire\\\\s*\\\\(([^)]+)\\\\)\\\", text)\\n    methods = re.findall(r\\\"\\\\n\\\\s*(?:async\\\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\([^)]*\\\\)\\\\s*\\\\{\\\", text)\\n    return {\\n        \\\"method_names\\\": sorted(set(methods)),\\n        \\\"branch_conditions\\\": [a or b for a, b in branches if (a or b)],\\n        \\\"wire_bindings\\\": [w.strip() for w in wire_methods],\\n    }\\n\\n\\ndef parse_apex(text: str):\\n    methods = re.findall(\\n        r\\\"(?:public|private|global|protected)\\\\s+(?:static\\\\s+)?(?:[A-Za-z_][A-Za-z0-9_<>,.]*)\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(([^)]*)\\\\)\\\",\\n        text,\\n        flags=re.IGNORECASE,\\n    )\\n    dml = re.findall(r\\\"\\\\b(insert|update|upsert|delete|merge|undelete)\\\\b\\\", text, flags=re.IGNORECASE)\\n    exceptions = re.findall(r\\\"\\\\bthrow\\\\b|\\\\btry\\\\b|\\\\bcatch\\\\b|AuraHandledException|Exception\\\", text)\\n\\n    return {\\n        \\\"method_names\\\": sorted(set([m[0] for m in methods])),\\n        \\\"dml_ops\\\": [x.lower() for x in dml],\\n        \\\"exception_paths\\\": len(exceptions),\\n    }\\n\\n\\ndef parse_text(path: Path, text: str):\\n    ext = path.suffix.lower()\\n    base = {\\n        \\\"branch_count\\\": len(re.findall(r\\\"\\\\bif\\\\b|\\\\belse\\\\b|\\\\bswitch\\\\b\\\", text)),\\n        \\\"wire_bindings\\\": [],\\n        \\\"dml_ops\\\": [],\\n        \\\"exception_paths\\\": 0,\\n        \\\"method_names\\\": [],\\n        \\\"branch_conditions\\\": [],\\n    }\\n\\n    if ext in {\\\".js\\\", \\\".ts\\\"}:\\n        js = parse_js_ts(text)\\n        base.update(\\n            {\\n                \\\"wire_bindings\\\": js[\\\"wire_bindings\\\"],\\n                \\\"method_names\\\": js[\\\"method_names\\\"],\\n                \\\"branch_conditions\\\": js[\\\"branch_conditions\\\"],\\n            }\\n        )\\n    elif ext in {\\\".cls\\\", \\\".apex\\\"}:\\n        apex = parse_apex(text)\\n        base.update(\\n            {\\n                \\\"dml_ops\\\": apex[\\\"dml_ops\\\"],\\n                \\\"exception_paths\\\": apex[\\\"exception_paths\\\"],\\n                \\\"method_names\\\": apex[\\\"method_names\\\"],\\n            }\\n        )\\n\\n    return base\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--src\\\", required=True)\\n    ap.add_argument(\\\"--out\\\", required=True)\\n    args = ap.parse_args()\\n\\n    src = Path(args.src)\\n    files = collect_files(src)\\n\\n    rules = []\\n    totals = {\\\"branches\\\": 0, \\\"wires\\\": 0, \\\"dml\\\": 0, \\\"exceptions\\\": 0, \\\"methods\\\": 0}\\n    for f in files:\\n        text = f.read_text(encoding=\\\"utf-8\\\", errors=\\\"ignore\\\")\\n        parsed = parse_text(f, text)\\n        totals[\\\"branches\\\"] += parsed[\\\"branch_count\\\"]\\n        totals[\\\"wires\\\"] += len(parsed[\\\"wire_bindings\\\"])\\n        totals[\\\"dml\\\"] += len(parsed[\\\"dml_ops\\\"])\\n        totals[\\\"exceptions\\\"] += parsed[\\\"exception_paths\\\"]\\n        totals[\\\"methods\\\"] += len(parsed[\\\"method_names\\\"])\\n        rules.append({\\\"file\\\": str(f), **parsed})\\n\\n    out = {\\\"source\\\": str(src), \\\"files\\\": rules, \\\"summary\\\": totals}\\n    Path(args.out).write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding=\\\"utf-8\\\")\\n    print(f\\\"Wrote {args.out}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n```\\n\\n### `scripts/generate_high_precision.py`\\n\\n```python\\nimport argparse\\nimport json\\nfrom pathlib import Path\\n\\n\\ndef build_cases(design, code):\\n    cases = []\\n    idx = 1\\n\\n    for f in design.get(\\\"field_rules\\\", [])[:300]:\\n        api = (f.get(\\\"api_names\\\") or [\\\"N/A\\\"])[0]\\n        required = f.get(\\\"required_hint\\\", False)\\n        checks = f.get(\\\"check_patterns\\\", [])\\n\\n        cases.append(\\n            {\\n                \\\"case_id\\\": f\\\"TC-{idx:04d}\\\",\\n                \\\"category\\\": \\\"字段校验\\\",\\n                \\\"title\\\": f\\\"{api} 正常输入\\\",\\n                \\\"precondition\\\": \\\"页面可访问，用户已登录\\\",\\n                \\\"steps\\\": f\\\"输入 {api} 的合法值并提交\\\",\\n                \\\"expected\\\": \\\"提交成功，数据保存正确\\\",\\n                \\\"priority\\\": \\\"P1\\\" if required else \\\"P2\\\",\\n            }\\n        )\\n        idx += 1\\n\\n        if required:\\n            cases.append(\\n                {\\n                    \\\"case_id\\\": f\\\"TC-{idx:04d}\\\",\\n                    \\\"category\\\": \\\"异常校验\\\",\\n                    \\\"title\\\": f\\\"{api} 必填校验\\\",\\n                    \\\"precondition\\\": \\\"页面可访问\\\",\\n                    \\\"steps\\\": f\\\"清空 {api} 后提交\\\",\\n                    \\\"expected\\\": \\\"出现必填错误提示，无法提交\\\",\\n                    \\\"priority\\\": \\\"P1\\\",\\n                }\\n            )\\n            idx += 1\\n\\n        if checks:\\n            cases.append(\\n                {\\n                    \\\"case_id\\\": f\\\"TC-{idx:04d}\\\",\\n                    \\\"category\\\": \\\"边界校验\\\",\\n                    \\\"title\\\": f\\\"{api} 规则边界\\\",\\n                    \\\"precondition\\\": \\\"页面可访问\\\",\\n                    \\\"steps\\\": f\\\"按规则 {checks[0]} 构造边界值并提交\\\",\\n                    \\\"expected\\\": \\\"边界行为符合设计说明\\\",\\n                    \\\"priority\\\": \\\"P2\\\",\\n                }\\n            )\\n            idx += 1\\n\\n    summary = code.get(\\\"summary\\\", {})\\n    for _ in range(summary.get(\\\"branches\\\", 0)):\\n        cases.append(\\n            {\\n                \\\"case_id\\\": f\\\"TC-{idx:04d}\\\",\\n                \\\"category\\\": \\\"逻辑分支\\\",\\n                \\\"title\\\": \\\"代码分支覆盖\\\",\\n                \\\"precondition\\\": \\\"构造分支输入条件\\\",\\n                \\\"steps\\\": \\\"触发 if/else 或 switch 分支\\\",\\n                \\\"expected\\\": \\\"分支结果与预期一致\\\",\\n                \\\"priority\\\": \\\"P1\\\",\\n            }\\n        )\\n        idx += 1\\n\\n    return cases\\n\\n\\ndef to_markdown(cases):\\n    lines = [\\\"# Unit Test Spec (High Precision)\\\", \\\"\\\", \\\"| CaseID | Category | Title | Expected |\\\", \\\"|---|---|---|---|\\\"]\\n    for c in cases:\\n        lines.append(f\\\"| {c['case_id']} | {c['category']} | {c['title']} | {c['expected']} |\\\")\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--design\\\", required=True)\\n    ap.add_argument(\\\"--code\\\", required=True)\\n    ap.add_argument(\\\"--out-md\\\", required=True)\\n    ap.add_argument(\\\"--out-cases\\\", required=True)\\n    args = ap.parse_args()\\n\\n    design = json.loads(Path(args.design).read_text(encoding=\\\"utf-8\\\"))\\n    code = json.loads(Path(args.code).read_text(encoding=\\\"utf-8\\\"))\\n\\n    cases = build_cases(design, code)\\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\\\"utf-8\\\")\\n    Path(args.out_md).write_text(to_markdown(cases), encoding=\\\"utf-8\\\")\\n\\n    print(f\\\"Wrote {args.out_cases} and {args.out_md}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n```\\n\\n### `scripts/export_to_excel.py`\\n\\n```python\\nimport argparse\\nimport json\\nfrom pathlib import Path\\n\\nfrom openpyxl import load_workbook\\n\\n\\nHEADER_KEYWORDS = {\\n    \\\"case_id\\\": [\\\"case\\\", \\\"caseid\\\", \\\"编号\\\", \\\"id\\\", \\\"No\\\"],\\n    \\\"category\\\": [\\\"category\\\", \\\"分類\\\", \\\"分类\\\", \\\"大分類\\\"],\\n    \\\"title\\\": [\\\"title\\\", \\\"标题\\\", \\\"試験項目\\\", \\\"测试项\\\", \\\"小分類\\\"],\\n    \\\"precondition\\\": [\\\"precondition\\\", \\\"前提\\\", \\\"前置\\\", \\\"テスト条件\\\"],\\n    \\\"steps\\\": [\\\"steps\\\", \\\"手順\\\", \\\"步骤\\\", \\\"確認手順\\\"],\\n    \\\"expected\\\": [\\\"expected\\\", \\\"期待\\\", \\\"预期\\\", \\\"想定結果\\\"],\\n    \\\"priority\\\": [\\\"priority\\\", \\\"优先\\\", \\\"優先\\\"],\\n}\\n\\nFALLBACK_ORDER = [\\\"case_id\\\", \\\"category\\\", \\\"title\\\", \\\"precondition\\\", \\\"steps\\\", \\\"expected\\\", \\\"priority\\\"]\\n\\n\\ndef normalize(v):\\n    return str(v or \\\"\\\").strip().lower().replace(\\\" \\\", \\\"\\\")\\n\\n\\ndef detect_columns(ws):\\n    best_row, best_cols = 1, {}\\n    for row in ws.iter_rows(min_row=1, max_row=min(30, ws.max_row)):\\n        cols = {}\\n        for c in row:\\n            nv = normalize(c.value)\\n            for key, kws in HEADER_KEYWORDS.items():\\n                if key in cols:\\n                    continue\\n                if any(normalize(k) in nv for k in kws):\\n                    cols[key] = c.column\\n        if len(cols) > len(best_cols):\\n            best_cols = cols\\n            best_row = row[0].row\\n    return best_cols, best_row\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--template\\\", required=True)\\n    ap.add_argument(\\\"--cases\\\", required=True)\\n    ap.add_argument(\\\"--out\\\", required=True)\\n    args = ap.parse_args()\\n\\n    cases = json.loads(Path(args.cases).read_text(encoding=\\\"utf-8\\\"))\\n    wb = load_workbook(args.template)\\n    ws = wb.active\\n\\n    cols, header_row = detect_columns(ws)\\n    if not cols:\\n        cols = {k: i + 1 for i, k in enumerate(FALLBACK_ORDER)}\\n        header_row = 1\\n        for k, col in cols.items():\\n            ws.cell(row=1, column=col, value=k)\\n\\n    start_row = header_row + 1\\n    for i, case in enumerate(cases, start=start_row):\\n        for key, col in cols.items():\\n            ws.cell(row=i, column=col, value=case.get(key, \\\"\\\"))\\n\\n    wb.save(args.out)\\n    print(f\\\"Wrote {args.out}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n```\\n\\n### `scripts/run_pipeline.py`\\n\\n```python\\nimport argparse\\nimport subprocess\\nfrom pathlib import Path\\n\\n\\ndef run(cmd):\\n    print(\\\"[RUN]\\\", \\\" \\\".join(cmd))\\n    subprocess.check_call(cmd)\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--design\\\", required=True)\\n    ap.add_argument(\\\"--code\\\", required=True)\\n    ap.add_argument(\\\"--template\\\", required=True)\\n    ap.add_argument(\\\"--outdir\\\", required=True)\\n    ap.add_argument(\\\"--ocr-lang\\\", default=\\\"\\\")\\n    args = ap.parse_args()\\n\\n    outdir = Path(args.outdir)\\n    outdir.mkdir(parents=True, exist_ok=True)\\n\\n    design_json = outdir / \\\"design_rules.json\\\"\\n    code_json = outdir / \\\"code_rules.json\\\"\\n    cases_json = outdir / \\\"cases.json\\\"\\n    md = outdir / \\\"UnitTestSpec_HighPrecision.md\\\"\\n    xlsx = outdir / \\\"単体試験書_WF001.xlsx\\\"\\n\\n    cmd1 = [\\\"python\\\", \\\"scripts/parse_design_excel.py\\\", \\\"--input\\\", args.design, \\\"--out\\\", str(design_json)]\\n    if args.ocr_lang:\\n        cmd1 += [\\\"--ocr-lang\\\", args.ocr_lang]\\n\\n    run(cmd1)\\n    run([\\\"python\\\", \\\"scripts/extract_code_rules.py\\\", \\\"--src\\\", args.code, \\\"--out\\\", str(code_json)])\\n    run([\\n        \\\"python\\\", \\\"scripts/generate_high_precision.py\\\",\\n        \\\"--design\\\", str(design_json),\\n        \\\"--code\\\", str(code_json),\\n        \\\"--out-md\\\", str(md),\\n        \\\"--out-cases\\\", str(cases_json),\\n    ])\\n    run([\\n        \\\"python\\\", \\\"scripts/export_to_excel.py\\\",\\n        \\\"--template\\\", args.template,\\n        \\\"--cases\\\", str(cases_json),\\n        \\\"--out\\\", str(xlsx),\\n    ])\\n\\n    print(f\\\"Done. Outputs in: {outdir}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n```\\n\\n---\\n\\n## 5) OpenClaw 注册配置（目标机）\\n\\n在目标机 `~/.openclaw/openclaw.json` 中追加/确认：\\n\\n```json\\n{\\n  \\\"agents\\\": {\\n    \\\"list\\\": [\\n      {\\n        \\\"id\\\": \\\"testbook\\\",\\n        \\\"name\\\": \\\"testbook\\\",\\n        \\\"workspace\\\": \\\"C:\\\\\\\\Users\\\\\\\\<YourUser>\\\\\\\\.openclaw\\\\\\\\workspace-testbook\\\",\\n        \\\"skills\\\": [\\\"web-unit-testbook\\\"],\\n        \\\"subagents\\\": {\\n          \\\"allowAgents\\\": [\\\"shangshu\\\"]\\n        }\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n如果你也用三省六部，记得在 `shangshu` 的 `allowAgents` 里加上 `testbook`。\\n\\n---\\n\\n## 6) 目标机快速安装命令\\n\\n```powershell\\ncd C:\\\\Users\\\\<YourUser>\\\\.openclaw\\\\workspace-testbook\\\\skills\\\\web-unit-testbook\\npython -m pip install -r requirements.txt\\n```\\n\\n运行：\\n\\n```powershell\\npython scripts/run_pipeline.py --design <design.xlsx> --code <code_dir_or_zip> --template <template.xlsx> --outdir out\\n```\\n\\n---\\n\\n## 7) 本机打包文件位置\\n\\n- `C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\deliverables\\\\testbook-agent-skill-pack.md`\\n\\n你把这一个 `.md` 带走即可，在其他电脑按文档重建。\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":69826,"output":5885,"cacheRead":20992,"cacheWrite":0,"totalTokens":96703,"cost":{"input":0.1221955,"output":0.08239,"cacheRead":0.0036736,"cacheWrite":0,"total":0.2082591}},"stopReason":"toolUse","timestamp":1772718063167}}
