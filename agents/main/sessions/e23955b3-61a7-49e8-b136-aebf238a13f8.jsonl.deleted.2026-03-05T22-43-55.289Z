bu','xingbu','gongbu','libu_hr','zaochao');\n# backup config\n$ts=Get-Date -Format 'yyyyMMdd-HHmmss'; Copy-Item $cfg \"$cfg.bak.sansheng-$ts\" -Force;\n# create workspaces and copy SOUL/AGENTS\nforeach($a in $agents){\n  $ws=Join-Path $ocHome (\"workspace-\"+$a);\n  New-Item -ItemType Directory -Force -Path (Join-Path $ws 'skills') | Out-Null;\n  $src=Join-Path $repo (\"agents/$a/SOUL.md\");\n  if(Test-Path $src){\n    $content=Get-Content $src -Raw;\n    $content=$content -replace '__REPO_DIR__',[regex]::Escape($repo).Replace('\\\\','\\\\');\n    Set-Content -Path (Join-Path $ws 'SOUL.md') -Value $content -Encoding UTF8;\n  }\n  @\"\n# AGENTS.md · 工作协议\n\n1. 接到任务先回复\"已接旨\"。\n2. 输出必须包含：任务ID、结果、证据/文件路径、阻塞项。\n3. 需要协作时，回复尚书省请求转派，不跨部直连。\n4. 涉及删除/外发动作必须明确标注并等待批准。\n\"@ | Set-Content -Path (Join-Path $ws 'AGENTS.md') -Encoding UTF8;\n}\n# register agents\n$json=Get-Content $cfg -Raw | ConvertFrom-Json;\nif(-not $json.agents){$json | Add-Member -NotePropertyName agents -NotePropertyValue ([pscustomobject]@{})}\nif(-not $json.agents.list){$json.agents | Add-Member -NotePropertyName list -NotePropertyValue @()}\n$existing=@{}; foreach($e in $json.agents.list){$existing[$e.id]=$true}\n$defs=@(\n  @{id='taizi';allow=@('zhongshu')},\n  @{id='zhongshu';allow=@('menxia','shangshu')},\n  @{id='menxia';allow=@('shangshu','zhongshu')},\n  @{id='shangshu';allow=@('zhongshu','menxia','hubu','libu','bingbu','xingbu','gongbu','libu_hr')},\n  @{id='hubu';allow=@('shangshu')},\n  @{id='libu';allow=@('shangshu')},\n  @{id='bingbu';allow=@('shangshu')},\n  @{id='xingbu';allow=@('shangshu')},\n  @{id='gongbu';allow=@('shangshu')},\n  @{id='libu_hr';allow=@('shangshu')},\n  @{id='zaochao';allow=@()}\n)\nforeach($d in $defs){\n  if(-not $existing.ContainsKey($d.id)){\n    $entry=[pscustomobject]@{id=$d.id;workspace=(Join-Path $ocHome (\"workspace-\"+$d.id));subagents=[pscustomobject]@{allowAgents=$d.allow}};\n    $json.agents.list += $entry;\n  }\n}\n$json | ConvertTo-Json -Depth 20 | Set-Content -Path $cfg -Encoding UTF8;\n# init data\n$data=Join-Path $repo 'data'; New-Item -ItemType Directory -Force -Path $data | Out-Null;\n'{}' | Set-Content (Join-Path $data 'live_status.json') -Encoding UTF8;\n'{}' | Set-Content (Join-Path $data 'agent_config.json') -Encoding UTF8;\n'{}' | Set-Content (Join-Path $data 'model_change_log.json') -Encoding UTF8;\n'[]' | Set-Content (Join-Path $data 'pending_model_changes.json') -Encoding UTF8;\nif(-not (Test-Path (Join-Path $data 'tasks_source.json'))){\n@'[\n  {\n    \"id\": \"JJC-DEMO-001\",\n    \"title\": \"🎉 系统初始化完成\",\n    \"official\": \"工部尚书\",\n    \"org\": \"工部\",\n    \"state\": \"Done\",\n    \"now\": \"三省六部系统已就绪\",\n    \"eta\": \"-\",\n    \"block\": \"无\",\n    \"output\": \"\",\n    \"ac\": \"系统正常运行\",\n    \"flow_log\": []\n  }\n]\n'@ | Set-Content (Join-Path $data 'tasks_source.json') -Encoding UTF8;\n}\nWrite-Host 'EDICT base install finished.'","workdir":"C:\\Users\\吗喽\\.openclaw\\workspace","yieldMs":120000},"partialJson":"{\"command\":\"$ErrorActionPreference='Stop';\\n$repo='C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\edict';\\n$ocHome='C:\\\\Users\\\\吗喽\\\\.openclaw';\\n$cfg=Join-Path $ocHome 'openclaw.json';\\n$agents=@('taizi','zhongshu','menxia','shangshu','hubu','libu','bingbu','xingbu','gongbu','libu_hr','zaochao');\\n# backup config\\n$ts=Get-Date -Format 'yyyyMMdd-HHmmss'; Copy-Item $cfg \\\"$cfg.bak.sansheng-$ts\\\" -Force;\\n# create workspaces and copy SOUL/AGENTS\\nforeach($a in $agents){\\n  $ws=Join-Path $ocHome (\\\"workspace-\\\"+$a);\\n  New-Item -ItemType Directory -Force -Path (Join-Path $ws 'skills') | Out-Null;\\n  $src=Join-Path $repo (\\\"agents/$a/SOUL.md\\\");\\n  if(Test-Path $src){\\n    $content=Get-Content $src -Raw;\\n    $content=$content -replace '__REPO_DIR__',[regex]::Escape($repo).Replace('\\\\\\\\','\\\\\\\\');\\n    Set-Content -Path (Join-Path $ws 'SOUL.md') -Value $content -Encoding UTF8;\\n  }\\n  @\\\"\\n# AGENTS.md · 工作协议\\n\\n1. 接到任务先回复\\\"已接旨\\\"。\\n2. 