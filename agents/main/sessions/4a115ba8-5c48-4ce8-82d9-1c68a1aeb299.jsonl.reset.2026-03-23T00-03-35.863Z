se not found in code methods\\n        mentioned_like_method = [tk for tk in tks if tk.endswith(\\\"api\\\") or tk.endswith(\\\"service\\\") or tk.endswith(\\\"handler\\\")]\\n        for m in mentioned_like_method:\\n            if m not in all_methods:\\n                conflicts.append({\\n                    \\\"case_id\\\": case_id,\\n                    \\\"severity\\\": \\\"medium\\\",\\n                    \\\"type\\\": \\\"method_or_component_not_found_in_code\\\",\\n                    \\\"evidence\\\": m,\\n                })\\n\\n        # conflict heuristic 2: exception expectation while code has no exception path\\n        has_exception_expect = any(k in tks for k in [\\\"异常\\\", \\\"失败\\\", \\\"timeout\\\", \\\"error\\\", \\\"denied\\\", \\\"not\\\", \\\"fail\\\"])\\n        if has_exception_expect and not has_exception_path:\\n            conflicts.append({\\n                \\\"case_id\\\": case_id,\\n                \\\"severity\\\": \\\"low\\\",\\n                \\\"type\\\": \\\"exception_expected_but_code_has_no_explicit_exception_path\\\",\\n                \\\"evidence\\\": \\\"case expects exception-like behavior\\\",\\n            })\\n\\n        # conflict heuristic 3: if case condition tokens never overlap with code branch condition tokens\\n        if cond_tokens:\\n            overlap = len(tks & cond_tokens)\\n            if overlap == 0:\\n                conflicts.append({\\n                    \\\"case_id\\\": case_id,\\n                    \\\"severity\\\": \\\"low\\\",\\n                    \\\"type\\\": \\\"no_condition_overlap_with_code_branches\\\",\\n                    \\\"evidence\\\": \\\"no lexical overlap with extracted branch conditions\\\",\\n                })\\n\\n    report = {\\n        \\\"summary\\\": {\\n            \\\"total_cases\\\": len(cases),\\n            \\\"total_conflicts\\\": len(conflicts),\\n            \\\"high\\\": sum(1 for c in conflicts if c[\\\"severity\\\"] == \\\"high\\\"),\\n            \\\"