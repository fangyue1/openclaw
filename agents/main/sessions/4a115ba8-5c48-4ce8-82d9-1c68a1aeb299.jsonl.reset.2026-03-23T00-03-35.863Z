\"ー\",\n        \"表示された文言が仕様通りで誤字脱字がないことを確認できる。\",\n    ),\n    row_obj(\n        \"\",\n        \"マイページに「お問い合わせフォーム」をクリックする\",\n        \"ー\",\n        \"「お問い合わせフォーム」が崩れなく表示される\",\n    ),\n    row_obj(\n        \"\",\n        \"お問い合わせ区分・氏名・メールアドレス・お問い合わせ内容を右記の内容で入力する\",\n        \"お問い合わせ区分：その他\\n氏名：テスト太郎\\nメールアドレス：test@example.com\\nお問い合わせ内容：画面表示に関する問い合わせです。\",\n        \"各入力項目に有効値が入力できること。\",\n    ),\n    row_obj(\n        \"\",\n        \"「入力内容の確認」をクリックする\",\n        \"ー\",\n        \"「お問い合わせフォーム 入力内容の確認」画面に遷移する\",\n    ),\n    row_obj(\n        \"（正常系）「お問い合わせフォーム 入力内容の確認」STEP2\",\n        \"「入力画面へもどり修正する」をクリックする\",\n        \"ー\",\n        \"「お問い合わせフォーム」画面へ遷移する\",\n    ),\n    row_obj(\n        \"\",\n        \"「入力内容の確認」をクリックする\",\n        \"ー\",\n        \"「お問い合わせフォーム 入力内容の確認」が崩れなく表示される\",\n    ),\n    row_obj(\n        \"\",\n        \"「送信する」をクリックする\",\n        \"ー\",\n        \"「お問い合わせフォームの完了」画面に遷移し、完了メッセージと受付番号が表示されること。\",\n    ),\n    row_obj(\n        \"（正常系）「お問い合わせフォームの完了」STEP3\",\n        \"「トップページにもどる」をクリックする\",\n        \"ー\",\n        \"「トップページ」画面へ遷移する\",\n    ),\n]\n\nsrc_cases = json.loads(SRC_CASES.read_text(encoding=\"utf-8\"))\nabnormal_rows = []\nfor c in src_cases:\n    t = str(c.get(\"title\", \"\")).strip()\n    if \"正常系\" in t:\n        continue\n    if \"異常系\" not in t:\n        t = f\"（異常系）{t}\" if t else \"（異常系）入力チェック\"\n    abnormal_rows.append(\n        row_obj(\n            t,\n            str(c.get(\"steps\", \"入力内容の確認を押す\")).strip() or \"入力内容の確認を押す\",\n            str(c.get(\"precondition\", \"ー\")).strip() or \"ー\",\n            str(c.get(\"expected\", \"エラーメッセージが表示されること\")).strip() or \"エラーメッセージが表示されること\",\n        )\n    )\n\nrows = normal_rows + abnormal_rows\n\nwb = load_workbook(TEMPLATE)\nws = wb.active\n\n# full overwrite in data area\nfor r in range(DATA_START_ROW, ws.max_row + 1):\n    for c in COL.values():\n        write(ws, r, c, None)\n\nfor i, item in enumerate(rows, start=1):\n    rr = DATA_START_ROW + i - 1\n    write(ws, rr, COL[\"cat\"], \"お問い合わせフォーム\")\n    write(ws, rr, COL[\"id\"], f\"TC-{i:03d}\")\n    write(ws, rr, COL[\"title\"], item[\"title\"])\n    write(ws, rr, COL[\"steps\"], item[\"steps\"])\n    write(ws, rr, COL[\"pre\"], item[\"pre\"])\n    write(ws, rr, COL[\"exp\"], item[\"exp\"])\n    write(ws, rr, COL[\"res\"], item[\"res\"])\n\nwb.save(OUT)\nprint(f\"Wrote {OUT} rows={len(rows)} normal={len(normal_rows)} abnormal={len(abnormal_rows)}\")\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\tmp\\\\build_inquiry_v5.py\",\"content\":\"import json\\nfrom pathlib import Path\\nfrom openpyxl import load_workbook\\nfrom openpyxl.cell.cell import MergedCell\\n\\nTEMPLATE = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\【総務省様】_コールバック予約_単体テスト仕様書.xlsx\\\")\\nSRC_CASES = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\runs\\\\run-20260318-inquiryFormConfirm-v2clone\\\\cases.json\\\")\\nOUT = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\【総務省様】_お問い合わせフォーム_単体テスト仕様書_overwrite_v5.xlsx\\\")\\n\\nDATA_START_ROW = 8\\nCOL = {\\\"cat\\\": 1, \\\"id\\\": 2, \\\"title\\\": 3, \\\"steps\\\": 4, \\\"pre\\\": 6, \\\"exp\\\": 7, \\\"res\\\": 8}\\n\\n\\ndef resolve_writable_pos(ws, row, col):\\n    cell = ws.cell(row=row, column=col)\\n    if not isinstance(cell, MergedCell):\\n        return row, col\\n    for mr in ws.merged_cells.ranges:\\n        if mr.min_row <= row <= mr.max_row and mr.min_col <= col <= mr.max_col:\\n            return mr.min_row, mr.min_col\\n    return row, col\\n\\n\\ndef write(ws, row, col, value):\\n    r, c = resolve_writable_pos(ws, row, col)\\n    ws.cell(row=r, column=c, value=value)\\n\\n\\ndef row_obj(title, steps, pre=\\\"ー\\\", exp=\\\"\\\", res=\\\"OK\\\"):\\n    return {\\\"title\\\": title, \\\"steps\\\": steps, \\\"pre\\\": pre, \\\"exp\\\": exp, \\\"res\\\": res}\\n\\n\\n# Normal flow rewritten to match user's template style (STEP chain with continuation rows)\\nnormal_rows = [\\n    row_obj(\\n        \\\"（正常