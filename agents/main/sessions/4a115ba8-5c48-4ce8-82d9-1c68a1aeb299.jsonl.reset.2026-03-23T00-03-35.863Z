d = json.loads(Path(args.design).read_text(encoding=\"utf-8\"))\n\n    if isinstance(cases_payload, dict) and \"cases\" in cases_payload:\n        cases = cases_payload[\"cases\"]\n        wrapped = True\n    else:\n        cases = cases_payload\n        wrapped = False\n\n    rules = design_payload.get(\"field_rules\", [])\n\n    enriched = []\n    for case in cases:\n        if not isinstance(case, dict):\n            enriched.append(case)\n            continue\n\n        best = None\n        for r in rules:\n            s = score_case_to_rule(case, r)\n            if best is None or s > best[\"score\"]:\n                best = {\"score\": s, \"rule\": r}\n\n        source_refs = case.get(\"source_refs\") or []\n        confidence = case.get(\"confidence\")\n\n        if best and best[\"score\"] >= args.min_auto_confidence:\n            if not source_refs:\n                source_refs = [to_source_ref(best[\"rule\"])]\n            if confidence is None:\n                confidence = round(min(0.95, max(0.35, best[\"score\"] + 0.25)), 3)\n        else:\n            if confidence is None:\n                confidence = 0.5\n\n        case[\"source_refs\"] = source_refs\n        case[\"confidence\"] = confidence\n        enriched.append(case)\n\n    out_payload = {\"cases\": enriched} if wrapped else enriched\n    Path(args.out).write_text(json.dumps(out_payload, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\enrich_cases_with_evidence.py\",\"content\":\"import argparse\\nimport json\\nimport re\\nfrom pathlib import Path\\n\\n\\ndef tokenize(v: str):\\n    parts = re.split(r\\\"[\\\\s\\\\u3000\\\\n\\\\r\\\\t:：、。・（）()\\\\[\\\\]【】「」/\\\\\\\\\\\\-_,]+\\\", str(v or \\\"\\\").lower())\\n    return {p for p in parts if p}\\n\\n\\ndef score_case_to_rule(case_obj, rule_obj):\\n    case_text = \\\" \\\".join([\\n        str(case_obj.get(\\\"title\\\", \\\"\\\")),\\n        str(case_obj.get(\\\"steps\\\", \\\"\\\")),\\n        str(case_obj.get(\\\"expected\\\", \\\"\\\")),\\n        str(case_obj.get(\\\"precondition\\\", \\\"\\\")),\\n    ])\\n    rule_text = str(rule_obj.get(\\\"raw\\\", \\\"\\\"))\\n\\n    ct = tokenize(case_text)\\n    rt = tokenize(rule_text)\\n    if not ct or not rt:\\n        return 0.0\\n    return len(ct & rt) / max(len(ct), 1)\\n\\n\\ndef to_source_ref(rule_obj):\\n    cells = rule_obj.get(\\\"cells\\\", [])\\n    first_cell = cells[0] if cells else None\\n    return {\\n        \\\"sheet\\\": rule_obj.get(\\\"sheet\\\"),\\n        \\\"cell\\\": first_cell,\\n        \\\"cells\\\": cells[:5],\\n        \\\"kind\\\": \\\"design_field_rule\\\",\\n    }\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser(description=\\\"Enrich cases with source_refs/confidence from design rules\\\")\\n    ap.add_argument(\\\"--cases\\\", required=True)\\n    ap.add_argument(\\\"--design\\\", required=True)\\n    ap.add_argument(\\\"--out\\\", required=True)\\n    ap.add_argument(\\\"--min-auto-confidence\\\", type=float, default=0.45)\\n    args = ap.parse_args()\\n\\n    cases_payload = json.loads(Path(args.cases).read_text(encoding=\\\"utf-8\\\"))\\n    design_payload = json.loads(Path(args.design).read_text(encoding=\\\"utf-8\\\"))\\n\\n    if isinstance(cases_payload, dict) and \\\"cases\\\" in cases_payload:\\n        cases = cases_payload[\\\"cases\\\"]\\n        wrapped = True\\n    else:\\n        cases = cases_payload\\n        wrapped = False\\n\\n    rules = design_payload.get(\\\"field_rules\\\", [])\\n\\n    enriched = []\\n    for case in cases:\\n        if not isinstance(case, dict):\\n            enriched.append(case)\\n            continue\\n\\n        best = None\\n        for r in rules:\\n            s = score_case_to_rule(case, r)\\n            if best is None or s > best[\\\"score\\\"]:\\n          