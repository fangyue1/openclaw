se SystemExit('template xlsx not found')\nout=ws/'runs'/'run-20260318-inquiryFormConfirm'\nout.mkdir(parents=True, exist_ok=True)\ncmd=[sys.executable,\n    str(ws/'skills/web-unit-testbook/scripts/run_pipeline.py'),\n    '--design', str(design),\n    '--code', str(code),\n    '--template', str(template),\n    '--outdir', str(out),\n    '--mode','high-precision',\n    '--export-mode','template-first',\n    '--data-start-row','8',\n    '--match-threshold','0.20',\n    '--quality-gate','warn',\n    '--min-confidence','0.70',\n    '--multi-sheet-route','auto',\n    '--strict-source-refs','on',\n    '--audit-conflicts','on']\nprint('DESIGN=',design)\nprint('CODE=',code)\nprint('TEMPLATE=',template)\nprint('OUT=',out)\nres=subprocess.run(cmd,cwd=str(ws))\nraise SystemExit(res.returncode)\nPY","workdir":"C:\\Users\\吗喽\\.openclaw\\workspace","yieldMs":120000},"partialJson":"{\"command\":\"python - <<'PY'\\nimport pathlib, subprocess, sys\\nbase=pathlib.Path(r'C:\\\\Users\\\\吗喽\\\\.openclaw')\\nws=pathlib.Path(r'C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace')\\n# resolve inputs\\ncands=list(base.glob('*.xlsx'))\\ndesign=None\\nfor p in cands:\\n    if 'お問い合わせフォーム画面設計書' in p.name or '問い合わせフォーム画面設計書' in p.name:\\n        design=p; break\\nif design is None:\\n    raise SystemExit('design xlsx not found')\\ncode=base/'inquiryFormConfirm.zip'\\nif not code.exists():\\n    raise SystemExit('code zip not found')\\n# template preference: inquiry template -> callback template -> any unit test template\\ntemplate=None\\nfor p in cands:\\n    if ('お問い合わせフォーム' in p.name or '問い合わせフォーム' in p.name) and '単体テスト仕様書' in p.name:\\n        template=p; break\\nif template is None:\\n    for p in cands:\\n        if 'コールバック予約' in p.name and '単体テスト仕様書' in p.name:\\n            template=p; break\\nif template is None:\\n    for p in cands:\\n        if '単体テスト仕様書' in p.name:\\n            template=p; break\\nif template is None:\\n    raise SystemExit('template xlsx not found')\\nout=ws/'runs'/'run-2