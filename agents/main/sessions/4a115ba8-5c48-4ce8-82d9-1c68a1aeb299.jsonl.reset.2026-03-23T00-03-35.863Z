start_row):\n            for key, col in cols.items():\n                fill_cell(ws, i, col, case.get(key, \"\"))\n    else:\n        rows = template_rows(ws, cols, args.data_start_row)\n\n        unmatched = []\n        for case in cases:\n            best = None\n            for r in rows:\n                if r[\"used\"]:\n                    continue\n                s = similarity(case, r)\n                if best is None or s > best[\"score\"]:\n                    best = {\"row\": r, \"score\": s}\n            if best and best[\"score\"] >= args.match_threshold:\n                target = best[\"row\"]\n                target[\"used\"] = True\n                row_no = target[\"row\"]\n\n                # Keep template style: do not overwrite steps/title by default\n                if cols.get(\"precondition\"):\n                    fill_cell(ws, row_no, cols[\"precondition\"], case.get(\"precondition\", \"\"), only_if_empty=True)\n                if cols.get(\"expected\"):\n                    fill_cell(ws, row_no, cols[\"expected\"], case.get(\"expected\", \"\"), only_if_empty=True)\n                if cols.get(\"case_id\"):\n                    fill_cell(ws, row_no, cols[\"case_id\"], case.get(\"case_id\", \"\"), only_if_empty=True)\n            else:\n                unmatched.append(case)\n\n        append_row = max(ws.max_row + 1, args.data_start_row)\n        for case in unmatched:\n            for key, col in cols.items():\n                fill_cell(ws, append_row, col, case.get(key, \"\"))\n            append_row += 1\n\n    wb.save(args.out)\n    print(f\"Wrote {args.out}\")\n","new_string":"    # Cache worksheet column/header detection so each sheet can be routed independently\n    sheet_meta = {}\n\n    def get_meta(target_ws):\n        if target_ws.title not in sheet_meta:\n            m_cols, m_header_row = detect_columns(target_ws)\n            if not m_cols:\n                m_cols = {k: i + 1 for i, k in enumerate(FALLBACK_ORDER)}\n            