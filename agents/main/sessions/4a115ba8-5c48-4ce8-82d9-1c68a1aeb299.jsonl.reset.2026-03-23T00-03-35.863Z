gh-precision --export-mode template-first --data-start-row 8 --match-threshold 0.20 --quality-gate fail --min-confidence 0.70\n ```\n \n ## Outputs\n@@ -53,9 +61,12 @@ python scripts/run_pipeline.py --design <design.xlsx> --code <code_dir_or_zip> -\n - `cases.json`\n - `UnitTestSpec.md`\n - `unit_test_book.xlsx`\n+- `quality_report.json`\n \n ## References\n \n - `references/knowledge-base.md`\n - `references/templates/`\n-- `references/rules/`\n+- `references/rules/template-first-policy.md`\n+- `references/rules/design-first-code-assist-policy.md`\n+- `references/rules/image-to-case-mapping-rules-v1.yaml`\ndiff --git a/skills/web-unit-testbook/scripts/run_pipeline.py b/skills/web-unit-testbook/scripts/run_pipeline.py\nindex 79d241e..925af99 100644\n--- a/skills/web-unit-testbook/scripts/run_pipeline.py\n+++ b/skills/web-unit-testbook/scripts/run_pipeline.py\n@@ -48,6 +48,18 @@ def main():\n         default=0.20,\n         help=\"Similarity threshold for template-first alignment.\",\n     )\n+    ap.add_argument(\n+        \"--quality-gate\",\n+        choices=[\"off\", \"warn\", \"fail\"],\n+        default=\"warn\",\n+        help=\"Quality gate for generated cases (source_refs/confidence).\",\n+    )\n+    ap.add_argument(\n+        \"--min-confidence\",\n+        type=float,\n+        default=0.70,\n+        help=\"Minimum confidence accepted by quality gate.\",\n+    )\n     args = ap.parse_args()\n \n     if args.mode == \"high-precision\" and not args.code:\n@@ -108,6 +120,20 @@ def main():\n             str(cases_json),\n         ])\n \n+    quality_report = outdir / \"quality_report.json\"\n+    run([\n+        \"python\",\n+        str(skill_dir / \"scripts\" / \"quality_gate_cases.py\"),\n+        \"--cases\",\n+        str(cases_json),\n+        \"--mode\",\n+        args.quality_gate,\n+        \"--min-confidence\",\n+        str(args.min_confidence),\n+        \"--report\",\n+        str(quality_report),\n+    ])\n+\n     run([\n         \"python\",\n 