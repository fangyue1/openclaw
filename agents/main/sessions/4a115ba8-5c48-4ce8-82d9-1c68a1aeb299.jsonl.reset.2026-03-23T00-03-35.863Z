e_counter = Counter()\ncase_rows = []\n\nfor r in issues:\n    cid = r.get('case_id')\n    details = r.get('issue_details', [])\n    codes = []\n    for it in details:\n        if isinstance(it, dict):\n            c = it.get('code')\n            if c:\n                code_counter[c] += 1\n                codes.append(c)\n    if not codes:\n        for c in r.get('issues', []):\n            code_counter[c] += 1\n            codes.append(c)\n    case_rows.append((cid, sorted(set(codes)), r.get('confidence')))\n\ncase_rows.sort(key=lambda x: (-len(x[1]), (1e9 if x[2] is None else x[2]), str(x[0])))\n\nout = {\n    'report': p,\n    'total_cases': d.get('total_cases'),\n    'cases_with_issues': d.get('cases_with_issues'),\n    'low_confidence_cases': d.get('low_confidence_cases'),\n    'top_issue_codes': code_counter.most_common(),\n    'top20_cases': [\n        {'case_id': cid, 'confidence': conf, 'issue_codes': codes}\n        for cid, codes, conf in case_rows[:20]\n    ],\n}\n\nwith open('tmp/top20_quality_issues.json', 'w', encoding='utf-8') as f:\n    json.dump(out, f, ensure_ascii=False, indent=2)\n\nprint('Wrote tmp/top20_quality_issues.json')\nprint('Top issue codes:', code_counter.most_common(10))\nprint('Top20 sample count:', len(out['top20_cases']))\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\tmp\\\\summarize_quality_issues.py\",\"content\":\"import json\\nfrom collections import Counter\\n\\np = 'tmp/quality_report_enriched.strict.json'\\nwith open(p, encoding='utf-8') as f:\\n    d = json.load(f)\\n\\nissues = d.get('issues', [])\\ncode_counter = Counter()\\ncase_rows = []\\n\\nfor r in issues:\\n    cid = r.get('case_id')\\n    details = r.get('issue_details', [])\\n    codes = []\\n    for it in details:\\n        if isinstance(it, dict):\\n            c = it.get('code')\\n            if c:\\n                code_counter[c] += 1\\n                codes.append(c)\\n    if not codes:\\n        for c in r.get('issues'