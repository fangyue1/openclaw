{"type":"message","id":"e217208f","parentId":"bb05d864","timestamp":"2026-03-18T04:19:28.045Z","message":{"role":"toolResult","toolCallId":"call_mF3WgJebwURIPOdLB4swUu4b|fc_0901a5004ef7d5000169ba27caeaf88191b67ca153e1bbc965","toolName":"read","content":[{"type":"text","text":"import argparse\nimport subprocess\nfrom pathlib import Path\n\n\ndef run(cmd):\n    print(\"[RUN]\", \" \".join(cmd))\n    subprocess.check_call(cmd)\n\n\ndef main():\n    skill_dir = Path(__file__).resolve().parents[1]\n    workspace_root = Path(__file__).resolve().parents[3]\n\n    ap = argparse.ArgumentParser(\n        description=\"Unified pipeline entry for web-unit-testbook\"\n    )\n    ap.add_argument(\"--design\", required=True, help=\"Design workbook (.xlsx)\")\n    ap.add_argument(\"--code\", help=\"Code folder or zip (required for high-precision mode)\")\n    ap.add_argument(\n        \"--template\",\n        default=str(workspace_root / \"samples\" / \"template\" / \"template_v3_confirmed.xlsx\"),\n        help=\"Unit test book template (.xlsx)\",\n    )\n    ap.add_argument(\"--outdir\", required=True, help=\"Output directory\")\n    ap.add_argument(\"--ocr-lang\", default=\"\", help=\"Optional OCR language (e.g. jpn+eng)\")\n    ap.add_argument(\n        \"--mode\",\n        choices=[\"high-precision\", \"ui-only\"],\n        default=\"high-precision\",\n        help=\"Generation mode\",\n    )\n    ap.add_argument(\n        \"--export-mode\",\n        choices=[\"template-first\", \"append\"],\n        default=\"template-first\",\n        help=\"Excel export strategy. template-first keeps existing template rows and fills semantically.\",\n    )\n    ap.add_argument(\n        \"--data-start-row\",\n        type=int,\n        default=8,\n        help=\"First data row for template-first export mode.\",\n    )\n    ap.add_argument(\n        \"--match-threshold\",\n        type=float,\n        default=0.20,\n        help=\"Similarity threshold for template-first alignment.\",\n    )\n    ap.add_argument(\n        \"--quality-gate\",\n        choices=[\"off\", \"warn\", \"fail\"],\n        default=\"warn\",\n        help=\"Quality gate for generated cases (source_refs/confidence).\",\n    )\n    ap.add_argument(\n        \"--min-confidence\",\n        type=float,\n        default=0.70,\n        help=\"Minimum confidence accepted by quality gate.\",\n    )\n    ap.add_argument(\n        \"--multi-sheet-route\",\n        choices=[\"off\", \"auto\"],\n        default=\"auto\",\n        help=\"Route cases to target worksheets when possible.\",\n    )\n    ap.add_argument(\n        \"--audit-conflicts\",\n        choices=[\"off\", \"on\"],\n        default=\"on\",\n        help=\"Generate design-vs-code advisory conflict report in high-precision mode.\",\n    )\n    args = ap.parse_args()\n\n    if args.mode == \"high-precision\" and not args.code:\n        ap.error(\"--code is required when --mode high-precision\")\n\n    outdir = Path(args.outdir)\n    outdir.mkdir(parents=True, exist_ok=True)\n\n    design_json = outdir / \"design_rules.json\"\n    code_json = outdir / \"code_rules.json\"\n    cases_json = outdir / \"cases.json\"\n    enriched_cases_json = outdir / \"cases.enriched.json\"\n    md = outdir / \"UnitTestSpec.md\"\n    xlsx = outdir / \"unit_test_book.xlsx\"\n\n    cmd1 = [\n        \"python\",\n        str(skill_dir / \"scripts\" / \"parse_design_excel.py\"),\n        \"--input\",\n        args.design,\n        \"--out\",\n        str(design_json),\n    ]\n    if args.ocr_lang:\n        cmd1 += [\"--ocr-lang\", args.ocr_lang]\n\n    run(cmd1)\n\n    if args.mode == \"high-precision\":\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"extract_code_rules.py\"),\n            \"--src\",\n            args.code,\n            \"--out\",\n            str(code_json),\n        ])\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"generate_high_precision.py\"),\n            \"--design\",\n            str(design_json),\n            \"--code\",\n            str(code_json),\n            \"--out-md\",\n            str(md),\n            \"--out-cases\",\n            str(cases_json),\n        ])\n    else:\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"generate_ui_only_cases.py\"),\n            \"--design\",\n            str(design_json),\n            \"--out-md\",\n            str(md),\n            \"--out-cases\",\n            str(cases_json),\n        ])\n\n    run([\n        \"python\",\n        str(skill_dir / \"scripts\" / \"enrich_cases_with_evidence.py\"),\n        \"--cases\",\n        str(cases_json),\n        \"--design\",\n        str(design_json),\n        \"--out\",\n        str(enriched_cases_json),\n    ])\n\n    conflict_report = outdir / \"conflict_audit.json\"\n    if args.mode == \"high-precision\" and args.audit_conflicts == \"on\":\n        run([\n            \"python\",\n            str(skill_dir / \"scripts\" / \"audit_design_code_conflicts.py\"),\n            \"--cases\",\n            str(enriched_cases_json),\n            \"--code\",\n            str(code_json),\n            \"--out\",\n            str(conflict_report),\n        ])\n\n    quality_report = outdir / \"quality_report.json\"\n    run([\n        \"python\",\n        str(skill_dir / \"scripts\" / \"quality_gate_cases.py\"),\n        \"--cases\",\n        str(enriched_cases_json),\n        \"--mode\",\n        args.quality_gate,\n        \"--min-confidence\",\n        str(args.min_confidence),\n        \"--report\",\n        str(quality_report),\n    ])\n\n    run([\n        \"python\",\n        str(skill_dir / \"scripts\" / \"export_to_excel.py\"),\n        \"--template\",\n        args.template,\n        \"--cases\",\n        str(enriched_cases_json),\n        \"--out\",\n        str(xlsx),\n        \"--export-mode\",\n        args.export_mode,\n        \"--data-start-row\",\n        str(args.data_start_row),\n        \"--match-threshold\",\n        str(args.match_threshold),\n        \"--multi-sheet-route\",\n        str(args.multi_sheet_route),\n    ])\n\n    print(f\"Done. Mode={args.mode}. Outputs in: {outdir} (quality report: {quality_report.name})\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1773807568042}}
