   if isinstance(value, list):\n        return value\n    return [value]\n\n\ndef to_float_or_none(value):\n    if value is None:\n        return None\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            return None\n    return None\n\n\ndef _non_empty_string(v):\n    return isinstance(v, str) and v.strip() != \"\"\n\n\ndef validate_source_ref_item(item, strict_source_refs=True):\n    errs = []\n\n    if isinstance(item, str):\n        if strict_source_refs:\n            errs.append(\"source_ref_invalid_type_string\")\n        elif not item.strip():\n            errs.append(\"source_ref_empty_string\")\n        return errs\n\n    if not isinstance(item, dict):\n        errs.append(\"source_ref_invalid_type\")\n        return errs\n\n    if strict_source_refs:\n        sheet = item.get(\"sheet\")\n        if not _non_empty_string(sheet):\n            errs.append(\"source_ref_missing_sheet\")\n\n    has_locator = False\n    for k in LOCATOR_KEYS:\n        if k in item and item[k] is not None:\n            v = item[k]\n            if isinstance(v, str):\n                if v.strip():\n                    has_locator = True\n            elif isinstance(v, (int, float)):\n                has_locator = True\n\n    if strict_source_refs and not has_locator:\n        errs.append(\"source_ref_missing_locator\")\n\n    return errs\n\n\ndef evaluate_case(case_obj, idx, min_confidence, strict_source_refs=True):\n    issue_codes = []\n    source_ref_errors = []\n\n    source_refs_raw = first_value(case_obj, SOURCE_REF_KEYS)\n    source_refs = as_ref_list(source_refs_raw)\n    confidence = to_float_or_none(first_value(case_obj, CONFIDENCE_KEYS))\n    case_id = str(first_value(case_obj, ID_KEYS) or f\"idx_{idx}\")\n\n    if not source_refs:\n        issue_codes.append(\"missing_source_refs\")\n    else:\n        for ridx, ref_item in enumerate(source_refs):\n            errs = validate_source_ref_item(ref_item, strict_source_refs=strict_source_refs)\n            for e in errs:\n                source_ref_errors.append({\"ref_index\": ridx, \"code\": e})\n\n        if source_ref_errors:\n            issue_codes.append(\"invalid_source_refs\")\n\n    if confidence is None:\n        issue_codes.append(\"missing_confidence\")\n    else:\n        if not (0.0 <= confidence <= 1.0):\n            issue_codes.append(\"invalid_confidence_range\")\n        elif confidence < min_confidence:\n            issue_codes.append(\"low_confidence\")\n\n    details = []\n    for code in issue_codes:\n        details.append({\"code\": code})\n    for e in source_ref_errors:\n        details.append({\"code\": e[\"code\"], \"ref_index\": e[\"ref_index\"]})\n\n    return {\n        \"case_id\": case_id,\n        \"issues\": issue_codes,\n        \"issue_details\": details,\n        \"confidence\": confidence,\n    }\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Quality gate for generated cases.json\")\n    ap.add_argument(\"--cases\", required=True, help=\"Path to cases.json\")\n    ap.add_argument(\"--mode\", choices=[\"off\", \"warn\", \"fail\"], default=\"warn\")\n    ap.add_argument(\"--min-confidence\", type=float, default=0.70)\n    ap.add_argument(\"--strict-source-refs\", choices=[\"off\", \"on\"], default=\"on\")\n    ap.add_argument(\"--report\", help=\"Optional path for JSON report\")\n    args = ap.parse_args()\n\n    if args.mode == \"off\":\n        print(\"[QUALITY] gate disabled\")\n        return\n\n    p = Path(args.cases)\n    data = json.loads(p.read_text(encoding=\"utf-8\"))\n    if isinstance(data, dict) and \"cases\" in data:\n        cases = data[\"cases\"]\n    elif isinstance(data, list):\n        cases = data\n    else:\n        raise ValueError(\"Unsupported cases payload: expected list or {'cases': [...]}.\")\n\n    results = []\n    issue_count = 0\n    low_confidence_count = 0\n\n    strict_source_refs = args.strict_source_refs == \"on\"\n\n    for i, case in enumerate(cases):\n        if not isinstance(case, dict):\n            results.append(\n                {\n                    \"case_id\": f\"idx_{i}\",\n                    \"issues\": [\"invalid_case_object\"],\n                    \"issue_details\": [{\"code\": \"invalid_case_object\"}],\n                    \"confidence\": None,\n                }\n            )\n            issue_count += 1\n            continue\n\n        r = evaluate_case(case, i, args.min_confidence, strict_source_refs=strict_source_refs)\n        if r[\"issues\"]:\n            issue_count += 1\n            if \"low_confidence\" in r[\"issues\"]:\n                low_confidence_count += 1\n        results.append(r)\n\n    summary = {\n        \"mode\": args.mode,\n        \"min_confidence\": args.min_confidence,\n        \"strict_source_refs\": strict_source_refs,\n        \"total_cases\": len(cases),\n        \"cases_with_issues\": issue_count,\n        \"low_confidence_cases\": low_confidence_count,\n        \"passed\": issue_count == 0,\n        \"issues\": [r for r in results if r[\"issues\"]],\n    }\n\n    if args.report:\n        Path(args.report).write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n    print(\n        f\"[QUALITY] total={summary['total_cases']} issues={summary['cases_with_issues']} \"\n        f\"low_conf={summary['low_confidence_cases']} strict_refs={str(summary['strict_source_refs']).lower()}\"\n    )\n\n    if args.mode == \"fail\" and summary[\"cases_with_issues\"] > 0:\n        print(\"[QUALITY] failed: blocking export because quality gate mode=fail\")\n        sys.exit(2)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\quality_gate_cases.py\",\"content\":\"import argparse\\nimport json\\nimport sys\\nfrom pathlib import Pa