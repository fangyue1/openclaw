h(r\"C:\\Users\\吗喽\\.openclaw\\【総務省様】_お問い合わせフォーム_単体テスト仕様書_overwrite_v3.xlsx\")\n\nDATA_START_ROW = 8\nCOLS = {\n    \"category\": 1,\n    \"case_id\": 2,\n    \"title\": 3,\n    \"steps\": 4,\n    \"precondition\": 6,\n    \"expected\": 7,\n}\n\n\ndef resolve_writable_pos(ws, row, col):\n    cell = ws.cell(row=row, column=col)\n    if not isinstance(cell, MergedCell):\n        return row, col\n    for mr in ws.merged_cells.ranges:\n        if mr.min_row <= row <= mr.max_row and mr.min_col <= col <= mr.max_col:\n            return mr.min_row, mr.min_col\n    return row, col\n\n\ndef write_cell(ws, row, col, value):\n    r, c = resolve_writable_pos(ws, row, col)\n    ws.cell(row=r, column=c, value=value)\n\n\nwb = load_workbook(TEMPLATE)\nws = wb.active\ncases = json.loads(CASES.read_text(encoding=\"utf-8\"))\n\n# 1) clear old generated rows completely in target columns\nfor r in range(DATA_START_ROW, ws.max_row + 1):\n    for c in COLS.values():\n        write_cell(ws, r, c, None)\n\n# 2) refill from scratch\nrow = DATA_START_ROW\nfor c in cases:\n    write_cell(ws, row, COLS[\"category\"], \"お問い合わせフォーム\")\n    write_cell(ws, row, COLS[\"case_id\"], c.get(\"case_id\", \"\"))\n    write_cell(ws, row, COLS[\"title\"], c.get(\"title\", \"\"))\n    write_cell(ws, row, COLS[\"steps\"], c.get(\"steps\", \"\"))\n    write_cell(ws, row, COLS[\"precondition\"], c.get(\"precondition\", \"\"))\n    write_cell(ws, row, COLS[\"expected\"], c.get(\"expected\", \"\"))\n    row += 1\n\nwb.save(OUT)\nprint(f\"Wrote {OUT} rows={len(cases)}\")\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\tmp\\\\overwrite_template_with_inquiry_cases.py\",\"content\":\"import json\\nfrom pathlib import Path\\nfrom openpyxl import load_workbook\\nfrom openpyxl.cell.cell import MergedCell\\n\\nTEMPLATE = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\【総務省様】_コールバック予約_単体テスト仕様書.xlsx\\\")\\nCASES = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\runs\\\\run-20260318-