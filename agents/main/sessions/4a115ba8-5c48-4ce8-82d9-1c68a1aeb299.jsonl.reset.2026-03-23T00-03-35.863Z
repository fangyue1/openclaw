{"type":"message","id":"62d0e3b4","parentId":"903781a1","timestamp":"2026-03-18T07:57:45.912Z","message":{"role":"toolResult","toolCallId":"call_fYD0hsygTM6qMNt0FQ2ePdXs|fc_0879783320f7d1800169ba5af4402481919ff3144e717572be","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nimport re\nfrom pathlib import Path\n\nfrom openpyxl import load_workbook\nfrom openpyxl.cell.cell import MergedCell\n\n\nHEADER_KEYWORDS = {\n    \"case_id\": [\"case\", \"caseid\", \"编号\", \"id\", \"No\"],\n    \"category\": [\"category\", \"分類\", \"分类\", \"大分類\"],\n    \"title\": [\"title\", \"标题\", \"試験項目\", \"测试项\", \"小分類\"],\n    \"precondition\": [\"precondition\", \"前提\", \"前置\", \"テスト条件\"],\n    \"steps\": [\"steps\", \"手順\", \"步骤\", \"確認手順\"],\n    \"expected\": [\"expected\", \"期待\", \"预期\", \"想定結果\"],\n    \"priority\": [\"priority\", \"优先\", \"優先\"],\n}\n\nFALLBACK_ORDER = [\"case_id\", \"category\", \"title\", \"precondition\", \"steps\", \"expected\", \"priority\"]\n\n\ndef normalize(v):\n    return str(v or \"\").strip().lower().replace(\" \", \"\")\n\n\ndef tokenize(v: str):\n    txt = str(v or \"\")\n    parts = re.split(r\"[\\s\\u3000\\n\\r\\t:：、。・（）()\\[\\]【】「」/\\\\\\-_,]+\", txt)\n    return {p for p in parts if p}\n\n\ndef detect_columns(ws):\n    best_row, best_cols = 1, {}\n    for row in ws.iter_rows(min_row=1, max_row=min(30, ws.max_row)):\n        cols = {}\n        for c in row:\n            nv = normalize(c.value)\n            for key, kws in HEADER_KEYWORDS.items():\n                if key in cols:\n                    continue\n                if any(normalize(k) in nv for k in kws):\n                    cols[key] = c.column\n        if len(cols) > len(best_cols):\n            best_cols = cols\n            best_row = row[0].row\n    return best_cols, best_row\n\n\ndef resolve_writable_pos(ws, row, col):\n    cell = ws.cell(row=row, column=col)\n    if not isinstance(cell, MergedCell):\n        return row, col\n    for mr in ws.merged_cells.ranges:\n        if mr.min_row <= row <= mr.max_row and mr.min_col <= col <= mr.max_col:\n            return mr.min_row, mr.min_col\n    return row, col\n\n\ndef row_has_content(ws, row, cols):\n    probe_keys = [\"title\", \"steps\", \"precondition\", \"expected\"]\n    for k in probe_keys:\n        col = cols.get(k)\n        if not col:\n            continue\n        if str(ws.cell(row=row, column=col).value or \"\").strip():\n            return True\n    return False\n\n\ndef similarity(case, row_data):\n    ctext = \" \".join([\n        str(case.get(\"title\", \"\")),\n        str(case.get(\"steps\", \"\")),\n        str(case.get(\"expected\", \"\")),\n    ])\n    rtext = \" \".join([\n        str(row_data.get(\"title\", \"\")),\n        str(row_data.get(\"steps\", \"\")),\n        str(row_data.get(\"expected\", \"\")),\n    ])\n    ct = tokenize(ctext)\n    rt = tokenize(rtext)\n    if not ct or not rt:\n        return 0.0\n    inter = len(ct & rt)\n    return inter / max(len(ct), 1)\n\n\ndef template_rows(ws, cols, start_row):\n    rows = []\n    max_row = ws.max_row\n    for r in range(start_row, max_row + 1):\n        if not row_has_content(ws, r, cols):\n            continue\n        rows.append({\n            \"row\": r,\n            \"title\": ws.cell(r, cols.get(\"title\", 3)).value or \"\",\n            \"steps\": ws.cell(r, cols.get(\"steps\", 4)).value or \"\",\n            \"precondition\": ws.cell(r, cols.get(\"precondition\", 6)).value or \"\",\n            \"expected\": ws.cell(r, cols.get(\"expected\", 7)).value or \"\",\n            \"used\": False,\n        })\n    return rows\n\n\ndef fill_cell(ws, row, col, value, only_if_empty=False):\n    r, c = resolve_writable_pos(ws, row, col)\n    if only_if_empty and str(ws.cell(r, c).value or \"\").strip():\n        return\n    ws.cell(row=r, column=c, value=value)\n\n\ndef choose_target_sheet(case_obj, workbook, active_ws):\n    target_name = case_obj.get(\"target_sheet\")\n    if target_name and target_name in workbook.sheetnames:\n        return workbook[target_name]\n\n    refs = case_obj.get(\"source_refs\") or []\n    if isinstance(refs, dict):\n        refs = [refs]\n    for r in refs:\n        if isinstance(r, dict):\n            s = r.get(\"sheet\")\n            if s and s in workbook.sheetnames:\n                return workbook[s]\n    return active_ws\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--template\", required=True)\n    ap.add_argument(\"--cases\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\n        \"--export-mode\",\n        choices=[\"append\", \"template-first\"],\n        default=\"template-first\",\n        help=\"append: write sequentially after header; template-first: keep template structure and fill by semantic alignment.\",\n    )\n    ap.add_argument(\"--data-start-row\", type=int, default=8, help=\"First template data row for template-first mode\")\n    ap.add_argument(\"--match-threshold\", type=float, default=0.20, help=\"Minimum similarity to align a case to existing template row\")\n    ap.add_argument(\"--multi-sheet-route\", choices=[\"off\", \"auto\"], default=\"auto\")\n    args = ap.parse_args()\n\n    cases_payload = json.loads(Path(args.cases).read_text(encoding=\"utf-8\"))\n    cases = cases_payload.get(\"cases\", cases_payload) if isinstance(cases_payload, dict) else cases_payload\n    wb = load_workbook(args.template)\n    ws = wb.active\n\n    # Cache worksheet column/header detection so each sheet can be routed independently\n    sheet_meta = {}\n\n    def get_meta(target_ws):\n        if target_ws.title not in sheet_meta:\n            m_cols, m_header_row = detect_columns(target_ws)\n            if not m_cols:\n                m_cols = {k: i + 1 for i, k in enumerate(FALLBACK_ORDER)}\n                m_header_row = 1\n                for k, col in m_cols.items():\n                    target_ws.cell(row=1, column=col, value=k)\n            m_rows = template_rows(target_ws, m_cols, args.data_start_row)\n            sheet_meta[target_ws.title] = {\"cols\": m_cols, \"header_row\": m_header_row, \"rows\": m_rows}\n        return sheet_meta[target_ws.title]\n\n    for case in cases:\n        target_ws = ws\n        if args.multi_sheet_route == \"auto\":\n            target_ws = choose_target_sheet(case, wb, ws)\n\n        meta = get_meta(target_ws)\n        cols = meta[\"cols\"]\n        header_row = meta[\"header_row\"]\n\n        if args.export_mode == \"append\":\n            append_row = max(target_ws.max_row + 1, header_row + 1)\n            for key, col in cols.items():\n                fill_cell(target_ws, append_row, col, case.get(key, \"\"))\n            continue\n\n        rows = meta[\"rows\"]\n        best = None\n        for r in rows:\n            if r[\"used\"]:\n                continue\n            s = similarity(case, r)\n            if best is None or s > best[\"score\"]:\n                best = {\"row\": r, \"score\": s}\n\n        if best and best[\"score\"] >= args.match_threshold:\n            target = best[\"row\"]\n            target[\"used\"] = True\n            row_no = target[\"row\"]\n\n            if cols.get(\"precondition\"):\n                fill_cell(target_ws, row_no, cols[\"precondition\"], case.get(\"precondition\", \"\"), only_if_empty=True)\n            if cols.get(\"expected\"):\n                fill_cell(target_ws, row_no, cols[\"expected\"], case.get(\"expected\", \"\"), only_if_empty=True)\n            if cols.get(\"case_id\"):\n                fill_cell(target_ws, row_no, cols[\"case_id\"], case.get(\"case_id\", \"\"), only_if_empty=True)\n        else:\n            append_row = max(target_ws.max_row + 1, args.data_start_row)\n            for key, col in cols.items():\n                fill_cell(target_ws, append_row, col, case.get(key, \"\"))\n\n    wb.save(args.out)\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1773820665907}}
