\": title, \"steps\": steps, \"pre\": pre, \"exp\": exp, \"res\": res}\n\n\n# Normal flow: aligned to design workbook screen names (Step1/2/3 labels)\nnormal_rows = [\n    row_obj(\n        \"（正常系）「お問い合わせフォーム入力画面」STEP1\",\n        \"以下を開く\\nhttps://e-census2026--dev.sandbox.my.site.com/s/InquiryForm\\nポータルサイト確認\",\n        \"ー\",\n        \"表示された文言が仕様通りで誤字脱字がないことを確認できる。\",\n    ),\n    row_obj(\"\", \"マイページの「お問い合わせフォーム」をクリックする\", \"ー\", \"「お問い合わせフォーム入力画面」が崩れなく表示される\"),\n    row_obj(\n        \"\",\n        \"申請者の情報　右記の内容で入力する\",\n        \"申請者の氏名：方\\n申請者の部署名：部署\\n申請者の電話番号：07044772036\\n申請者のメールアドレス：etsu.hou@grids.co.jp\\n市区町村コード：11111\\n調査区番号：1111\\n事業所番号：1111\\n＊コード：1\\n整理番号：11111\",\n        \"関連する入力欄が有効化されること。\",\n    ),\n    row_obj(\n        \"\",\n        \"お問い合わせ区分・お問い合わせ件名・お問い合わせ内容を右記の内容で入力する\",\n        \"お問い合わせ区分：操作方法\\nお問い合わせ件名：画面表示に関する問い合わせ\\nお問い合わせ内容：お問い合わせフォームの入力確認です。\",\n        \"各入力項目に有効値が入力できること。\",\n    ),\n    row_obj(\"\", \"「入力内容の確認」をクリックする\", \"ー\", \"「お問い合わせ入力内容の確認画面」に遷移する\"),\n    row_obj(\"（正常系）「お問い合わせ入力内容の確認画面」STEP2\", \"「入力画面へもどり修正する」をクリックする\", \"ー\", \"「お問い合わせフォーム入力画面」へ遷移する\"),\n    row_obj(\"\", \"「入力内容の確認」をクリックする\", \"ー\", \"「お問い合わせ入力内容の確認画面」が崩れなく表示される\"),\n    row_obj(\"\", \"「送信する」をクリックする\", \"ー\", \"「お問い合わせの完了画面」に遷移し、文言と受付番号が正常に表示されること。\"),\n    row_obj(\"（正常系）「お問い合わせの完了画面」STEP3\", \"「トップページにもどる」をクリックする\", \"ー\", \"「トップページ」画面へ遷移する\"),\n]\n\n# Abnormal flow: error messages aligned to design workbook (関連チェック仕様書)\nabnormal_rows = [\n    row_obj(\n        \"（異常系）「お問い合わせフォーム入力画面」STEP1\",\n        \"画面の全ての必須項目を未入力のまま「入力内容の確認」ボタンをクリックする\",\n        \"ー\",\n        \"市区町村コードを入力してください\\n調査区番号を入力してください\\n＊コードを入力してください\\n氏名を入力してください\\nカナ氏名を入力してください\\n電話番号を入力してください\\nメールアドレスを入力してください\\n事業所の名称を入力してください\\n事業所の郵便番号を入力してください\\n事業所の住所を入力してください\",\n    ),\n    row_obj(\"\", \"申請者のメールアドレス：test.jp@gcssc\", \"ー\", \"申請者のメールアドレスを正しいフォーマットで入力してください\"),\n    row_obj(\"\", \"申請者の電話番号：07044777-003\", \"ー\", \"申請者の電話番号を入力してください\"),\n    row_obj(\"\", \"書類を発送する郵便番号：177-003\", \"ー\", \"書類を発送する郵便番号を正しいフォーマットで入力してください\"),\n    row_obj(\"\", \"市区町村コード：121a\", \"ー\", \"市区町村コードを5桁の半角数字で入力してください\"),\n    row_obj(\"\", \"調査区番号：12a\", \"ー\", \"調査区番号を4桁の半角数字で入力してください\"),\n    row_obj(\"\", \"事業所番号：12\", \"ー\", \"事業所番号を4桁の半角数字で入力してください\"),\n    row_obj(\"\", \"＊コード：a\", \"ー\", \"＊コードを1桁の半角数字で入力してください\"),\n    row_obj(\"\", \"整理番号：12\", \"ー\", \"整理番号を5桁の半角数字で入力してください\"),\n]\n\nrows = normal_rows + abnormal_rows\n\nwb = load_workbook(TEMPLATE)\nws = wb.active\n\nfor r in range(DATA_START_ROW, ws.max_row + 1):\n    for c in COL.values():\n        write(ws, r, c, None)\n\nfor i, item in enumerate(rows, start=1):\n    rr = DATA_START_ROW + i - 1\n    write(ws, rr, COL[\"cat\"], \"お問い合わせフォーム\")\n    write(ws, rr, COL[\"id\"], f\"TC-{i:03d}\")\n    write(ws, rr, COL[\"title\"], item[\"title\"])\n    write(ws, rr, COL[\"steps\"], item[\"steps\"])\n    write(ws, rr, COL[\"pre\"], item[\"pre\"])\n    write(ws, rr, COL[\"exp\"], item[\"exp\"])\n    write(ws, rr, COL[\"res\"], item[\"res\"])\n\nwb.save(OUT)\nprint(f\"Wrote {OUT} rows={len(rows)} normal={len(normal_rows)} abnormal={len(abnormal_rows)}\")\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\tmp\\\\build_inquiry_v8.py\",\"content\":\"from pathlib import Path\\nfrom openpyxl import load_workbook\\nfrom openpyxl.cell.cell import MergedCell\\n\\nTEMPLATE = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\【総務省様】_コールバック予約_単体テスト仕様書.xlsx\\\")\\nOUT = Path(r\\\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\【総務省様】_お問い合わせフォーム_単体テスト仕様書_overwrite_v8.xlsx\\\")\\n\\nDATA_START_ROW = 8\\nCOL = {\\\"cat\\\": 1, \\\"id\\\": 2, \\\"title\\\": 3, \\\"steps\\\": 4, \\\"pre\\\": 6, \\\"exp\\\": 7, \\\"res\\\": 8}\\n\\n\\ndef resolve_writable_pos(ws, row, col):\\n    cell = ws.cell(row=row, column=col)\\n    if not isinstance(cell, MergedCell):\\n        return row, col\\n    for mr in ws.merged_cells.ranges:\\n        if mr.min_row <= row <= mr.max_row and mr.min_col <= col <= mr.max_col: