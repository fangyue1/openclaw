.append(item)\n        return out\n    if isinstance(value, dict) and value:\n        return [value]\n    return []\n\n\ndef to_float_or_none(value):\n    if value is None:\n        return None\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            return None\n    return None\n\n\ndef evaluate_case(case_obj, idx, min_confidence):\n    issues = []\n    source_refs = normalize_source_refs(first_value(case_obj, SOURCE_REF_KEYS))\n    confidence = to_float_or_none(first_value(case_obj, CONFIDENCE_KEYS))\n    case_id = str(first_value(case_obj, ID_KEYS) or f\"idx_{idx}\")\n\n    if not source_refs:\n        issues.append(\"missing_source_refs\")\n\n    if confidence is None:\n        issues.append(\"missing_confidence\")\n    elif confidence < min_confidence:\n        issues.append(\"low_confidence\")\n\n    return {\n        \"case_id\": case_id,\n        \"issues\": issues,\n        \"confidence\": confidence,\n    }\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Quality gate for generated cases.json\")\n    ap.add_argument(\"--cases\", required=True, help=\"Path to cases.json\")\n    ap.add_argument(\"--mode\", choices=[\"off\", \"warn\", \"fail\"], default=\"warn\")\n    ap.add_argument(\"--min-confidence\", type=float, default=0.70)\n    ap.add_argument(\"--report\", help=\"Optional path for JSON report\")\n    args = ap.parse_args()\n\n    if args.mode == \"off\":\n        print(\"[QUALITY] gate disabled\")\n        return\n\n    p = Path(args.cases)\n    data = json.loads(p.read_text(encoding=\"utf-8\"))\n    if isinstance(data, dict) and \"cases\" in data:\n        cases = data[\"cases\"]\n    elif isinstance(data, list):\n        cases = data\n    else:\n        raise ValueError(\"Unsupported cases payload: expected list or {'cases': [...]}.\")\n\n    results = []\n    issue_count = 0\n    low_confidence_count = 0\n\n    for i, case in enumerate(cases):\n        if not isinstance(case, dict):\n            results.append({\"case_id\": f\"idx_{i}\", \"issues\": [\"invalid_case_object\"], \"confidence\": None})\n            issue_count += 1\n            continue\n        r = evaluate_case(case, i, args.min_confidence)\n        if r[\"issues\"]:\n            issue_count += 1\n            if \"low_confidence\" in r[\"issues\"]:\n                low_confidence_count += 1\n        results.append(r)\n\n    summary = {\n        \"mode\": args.mode,\n        \"min_confidence\": args.min_confidence,\n        \"total_cases\": len(cases),\n        \"cases_with_issues\": issue_count,\n        \"low_confidence_cases\": low_confidence_count,\n        \"passed\": issue_count == 0,\n        \"issues\": [r for r in results if r[\"issues\"]],\n    }\n\n    if args.report:\n        Path(args.report).write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n    print(f\"[QUALITY] total={summary['total_cases']} issues={summary['cases_with_issues']} low_conf={summary['low_confidence_cases']}\")\n\n    if args.mode == \"fail\" and summary[\"cases_with_issues\"] > 0:\n        print(\"[QUALITY] failed: blocking export because quality gate mode=fail\")\n        sys.exit(2)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\quality_gate_cases.py\",\"content\":\"import argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\n\\nSOURCE_REF_KEYS = [\\\"source_refs\\\", \\\"source_ref\\\", \\\"sources\\\"]\\nCONFIDENCE_KEYS = [\\\"confidence\\\", \\\"confidence_score\\\", \\\"score\\\"]\\nID_KEYS = [\\\"feature_id\\\", \\\"case_id\\\", \\\"id\\\", \\\"title\\\"]\\n\\n\\ndef first_value(obj, keys):\\n    for k in keys:\\n        if k in obj and obj[k] is not None:\\n            return obj[k]\\n    return None\\n\\n\\ndef normalize_source_refs(value):\\n    if value is None:\\n        return []\\n    if isinstance(value, str):\\n        txt = value.strip()\\n        return [txt] if txt else []\\n    if isinstance(value, list):\\n        out = []\\n        for item in value:\\n            if isinstance(item, str) and item.strip():\\n                out.append(item.strip())\\n            elif isinstance(item, dict) and item:\\n                out.append(item)\\n        return out\\n    if isinstance(value, dict) and value:\\n        return [value]\\n    return []\\n\\n\\ndef to_float_or_none(value):\\n    if value is None:\\n        return None\\n    if isinstance(value, (int, float)):\\n        return float(value)\\n    if isinstance(value, str):\\n        try:\\n            return float(value.strip())\\n        except ValueError:\\n            return None\\n    return None\\n\\n\\ndef evaluate_case(case_obj, idx, min_confidence):\\n    issues = []\\n    source_refs = normalize_source_refs(first_value(case_obj, SOURCE_REF_KEYS))\\n    confidence = to_float_or_none(first_value(case_obj, CONFIDENCE_KEYS))\\n    case_id = str(first_value(case_obj, ID_KEYS) or f\\\"idx_{idx}\\\")\\n\\n    if not source_refs:\\n        issues.append(\\\"missing_source_refs\\\")\\n\\n    if confidence is None:\\n        issues.append(\\\"missing_confidence\\\")\\n    elif confidence < min_confidence:\\n        issues.append(\\\"low_confidence\\\")\\n\\n    return {\\n        \\\"case_id\\\": case_id,\\n        \\\"issues\\\": issues,\\n        \\\"confidence\\\": confidence,\\n    }\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser(description=\\\"Quality gate for generated cases.json\\\")\\n    ap.add_argument(\\\"--cases\\\", required=True, help=\\\"Path to cases.json\\\")\\n    ap.add_argument(\\\"--mode\\\", choices=[\\\"off\\\", \\\"warn\\\", \\\"fail\\\"], default=\\\"warn\\\")\\n    ap.add_argument(\\\"--min-confidence\\\", type=float, default=0.70)\\n    ap.add_argument(\\\"--report\\\", help=\\\"Optional path for JSON report\\\")\\n    args = ap.parse_args()\\n\\n    if args.mode == \\\"off\\\":\\n        print(\\\"[QUALITY] gate disabled\\\")\\n        return\\n\\n    p = Path(args.cases)\\n    data = json.loads(p.read_text(encoding=\\\"utf-8\\\"))\\n    if isinstance(data, dict) and \\\"cases\\\" in data:\\n        cases = data[\\\"cases\\\"]\\n    elif isinstance(data, list):\\n        cases = data\\n    else:\\n        raise ValueError(\\\"Unsupported cases payload: expected list or {'cases': [...]}.\\\")\\n\\n    results = []\\n    issue_count = 0\\n    low_confidence_count = 0\\n\\n    for i, case in enumerate(cases):\\n        if not isinstance(case, dict):\\n            results.append({\\\"case_id\\\": f\\\"idx_{i}\\\", \\\"issues\\\": [\\\"invalid_case_object\\\"], \\\"confidence\\\": None})\\n            issue_count += 1\\n            continue\\n        r = evaluate_case(case, i, args.min_confidence)\\n        if r[\\\"issues\\\"]:\\n            issue_count += 1\\n            if \\\"low_confidence\\\" in r[\\\"issues\\\"]:\\n                low_confidence_count += 1\\n        results.append(r)\\n\\n    summary = {\\n        \\\"mode\\\": args.mode,\\n        \\\"min_confidence\\\": args.min_confidence,\\n        \\\"total_cases\\\": len(cases),\\n        \\\"cases_with_issues\\\": issue_count,\\n        \\\"low_confidence_cases\\\": low_confidence_count,\\n        \\\"passed\\\": issue_count == 0,\\n        \\\"issues\\\": [r for r in results if r[\\\"issues\\\"]],\\n    }\\n\\n    if args.report:\\n        Path(args.report).write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding=\\\"utf-8\\\")\\n\\n    print(f\\\"[QUALITY] total={summary['total_cases']} issues={summary['cases_with_issues']} low_conf={summary['low_confidence_cases']}\\\")\\n\\n    if args.mode == \\\"fail\\\" and summary[\\\"cases_with_issues\\\"] > 0:\\n        print(\\\"[QUALITY] failed: blocking export because quality gate mode=fail\\\")\\n        sys.exit(2)\\n\\n\\nif __name__ =