sults = []\n    for i, p in enumerate(image_paths, start=1):\n        try:\n            txt = pytesseract.image_to_string(Image.open(p), lang=lang)\n            results.append({\"image_index\": i, \"image\": str(p), \"text\": txt.strip()})\n        except Exception as e:\n            results.append({\"image_index\": i, \"image\": str(p), \"error\": str(e)})\n    return results\n","new_string":"def extract_ui_elements(text: str):\n    ui_keywords = {\n        \"button\": [\"按钮\", \"button\", \"提交\", \"保存\", \"确认\", \"删除\"],\n        \"input\": [\"输入\", \"input\", \"文本框\", \"账号\", \"密码\"],\n        \"prompt\": [\"提示\", \"warning\", \"alert\", \"toast\", \"弹窗\"],\n        \"table\": [\"表格\", \"table\", \"列表\", \"list\"],\n    }\n    lowered = (text or \"\").lower()\n    hits = []\n    for t, kws in ui_keywords.items():\n        if any(k.lower() in lowered for k in kws):\n            hits.append(t)\n    return hits\n\n\ndef extract_error_keywords(text: str):\n    candidates = [\"失败\", \"超时\", \"权限\", \"不存在\", \"异常\", \"error\", \"timeout\", \"denied\", \"not found\", \"failed\"]\n    lowered = (text or \"\").lower()\n    return [k for k in candidates if k.lower() in lowered]\n\n\ndef run_ocr(image_paths, lang):\n    if not pytesseract or not Image:\n        return []\n\n    # Windows fallback: use default install path when PATH isn't refreshed yet\n    win_tess = r\"C:\\Program Files\\Tesseract-OCR\\tesseract.exe\"\n    if os.name == 'nt' and os.path.exists(win_tess):\n        pytesseract.pytesseract.tesseract_cmd = win_tess\n\n    results = []\n    for i, p in enumerate(image_paths, start=1):\n        try:\n            txt = pytesseract.image_to_string(Image.open(p), lang=lang).strip()\n            conf = 0.75 if txt else 0.4\n            results.append(\n                {\n                    \"image_index\": i,\n                    \"image\": str(p),\n                    \"ocr_text\": txt,\n                    \"ui_elements\": extract_ui_elements(txt),\n                    \"error_keywords\": extract_error_keywords(txt),\n                    \"confidence\": conf,\n                }\n            )\n        except Exception as e:\n            results.append({\"image_index\": i, \"image\": str(p), \"error\": str(e), \"confidence\": 0.0})\n    return results\n\n\ndef collect_sheet_image_context(wb):\n    items = []\n    for ws in wb.worksheets:\n        for idx, img in enumerate(getattr(ws, \"_images\", []) or [], start=1):\n            anchor = getattr(img, \"anchor\", None)\n            anchor_cell = None\n            try:\n                if hasattr(anchor, \"_from\"):\n                    anchor_cell = f\"{anchor._from.col + 1}:{anchor._from.row + 1}\"\n                elif hasattr(anchor, \"from\"):\n                    anchor_cell = f\"{anchor.from.col + 1}:{anchor.from.row + 1}\"\n            except Exception:\n                anchor_cell = None\n\n            image_bytes = b\"\"\n            try:\n                image_bytes = img._data()\n            except Exception:\n                pass\n            phash = hashlib.sha1(image_bytes).hexdigest()[:16] if image_bytes else None\n\n            width = getattr(img, \"width\", None)\n            height = getattr(img, \"height\", None)\n\n            items.append(\n                {\n                    \"image_id\": f\"{ws.title}_img_{idx:03d}\",\n                    \"sheet_name\": ws.title,\n                    \"anchor_cell\": anchor_cell,\n                    \"width\": width,\n                    \"height\": height,\n                    \"visual_fingerprint\": {\"sha1_16\": phash},\n                }\n            )\n    return items\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\parse_design_excel.py\",\"old_string\":\"def run_ocr(image_paths, lang):\\n    if not pytesseract or not Image:\\n        return []\\n\\n    # Windows fallback: use default install path when PATH isn't refreshed yet\\n  