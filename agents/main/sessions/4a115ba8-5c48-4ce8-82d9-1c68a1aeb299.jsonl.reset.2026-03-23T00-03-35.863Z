g_rules:\n  - id: UI_ACTION_TO_STEP\n    when:\n      any_ui_element_type: [button, input, select, checkbox, radio, link]\n    then:\n      append_to: steps\n      format: \"[UI] 在{sheet_name}页面执行交互：{ui_elements_summary}\"\n\n  - id: ERROR_KEYWORD_TO_EXCEPTION\n    when:\n      any_error_keyword: [失败, 超时, 权限, 不存在, 异常, error, timeout, denied, not found]\n    then:\n      append_to: exceptions\n      format: \"[IMG:{image_id}] 需覆盖异常场景：{error_keywords_summary}\"\n\n  - id: PROMPT_TEXT_TO_EXPECTED\n    when:\n      ocr_contains_any: [成功, 完成, 提交成功, 保存成功, 失败, 无权限, timeout, success, failed]\n    then:\n      append_to: expected_results\n      format: \"界面反馈应符合截图文案：{matched_phrases}\"\n\n  - id: FLOW_ARROW_TO_SEQUENCE\n    when:\n      ocr_pattern_any:\n        - \"->\"\n        - \"=>\"\n        - \"下一步\"\n        - \"步骤\"\n    then:\n      append_to: steps\n      format: \"按流程图顺序补充步骤链：{flow_sequence_summary}\"\n\nquality_policy:\n  confidence_threshold: 0.70\n  low_confidence_action: review_required\n  block_final_export_on_missing_source_refs: true\n\nsource_refs_policy:\n  required: true\n  minimum_fields:\n    - image_id\n    - sheet_name\n  recommended_fields:\n    - section_path\n    - page_span\n\nmerge_policy:\n  cross_page_merge:\n    enabled: true\n    strategy: semantic-first\n    require_evidence: true\n    evidence_fields:\n      - matched_keywords\n      - similarity_score\n      - source_refs\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\references\\\\rules\\\\image-to-case-mapping-rules-v1.yaml\",\"content\":\"version: 1\\nname: image-to-case-mapping-rules-v1\\npurpose: Map OCR/UI evidence from Excel-embedded images into test-case fields without fixed cell anchors.\\n\\ninputs:\\n  required_image_fields:\\n    - image_id\\n    - sheet_name\\n    - ocr_text\\n    - ui_elements\\n    - error_keywords\\n    - confidence\\n  optional_context_fields:\\n    - section_path\\n    - nearby_text\\n    - page_span\\n    - visual_fingerprint\\n\\nmapping_rules:\\n  - id: UI_ACTION_TO_STEP\\n    when:\\n      any_ui_element_type: [button, input, select, checkbox, radio, link]\\n    then:\\n      append_to: steps\\n      format: \\\"[UI] 在{sheet_name}页面执行交互：{ui_elements_summary}\\\"\\n\\n  - id: ERROR_KEYWORD_TO_EXCEPTION\\n    when:\\n      any_error_keyword: [失败, 超时, 权限, 不存在, 异常, error, timeout, denied, not found]\\n    then:\\n      append_to: exceptions\\n      format: \\\"[IMG:{image_id}] 需覆盖异常场景：{error_keywords_summary}\\\"\\n\\n  - id: PROMPT_TEXT_TO_EXPECTED\\n    when:\\n      ocr_contains_any: [成功, 完成, 提交成功, 保存成功, 失败, 无权限, timeout, success, failed]\\n    then:\\n      append_to: expected_results\\n      format: \\\"界面反馈应符合截图文案：{matched_phrases}\\\"\\n\\n  - id: FLOW_ARROW_TO_SEQUENCE\\n    when:\\n      ocr_pattern_any:\\n        - \\\"->\\\"\\n        - \\\"=>\\\"\\n        - \\\"下一步\\\"\\n        - \\\"步骤\\\"\\n    then:\\n      append_to: steps\\n      format: \\\"按流程图顺序补充步骤链：{flow_sequence_summary}\\\"\\n\\nquality_policy:\\n  confidence_threshold: 0.70\\n  low_confidence_action: review_required\\n  block_final_export_on_missing_source_refs: true\\n\\nsource_refs_policy:\\n  required: true\\n  minimum_fields:\\n    - image_id\\n    - sheet_name\\n  recommended_fields:\\n    - section_path\\n    - page_span\\n\\nmerge_policy:\\n  cross_page_merge:\\n    enabled: true\\n    strategy: semantic-first\\n    require_evidence: true\\n    evidence_fields:\\n      - matched_keywords\\n      - similarity_score\\n      - source_refs\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":207,"output":604,"cacheRead":70784,"cacheWrite":0,"totalTokens":71595,"cost":{"input":0.00036225,"output":0.008456,"cacheRead":0.0123872,"cacheWrite":0,"total":0.02120545}},"stopReason":"toolUse","timestamp":1773805590476}}
