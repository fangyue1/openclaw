nt(\"--cases\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    cases_payload = json.loads(Path(args.cases).read_text(encoding=\"utf-8\"))\n    code_payload = json.loads(Path(args.code).read_text(encoding=\"utf-8\"))\n\n    cases = cases_payload.get(\"cases\", cases_payload) if isinstance(cases_payload, dict) else cases_payload\n    files = code_payload.get(\"files\", [])\n\n    all_code_conditions = []\n    all_methods = set()\n    has_exception_path = False\n\n    for f in files:\n        all_code_conditions.extend(f.get(\"branch_conditions\", []))\n        for m in f.get(\"method_names\", []):\n            all_methods.add(m.lower())\n        if f.get(\"exception_paths\", 0) > 0:\n            has_exception_path = True\n\n    cond_tokens = set()\n    for cond in all_code_conditions:\n        cond_tokens |= token_set(cond)\n\n    conflicts = []\n\n    for idx, case in enumerate(cases):\n        if not isinstance(case, dict):\n            continue\n        case_id = case.get(\"case_id\") or case.get(\"feature_id\") or f\"idx_{idx}\"\n\n        text = \" \".join([\n            str(case.get(\"title\", \"\")),\n            str(case.get(\"steps\", \"\")),\n            str(case.get(\"expected\", \"\")),\n            str(case.get(\"exceptions\", \"\")),\n        ])\n        tks = token_set(text)\n\n        # conflict heuristic 1: method mention in case not found in code methods\n        mentioned_like_method = [tk for tk in tks if tk.endswith(\"api\") or tk.endswith(\"service\") or tk.endswith(\"handler\")]\n        for m in mentioned_like_method:\n            if m not in all_methods:\n                conflicts.append({\n                    \"case_id\": case_id,\n                    \"severity\": \"medium\",\n                    \"type\": \"method_or_component_not_found_in_code\",\n                    \"evidence\": m,\n                })\n\n        # conflict heuristic 2: exception expectation while code has no exception path\n        has_exception_expect = any(k in tks for k in [\"异常\", \"失败\", \"timeout\", \"error\", \"denied\", \"not\", \"fail\"])\n        if has_exception_expect and not has_exception_path:\n            conflicts.append({\n                \"case_id\": case_id,\n                \"severity\": \"low\",\n                \"type\": \"exception_expected_but_code_has_no_explicit_exception_path\",\n                \"evidence\": \"case expects exception-like behavior\",\n            })\n\n        # conflict heuristic 3: if case condition tokens never overlap with code branch condition tokens\n        if cond_tokens:\n            overlap = len(tks & cond_tokens)\n            if overlap == 0:\n                conflicts.append({\n                    \"case_id\": case_id,\n                    \"severity\": \"low\",\n                    \"type\": \"no_condition_overlap_with_code_branches\",\n                    \"evidence\": \"no lexical overlap with extracted branch conditions\",\n                })\n\n    report = {\n        \"summary\": {\n            \"total_cases\": len(cases),\n            \"total_conflicts\": len(conflicts),\n            \"high\": sum(1 for c in conflicts if c[\"severity\"] == \"high\"),\n            \"medium\": sum(1 for c in conflicts if c[\"severity\"] == \"medium\"),\n            \"low\": sum(1 for c in conflicts if c[\"severity\"] == \"low\"),\n        },\n        \"conflicts\": conflicts,\n        \"note\": \"Design-First policy: these conflicts are advisory and must not auto-overwrite case intent.\",\n    }\n\n    Path(args.out).write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\audit_design_code_conflicts.py\",\"content\":\"import argparse\\nimport json\\nimport re\\nfrom