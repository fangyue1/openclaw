{"type":"message","id":"2f2d3249","parentId":"9b0f8d4e","timestamp":"2026-03-18T05:28:23.710Z","message":{"role":"toolResult","toolCallId":"call_qiRD4UzeBngvfMbEaTJTOdeT|fc_02effe8da24448560169ba37f24a5c8191bf8f59849325b043","toolName":"read","content":[{"type":"text","text":"import argparse\nimport json\nimport re\nimport zipfile\nfrom pathlib import Path\n\n\nCODE_EXTS = {\".js\", \".ts\", \".html\", \".cls\", \".apex\"}\n\n\ndef collect_files(src: Path):\n    if src.is_file() and src.suffix.lower() == \".zip\":\n        temp = src.parent / \"_code_unzip\"\n        temp.mkdir(exist_ok=True)\n        with zipfile.ZipFile(src, \"r\") as zf:\n            zf.extractall(temp)\n        base = temp\n    else:\n        base = src\n    return [p for p in base.rglob(\"*\") if p.suffix.lower() in CODE_EXTS]\n\n\ndef parse_js_ts(text: str):\n    branches = re.findall(r\"\\bif\\s*\\(([^)]*)\\)|\\bswitch\\s*\\(([^)]*)\\)\", text)\n    wire_methods = re.findall(r\"@wire\\s*\\(([^)]+)\\)\", text)\n    methods = re.findall(r\"\\n\\s*(?:async\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{\", text)\n    return {\n        \"method_names\": sorted(set(methods)),\n        \"branch_conditions\": [a or b for a, b in branches if (a or b)],\n        \"wire_bindings\": [w.strip() for w in wire_methods],\n    }\n\n\ndef parse_apex(text: str):\n    methods = re.findall(\n        r\"(?:public|private|global|protected)\\s+(?:static\\s+)?(?:[A-Za-z_][A-Za-z0-9_<>,.]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    dml = re.findall(r\"\\b(insert|update|upsert|delete|merge|undelete)\\b\", text, flags=re.IGNORECASE)\n    exceptions = re.findall(r\"\\bthrow\\b|\\btry\\b|\\bcatch\\b|AuraHandledException|Exception\", text)\n\n    return {\n        \"method_names\": sorted(set([m[0] for m in methods])),\n        \"dml_ops\": [x.lower() for x in dml],\n        \"exception_paths\": len(exceptions),\n    }\n\n\ndef parse_text(path: Path, text: str):\n    ext = path.suffix.lower()\n    base = {\n        \"branch_count\": len(re.findall(r\"\\bif\\b|\\belse\\b|\\bswitch\\b\", text)),\n        \"wire_bindings\": [],\n        \"dml_ops\": [],\n        \"exception_paths\": 0,\n        \"method_names\": [],\n        \"branch_conditions\": [],\n    }\n\n    if ext in {\".js\", \".ts\"}:\n        js = parse_js_ts(text)\n        base.update(\n            {\n                \"wire_bindings\": js[\"wire_bindings\"],\n                \"method_names\": js[\"method_names\"],\n                \"branch_conditions\": js[\"branch_conditions\"],\n            }\n        )\n    elif ext in {\".cls\", \".apex\"}:\n        apex = parse_apex(text)\n        base.update(\n            {\n                \"dml_ops\": apex[\"dml_ops\"],\n                \"exception_paths\": apex[\"exception_paths\"],\n                \"method_names\": apex[\"method_names\"],\n            }\n        )\n\n    return base\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--src\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    args = ap.parse_args()\n\n    src = Path(args.src)\n    files = collect_files(src)\n\n    rules = []\n    totals = {\"branches\": 0, \"wires\": 0, \"dml\": 0, \"exceptions\": 0, \"methods\": 0}\n    for f in files:\n        text = f.read_text(encoding=\"utf-8\", errors=\"ignore\")\n        parsed = parse_text(f, text)\n        totals[\"branches\"] += parsed[\"branch_count\"]\n        totals[\"wires\"] += len(parsed[\"wire_bindings\"])\n        totals[\"dml\"] += len(parsed[\"dml_ops\"])\n        totals[\"exceptions\"] += parsed[\"exception_paths\"]\n        totals[\"methods\"] += len(parsed[\"method_names\"])\n        rules.append({\"file\": str(f), **parsed})\n\n    out = {\"source\": str(src), \"files\": rules, \"summary\": totals}\n    Path(args.out).write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    print(f\"Wrote {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"isError":false,"timestamp":1773811703708}}
{"type":"message","id":"4378a046","parentId":"2f2d3249","timestamp":"2026-03-18T05:29:06.082Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning UI signal extraction**","thinkingSignature":"{\"id\":\"rs_02effe8da24448560169ba37f595fc8191a8d16eea5121467c\",\"type\":\"reasoning\",\"encrypted_content\":\"gAAAAABpujf5bAE-fx6Dy0YVcFJ1ryKfQXoh5UFBVN__wkVzXRgrh2e8saZMycQXANNefDWAueaGeqmlZ3N19x0d4--1oksLQInU0peEQy4Rq4MNektXzSLEjlg0400rLJp6CPColv1QlTRP3K5naHD94r5C9EcPrFnOiffUJDGKmlqP6HsfcxN9rRoPnF-Zjs9uBO6o0IehY--t0Z1fqh_qdTJTCOVdiYK8qTyQnzqDd2xP34CCfp1clwAsCLczlteZ1tk5LRJSTsaw91ubqNnjZj50fjzTxprjckd37acwuMV7WJw_Ki9sMt0s9J64H3tHafFOMU7uM-P3723-U9EGjq6ixVQbnJ_c36ocw-jZo8JVZPTHpI0aKFNCW-fWGbRPYyEwpDoQYLYiOH0Xj3-5b9Kt_T5aGAh23equI6Mjnwjk6D4fRRwMDuH1eueQxBKB5xjZF_y_2qWPQFNcUTVFyS3Yqm-JGiLjJemsdHEoHkossmCg-ltw36uGHcqHe6GBzN7VAfQ5BNfx2pZwxFY9lP7OOWENtsJxNbzN8YUvB3zJe1mGEmfD4ew_Jn0WaIE4O7xqd2z4AVNSh2ZsOedvqSe6cR8D56q1ryDZDn4OZV7yBItX5ioeH6dEBF3khKfz6NS8ZZsjydDNBTQEro-Ole5eBMMJYkZpo_6Ffgc9Wt0bBZYPXi5nhj62dBUYdhqNhNZRk5z7VbJpbotLWs-exZRBUHswq1cM1W0y-up3leZB6FcpRYOvse9fAT5u8bNUw-wwN_M0t5CIC2YJMOcnWmW4MB9D5LTjO4C6C7b6y4rv9w3PuOavk7DMB_sJG-y4lk_rRCvrBEYhMVI_zVBPTROYpSf2Q-aSvkWZDoDxN9AxzrPrrwW17d4wLFHGvsSB7gLou7g-LZTJIjoH4s3DCiyoil5srcB0-ePgu-sbjvyHf2rF4Kv6oGBxmzs98yBBArfdc53vRyPLtxcSyneVIQi-R3m5eiBd3Q1AHOP2WYeyymoF_pMRS1305T_tIhk42yW8Wv6Oqzz9tU6qxQdHUVCA-mruD3zdowfQnIMX6Gwp-bVqFhR1QO55Buqj29ZEnTvdiGKFgdDOdcKGmJTMDIcuGThR-8GdB0ONgQpy4pzRN1ehk5Q6oXa0oEjtMBvNWefcDjfaWTPAZXCjuKC4VMNgbq1AUJ23VEmfvAPYMKe8ibWOUnCKUofp0qdbtqyyaUP-_UrHY2QY_zYKJO059x_Bf3oA42tsNIbmAvn-ecNObUzIUY88X5IW6yU4DkwigPudzJhghynV-wuQi4Zb3qNMO93auls_MXT67lvahzatjwKVGEBRzOBUOuAVb-Qya6T4KnFP87RP9pbUBn6JhJiHRxC0GqqY1CgsfUuwnVtJvD2pLq8TdlYoSsJsqntqvHy2UWTPtcHDTbTTE417-kwZ96uV5LcjJ8aYP-s2RYhkKXD8XIsupYevf-dIDi7mOFhb5qvUx4BtUUO40bHNT92CijYBUigh_9U0szvTRtdAmLDv8DFP0YthNWKF0zMh-sHyO_2D3J3tbf1IKxGm50cwI-MH8CXIYUFZWhWr1W7p216Rb0c5eN3vEIlalTTentpgGQ2aKrFVt2bf8oeOle7GnTHvZml1rU9JImAdi6unSQxgXl74dFzl7SDeGJb0Y1jawIdRHJP51eFDOuI43AfCBxAo-m6M_hWZxGDDvmAkHd1ZUGWvrVesJHUs2JYb5JJg24pvgl3ZfQQvYH0FoaV4nz84s30EKk6xGoyBVxdG2Lg4LzcTSBWwEVQh_dT0MwyZsOKLMdrq85fADydMBcX9v23_Bjw0t2OggM4KKXkYgCsJORYC4gG_vRZJOoC4LuHzzRBFifRILNFjMeGaX57z5FQtrpguKANgP-JDxXIvgi198IgxyXGObGWImZ_EJozdzeYtHJXG2w0y2QR1CSuCv3PVAw==\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Planning UI signal extraction**\"}]}"},{"type":"toolCall","id":"call_oppZ4IkgOuvtzWBTaLXofDo8|fc_02effe8da24448560169ba37f93f14819183996251b9aa62c9","name":"write","arguments":{"file_path":"C:\\Users\\吗喽\\.openclaw\\workspace\\skills\\web-unit-testbook\\scripts\\generate_high_precision.py","content":"import argparse\nimport json\nfrom pathlib import Path\n\n\ndef _ocr_lines(design, max_lines=40):\n    lines = []\n    for o in design.get(\"ocr\", []) or []:\n        txt = (o.get(\"text\") or \"\").strip()\n        if not txt:\n            continue\n        for ln in txt.splitlines():\n            s = ln.strip()\n            if len(s) >= 3:\n                lines.append(s)\n    # de-dup keep order\n    seen = set()\n    uniq = []\n    for s in lines:\n        k = s.lower()\n        if k not in seen:\n            seen.add(k)\n            uniq.append(s)\n        if len(uniq) >= max_lines:\n            break\n    return uniq\n\n\ndef _safe_str(v):\n    if v is None:\n        return \"\"\n    return str(v).strip()\n\n\ndef _first_non_empty(*vals):\n    for v in vals:\n        s = _safe_str(v)\n        if s:\n            return s\n    return \"\"\n\n\ndef _build_code_verification_flags(code):\n    summary = code.get(\"summary\", {}) if isinstance(code, dict) else {}\n    files = code.get(\"files\", []) if isinstance(code, dict) else []\n\n    has_exception_signals = int(summary.get(\"exceptions\", 0) or 0) > 0\n    has_navigation_signals = int(summary.get(\"branches\", 0) or 0) > 0 or int(summary.get(\"wires\", 0) or 0) > 0\n\n    code_refs = []\n    for f in files[:5]:\n        p = _safe_str(f.get(\"file\"))\n        if p:\n            code_refs.append({\"file\": p, \"type\": \"code_file\"})\n\n    return {\n        \"error_message_verified_by_code\": has_exception_signals,\n        \"navigation_verified_by_code\": has_navigation_signals,\n        \"code_refs\": code_refs,\n    }\n\n\ndef _add_design_case(cases, idx, category, title, precondition, steps, expected, priority, source_refs, code_flags):\n    c = {\n        \"case_id\": f\"TC-{idx:04d}\",\n        \"category\": category,\n        \"title\": title,\n        \"precondition\": precondition,\n        \"steps\": steps,\n        \"expected\": expected,\n        \"priority\": priority,\n        # standardized aliases used by downstream scripts\n        \"preconditions\": precondition,\n        \"expected_results\": expected,\n        \"exceptions\": \"\",\n        \"source_refs\": source_refs,\n        \"confidence\": 0.78,\n        # code is verify-only: annotate but never create extra cases from code logic\n        \"error_message_verified_by_code\": code_flags[\"error_message_verified_by_code\"],\n        \"navigation_verified_by_code\": code_flags[\"navigation_verified_by_code\"],\n        \"code_refs\": code_flags[\"code_refs\"],\n    }\n    cases.append(c)\n\n\ndef build_cases(design, code, max_field_cases=120, max_ocr_cases=20):\n    \"\"\"\n    UI-first generation:\n    - cases come from design evidence (fields + OCR text)\n    - code is verify-only metadata; never used to inflate case count\n    \"\"\"\n    cases = []\n    idx = 1\n\n    code_flags = _build_code_verification_flags(code)\n\n    used_titles = set()\n\n    for f in (design.get(\"field_rules\", []) or [])[:max_field_cases]:\n        api = _first_non_empty((f.get(\"api_names\") or [\"\"])[0], f.get(\"field_name\"), \"字段\")\n        required = bool(f.get(\"required_hint\", False))\n        checks = f.get(\"check_patterns\") or []\n\n        sheet = _safe_str(f.get(\"sheet\") or f.get(\"sheet_name\"))\n        cell = _safe_str(f.get(\"cell\") or f.get(\"anchor_cell\"))\n        source_ref = {\"sheet\": sheet or \"Design\", \"cell\": cell or \"N/A\", \"rule_id\": _safe_str(f.get(\"rule_id\") or api)}\n\n        # 1) happy path\n        t1 = f\"{api} 正常输入\"\n        if t1 not in used_titles:\n            _add_design_case(\n                cases,\n                idx,\n                \"字段校验\",\n                t1,\n                \"页面可访问，用户已登录\",\n                f\"输入 {api} 的合法值并提交\",\n                \"提交成功，数据保存正确\",\n                \"P1\" if required else \"P2\",\n                [source_ref],\n                code_flags,\n            )\n            idx += 1\n            used_titles.add(t1)\n\n        # 2) required validation\n        if required:\n            t2 = f\"{api} 必填校验\"\n            if t2 not in used_titles:\n                _add_design_case(\n                    cases,\n                    idx,\n                    \"异常校验\",\n                    t2,\n                    \"页面可访问\",\n                    f\"清空 {api} 后提交\",\n                    \"出现必填错误提示，无法提交\",\n                    \"P1\",\n                    [source_ref],\n                    code_flags,\n                )\n                idx += 1\n                used_titles.add(t2)\n\n        # 3) single boundary rule (do not explode by many checks)\n        if checks:\n            t3 = f\"{api} 规则边界\"\n            if t3 not in used_titles:\n                _add_design_case(\n                    cases,\n                    idx,\n                    \"边界校验\",\n                    t3,\n                    \"页面可访问\",\n                    f\"按规则 {checks[0]} 构造边界值并提交\",\n                    \"边界行为符合设计说明\",\n                    \"P2\",\n                    [source_ref],\n                    code_flags,\n                )\n                idx += 1\n                used_titles.add(t3)\n\n    # OCR-driven UI wording checks from embedded design images\n    ocr_lines = _ocr_lines(design)\n    for ln in ocr_lines[:max_ocr_cases]:\n        title = f\"画面表示文言: {ln[:24]}\"\n        if title in used_titles:\n            continue\n        _add_design_case(\n            cases,\n            idx,\n            \"画面文言確認\",\n            title,\n            \"対象画面を表示できること\",\n            \"画面を開き、仕様書画像の文言と照合する\",\n            f\"仕様書画像由来の文言『{ln[:80]}』が正しく表示される\",\n            \"P1\",\n            [{\"sheet\": \"OCR\", \"section\": \"embedded-image-text\", \"rule_id\": \"ocr_line\"}],\n            code_flags,\n        )\n        idx += 1\n        used_titles.add(title)\n\n    return cases\n\n\ndef to_markdown(cases):\n    lines = [\"# Unit Test Spec (High Precision)\", \"\", \"| CaseID | Category | Title | Expected |\", \"|---|---|---|---|\"]\n    for c in cases:\n        lines.append(f\"| {c['case_id']} | {c['category']} | {c['title']} | {c['expected']} |\")\n    return \"\\n\".join(lines)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--design\", required=True)\n    ap.add_argument(\"--code\", required=True)\n    ap.add_argument(\"--out-md\", required=True)\n    ap.add_argument(\"--out-cases\", required=True)\n    ap.add_argument(\"--max-field-cases\", type=int, default=120)\n    ap.add_argument(\"--max-ocr-cases\", type=int, default=20)\n    args = ap.parse_args()\n\n    design = json.loads(Path(args.design).read_text(encoding=\"utf-8\"))\n    code = json.loads(Path(args.code).read_text(encoding=\"utf-8\"))\n\n    cases = build_cases(design, code, max_field_cases=args.max_field_cases, max_ocr_cases=args.max_ocr_cases)\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    Path(args.out_md).write_text(to_markdown(cases), encoding=\"utf-8\")\n\n    print(f\"Wrote {args.out_cases} and {args.out_md} (cases={len(cases)})\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"partialJson":"{\"file_path\":\"C:\\\\Users\\\\吗喽\\\\.openclaw\\\\workspace\\\\skills\\\\web-unit-testbook\\\\scripts\\\\generate_high_precision.py\",\"content\":\"import argparse\\nimport json\\nfrom pathlib import Path\\n\\n\\ndef _ocr_lines(design, max_lines=40):\\n    lines = []\\n    for o in design.get(\\\"ocr\\\", []) or []:\\n        txt = (o.get(\\\"text\\\") or \\\"\\\").strip()\\n        if not txt:\\n            continue\\n        for ln in txt.splitlines():\\n            s = ln.strip()\\n            if len(s) >= 3:\\n                lines.append(s)\\n    # de-dup keep order\\n    seen = set()\\n    uniq = []\\n    for s in lines:\\n        k = s.lower()\\n        if k not in seen:\\n            seen.add(k)\\n            uniq.append(s)\\n        if len(uniq) >= max_lines:\\n            break\\n    return uniq\\n\\n\\ndef _safe_str(v):\\n    if v is None:\\n        return \\\"\\\"\\n    return str(v).strip()\\n\\n\\ndef _first_non_empty(*vals):\\n    for v in vals:\\n        s = _safe_str(v)\\n        if s:\\n            return s\\n    return \\\"\\\"\\n\\n\\ndef _build_code_verification_flags(code):\\n    summary = code.get(\\\"summary\\\", {}) if isinstance(code, dict) else {}\\n    files = code.get(\\\"files\\\", []) if isinstance(code, dict) else []\\n\\n    has_exception_signals = int(summary.get(\\\"exceptions\\\", 0) or 0) > 0\\n    has_navigation_signals = int(summary.get(\\\"branches\\\", 0) or 0) > 0 or int(summary.get(\\\"wires\\\", 0) or 0) > 0\\n\\n    code_refs = []\\n    for f in files[:5]:\\n        p = _safe_str(f.get(\\\"file\\\"))\\n        if p:\\n            code_refs.append({\\\"file\\\": p, \\\"type\\\": \\\"code_file\\\"})\\n\\n    return {\\n        \\\"error_message_verified_by_code\\\": has_exception_signals,\\n        \\\"navigation_verified_by_code\\\": has_navigation_signals,\\n        \\\"code_refs\\\": code_refs,\\n    }\\n\\n\\ndef _add_design_case(cases, idx, category, title, precondition, steps, expected, priority, source_refs, code_flags):\\n    c = {\\n        \\\"case_id\\\": f\\\"TC-{idx:04d}\\\",\\n        \\\"category\\\": category,\\n        \\\"title\\\": title,\\n        \\\"precondition\\\": precondition,\\n        \\\"steps\\\": steps,\\n        \\\"expected\\\": expected,\\n        \\\"priority\\\": priority,\\n        # standardized aliases used by downstream scripts\\n        \\\"preconditions\\\": precondition,\\n        \\\"expected_results\\\": expected,\\n        \\\"exceptions\\\": \\\"\\\",\\n        \\\"source_refs\\\": source_refs,\\n        \\\"confidence\\\": 0.78,\\n        # code is verify-only: annotate but never create extra cases from code logic\\n        \\\"error_message_verified_by_code\\\": code_flags[\\\"error_message_verified_by_code\\\"],\\n        \\\"navigation_verified_by_code\\\": code_flags[\\\"navigation_verified_by_code\\\"],\\n        \\\"code_refs\\\": code_flags[\\\"code_refs\\\"],\\n    }\\n    cases.append(c)\\n\\n\\ndef build_cases(design, code, max_field_cases=120, max_ocr_cases=20):\\n    \\\"\\\"\\\"\\n    UI-first generation:\\n    - cases come from design evidence (fields + OCR text)\\n    - code is verify-only metadata; never used to inflate case count\\n    \\\"\\\"\\\"\\n    cases = []\\n    idx = 1\\n\\n    code_flags = _build_code_verification_flags(code)\\n\\n    used_titles = set()\\n\\n    for f in (design.get(\\\"field_rules\\\", []) or [])[:max_field_cases]:\\n        api = _first_non_empty((f.get(\\\"api_names\\\") or [\\\"\\\"])[0], f.get(\\\"field_name\\\"), \\\"字段\\\")\\n        required = bool(f.get(\\\"required_hint\\\", False))\\n        checks = f.get(\\\"check_patterns\\\") or []\\n\\n        sheet = _safe_str(f.get(\\\"sheet\\\") or f.get(\\\"sheet_name\\\"))\\n        cell = _safe_str(f.get(\\\"cell\\\") or f.get(\\\"anchor_cell\\\"))\\n        source_ref = {\\\"sheet\\\": sheet or \\\"Design\\\", \\\"cell\\\": cell or \\\"N/A\\\", \\\"rule_id\\\": _safe_str(f.get(\\\"rule_id\\\") or api)}\\n\\n        # 1) happy path\\n        t1 = f\\\"{api} 正常输入\\\"\\n        if t1 not in used_titles:\\n            _add_design_case(\\n                cases,\\n                idx,\\n                \\\"字段校验\\\",\\n                t1,\\n                \\\"页面可访问，用户已登录\\\",\\n                f\\\"输入 {api} 的合法值并提交\\\",\\n                \\\"提交成功，数据保存正确\\\",\\n                \\\"P1\\\" if required else \\\"P2\\\",\\n                [source_ref],\\n                code_flags,\\n            )\\n            idx += 1\\n            used_titles.add(t1)\\n\\n        # 2) required validation\\n        if required:\\n            t2 = f\\\"{api} 必填校验\\\"\\n            if t2 not in used_titles:\\n                _add_design_case(\\n                    cases,\\n                    idx,\\n                    \\\"异常校验\\\",\\n                    t2,\\n                    \\\"页面可访问\\\",\\n                    f\\\"清空 {api} 后提交\\\",\\n                    \\\"出现必填错误提示，无法提交\\\",\\n                    \\\"P1\\\",\\n                    [source_ref],\\n                    code_flags,\\n                )\\n                idx += 1\\n                used_titles.add(t2)\\n\\n        # 3) single boundary rule (do not explode by many checks)\\n        if checks:\\n            t3 = f\\\"{api} 规则边界\\\"\\n            if t3 not in used_titles:\\n                _add_design_case(\\n                    cases,\\n                    idx,\\n                    \\\"边界校验\\\",\\n                    t3,\\n                    \\\"页面可访问\\\",\\n                    f\\\"按规则 {checks[0]} 构造边界值并提交\\\",\\n                    \\\"边界行为符合设计说明\\\",\\n                    \\\"P2\\\",\\n                    [source_ref],\\n                    code_flags,\\n                )\\n                idx += 1\\n                used_titles.add(t3)\\n\\n    # OCR-driven UI wording checks from embedded design images\\n    ocr_lines = _ocr_lines(design)\\n    for ln in ocr_lines[:max_ocr_cases]:\\n        title = f\\\"画面表示文言: {ln[:24]}\\\"\\n        if title in used_titles:\\n            continue\\n        _add_design_case(\\n            cases,\\n            idx,\\n            \\\"画面文言確認\\\",\\n            title,\\n            \\\"対象画面を表示できること\\\",\\n            \\\"画面を開き、仕様書画像の文言と照合する\\\",\\n            f\\\"仕様書画像由来の文言『{ln[:80]}』が正しく表示される\\\",\\n            \\\"P1\\\",\\n            [{\\\"sheet\\\": \\\"OCR\\\", \\\"section\\\": \\\"embedded-image-text\\\", \\\"rule_id\\\": \\\"ocr_line\\\"}],\\n            code_flags,\\n        )\\n        idx += 1\\n        used_titles.add(title)\\n\\n    return cases\\n\\n\\ndef to_markdown(cases):\\n    lines = [\\\"# Unit Test Spec (High Precision)\\\", \\\"\\\", \\\"| CaseID | Category | Title | Expected |\\\", \\\"|---|---|---|---|\\\"]\\n    for c in cases:\\n        lines.append(f\\\"| {c['case_id']} | {c['category']} | {c['title']} | {c['expected']} |\\\")\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument(\\\"--design\\\", required=True)\\n    ap.add_argument(\\\"--code\\\", required=True)\\n    ap.add_argument(\\\"--out-md\\\", required=True)\\n    ap.add_argument(\\\"--out-cases\\\", required=True)\\n    ap.add_argument(\\\"--max-field-cases\\\", type=int, default=120)\\n    ap.add_argument(\\\"--max-ocr-cases\\\", type=int, default=20)\\n    args = ap.parse_args()\\n\\n    design = json.loads(Path(args.design).read_text(encoding=\\\"utf-8\\\"))\\n    code = json.loads(Path(args.code).read_text(encoding=\\\"utf-8\\\"))\\n\\n    cases = build_cases(design, code, max_field_cases=args.max_field_cases, max_ocr_cases=args.max_ocr_cases)\\n    Path(args.out_cases).write_text(json.dumps(cases, ensure_ascii=False, indent=2), encoding=\\\"utf-8\\\")\\n    Path(args.out_md).write_text(to_markdown(cases), encoding=\\\"utf-8\\\")\\n\\n    print(f\\\"Wrote {args.out_cases} and {args.out_md} (cases={len(cases)})\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":1105,"output":2193,"cacheRead":53120,"cacheWrite":0,"totalTokens":56418,"cost":{"input":0.00193375,"output":0.030702,"cacheRead":0.009296,